{
  "schema_version": 1,
  "scope": "sampled_consumer_observation_coverage",
  "consumer_application_ack": false,
  "device_qualified": false,
  "notes": [
    "Stored values, sampled effective object values, read freshness and application ACK are separate.",
    "A missing consumer or bypassed/unsupported path never proves application.",
    "Dropped-event counts include coalesced contention loss markers and are not exact publisher loss counts."
  ],
  "consumers": [
    {
      "consumer_id": "controls.vehicle_model",
      "source_path": "openpilot/selfdrive/controls/controlsd.py",
      "meaning": "Current vehicle-model overrides and resolved model context",
      "sampling": "at_most_1_hz_sampled_observation",
      "consumer_application_ack": false
    },
    {
      "consumer_id": "controls.lateral_target",
      "source_path": "openpilot/selfdrive/controls/controlsd.py",
      "meaning": "Current steering-delay and smoothing inputs at curvature target selection",
      "sampling": "at_most_1_hz_sampled_observation",
      "consumer_application_ack": false
    },
    {
      "consumer_id": "controls.torque",
      "source_path": "openpilot/selfdrive/controls/lib/latcontrol_torque.py",
      "meaning": "Current torque controller coefficients and constructor-latched FF context",
      "sampling": "at_most_1_hz_sampled_observation",
      "consumer_application_ack": false
    },
    {
      "consumer_id": "controls.longitudinal",
      "source_path": "openpilot/selfdrive/controls/lib/longcontrol.py",
      "meaning": "Current longitudinal PID/fixed-brand/stop controller values",
      "sampling": "at_most_1_hz_sampled_observation",
      "consumer_application_ack": false
    },
    {
      "consumer_id": "modeld.action",
      "source_path": "openpilot/selfdrive/modeld/modeld.py",
      "meaning": "Current action-head timing inputs; used and next delay components remain separate",
      "sampling": "at_most_1_hz_sampled_observation",
      "consumer_application_ack": false
    },
    {
      "consumer_id": "planner.lateral",
      "source_path": "openpilot/selfdrive/controls/lib/lateral_planner.py",
      "meaning": "Lane MPC cost and path-offset inputs in the selected planning path",
      "sampling": "at_most_1_hz_sampled_observation",
      "consumer_application_ack": false
    },
    {
      "consumer_id": "planner.lane_path",
      "source_path": "openpilot/selfdrive/controls/lib/lane_planner_2.py",
      "meaning": "Lane input time-warp offset at the consuming path",
      "sampling": "at_most_1_hz_sampled_observation",
      "consumer_application_ack": false
    },
    {
      "consumer_id": "planner.longitudinal",
      "source_path": "openpilot/selfdrive/controls/lib/longitudinal_planner.py",
      "meaning": "Longitudinal delay/stopping threshold and selected acceleration-cap context",
      "sampling": "at_most_1_hz_sampled_observation",
      "consumer_application_ack": false
    },
    {
      "consumer_id": "planner.carrot",
      "source_path": "openpilot/selfdrive/carrot/carrot_functions.py",
      "meaning": "Cached stored-value observations; group reads do not prove final dynamic use",
      "sampling": "at_most_1_hz_sampled_observation",
      "consumer_application_ack": false
    },
    {
      "consumer_id": "planner.long_mpc",
