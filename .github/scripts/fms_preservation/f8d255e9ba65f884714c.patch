+@pytest.mark.parametrize('batch_cancel', [False, True])
+@pytest.mark.parametrize('publish_after_cancel', [False, True])
+def test_real_cruise_cancel_discards_pending_remote_and_rearms_only_fresh(tmp_path, monkeypatch,
+                                                                       batch_cancel, publish_after_cancel):
+  from openpilot.selfdrive.car.tests.test_carrot_cruise_buttons import make_remote_helper
+  clock = [10.]
+  monkeypatch.setattr('openpilot.selfdrive.carrot.bluetooth.model.time.monotonic', lambda: clock[0])
+  helper, cs, cc = make_remote_helper(None)
+  helper.autoCruiseControl = 0
+  reader = CommandReader('cruise', tmp_path)
+  writer = CommandWriter(tmp_path)
+  helper.bluetooth_commands = reader
+  assert reader.read(now=11.) is None
+
+  def publish_old():
+    writer.send('A', 'accelCruise', 11.005)
+    writer.send('B', 'decelCruise', 11.01)
+
+  if not publish_after_cancel:
+    publish_old()
+  clock[0] = 11.01  # cancellation must apply even inside the read throttle
+  cs.buttonEvents = [] if batch_cancel else [{'type': 'cancel', 'pressed': True}]
+  helper._update_cruise_buttons(cs, cc, 80., paddle_cancel_seen=batch_cancel)
+  assert helper._activate_cruise == -1 and helper._cruise_cancel_state
+  assert reader.last_check == 11. and reader.cancel_cutoff == 11.01
+  if publish_after_cancel:
+    publish_old()
+  # A physical press must publish its real release before a new remote action.
+  cs.buttonEvents = [] if batch_cancel else [{'type': 'cancel', 'pressed': False}]
+  for now in (11.04, 11.07):
+    clock[0] = now
+    helper._activate_cruise = 0  # update_v_cruise resets this publication each cycle
+    assert helper._update_cruise_buttons(cs, cc, 80.) == 80.
+    assert helper._activate_cruise == 0 and helper._cruise_cancel_state
+    cs.buttonEvents = []
+    writer.publish('cruise')  # writer replay must not resurrect either old action
+
+  writer.send('A', 'accelCruise', 11.08)
+  clock[0] = 11.11
+  helper._update_cruise_buttons(cs, cc, 80.)
+  assert helper._activate_cruise == 1 and not helper._cruise_cancel_state
+  clock[0] = 11.14
+  helper._activate_cruise = 0
+  helper._update_cruise_buttons(cs, cc, 80.)
+  assert helper._activate_cruise == 0 and len(reader.seen) == 3
+
