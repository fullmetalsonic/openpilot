+def production_daemon_emit(writer, mapping, *, learning=None, hold_blocked=False):
+  """Bind the unchanged production emit closure without importing Linux evdev."""
+  source = Path(__file__).resolve().parents[1] / 'daemon.py'
+  main = next(n for n in ast.parse(source.read_text()).body if isinstance(n, ast.FunctionDef) and n.name == 'main')
+  emit = next(n for n in main.body if isinstance(n, ast.FunctionDef) and n.name == 'emit')
+  wrapper = ast.parse('''
+def bind(settings, writer, learning, hold_blocked):
+  last_event = None
+  last_events, recent_events, last_fire = {}, [], {}
+  started = car_ok = True
+''').body[0]
+  wrapper.body.extend([emit, ast.Return(value=ast.Name(id='emit', ctx=ast.Load()))])
+  namespace = {'uuid': uuid}
+  exec(compile(ast.fix_missing_locations(ast.Module(body=[wrapper], type_ignores=[])), str(source), 'exec'), namespace)
+  settings = {'devices': {mac: {'enabled': True, 'mapping': actions} for mac, actions in mapping.items()}}
+  return namespace['bind'](settings, writer, learning or {}, hold_blocked)
 
 
