+@pytest.mark.parametrize('gesture', ['single', 'double', 'long'])
+def test_daemon_fresh_post_cancel_gestures_rearm_without_losing_ttl_or_peer_order(tmp_path, gesture):
+  from openpilot.selfdrive.carrot.bluetooth.tests.test_fast_blinker import frame
+  mapping = {'key:30': 'accelCruise', 'key:30@double': 'gapAdjustCruise', 'key:30@long': 'accelCruiseLong'}
+  options = {'double': gesture in ('single', 'double'), 'long': gesture == 'long'}
+  a, b = Decoder(mapping=mapping, gestures=options), Decoder(mapping=mapping, gestures=options)
+  writer = CommandWriter(tmp_path)
+  reader = CommandReader('cruise', tmp_path)
+  reader.started = 9.
+  emit = production_daemon_emit(writer, {'A': mapping, 'B': mapping})
+  reader.read(allowed=False, now=10.1, cancel_pending=True)
+  for path, decoder in (('A', a), ('B', b)):
+    if gesture == 'long':
+      assert frame(decoder, [(1, 30, 1)], 10.2) == []
+      tokens, now = decoder.flush(10.91), 10.91
+    else:
+      assert press(decoder, 30, 10.2) == []
+      tokens, now = (press(decoder, 30, 10.35), 10.4) if gesture == 'double' else (decoder.flush(10.61), 10.61)
+    assert tokens[0].started == 10.2
+    emit('input-' + path, path, decoder, tokens, now)
+  action = mapping['key:30' + {'single': '', 'double': '@double', 'long': '@long'}[gesture]]
+  assert [reader.read(now=now + offset) for offset in (.03, .06, .09)] == [action, action, None]
+  assert [event['address'] for event in writer.events['cruise']] == ['A', 'B']
+
