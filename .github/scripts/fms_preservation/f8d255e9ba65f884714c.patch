+@pytest.mark.parametrize('gesture', ['single_flush', 'short_release', 'double_release', 'double_straddles_cancel',
+                                  'long_flush_repeat', 'long_release', 'fast_key', 'fast_touch', 'touch_long_direction'])
+def test_daemon_preserves_pre_cancel_gesture_origin_on_every_emit_path(tmp_path, gesture):
+  from openpilot.selfdrive.carrot.bluetooth.tests.test_fast_blinker import frame
+  mapping = {'key:30': 'accelCruise', 'key:30@double': 'gapAdjustCruise', 'key:30@long': 'accelCruiseLong',
+             'left': 'accelCruise', 'left@long': 'accelCruiseLong'}
+  gestures = {'double': gesture in ('single_flush', 'double_release', 'double_straddles_cancel'),
+              'long': gesture in ('short_release', 'long_flush_repeat', 'long_release', 'touch_long_direction')}
+  decoder = Decoder('yiser-j6' if 'touch' in gesture else 'generic', mapping, gestures=gestures)
+  writer = CommandWriter(tmp_path)
+  reader = CommandReader('cruise', tmp_path)
+  reader.started = 9.
+  emit = production_daemon_emit(writer, {'A': mapping})
+  if 'touch' in gesture:
+    frame(decoder, [(3, 0, 300), (3, 1, 500), (1, 330, 1)], 10.)
+  elif gesture == 'fast_key':
+    assert decoder.feed(1, 30, 1, 10.) == []  # SYN_REPORT itself may arrive after CANCEL.
+  elif gesture in ('single_flush', 'double_release', 'double_straddles_cancel'):
+    assert press(decoder, 30, 10., .02) == []
+    if gesture == 'double_release':
+      assert frame(decoder, [(1, 30, 1)], 10.05) == []
+  else:
+    assert frame(decoder, [(1, 30, 1)], 10.) == []
+  assert reader.read(allowed=False, now=10.1, cancel_pending=True) is None
+
+  if gesture == 'single_flush':
+    tokens, now = decoder.flush(10.38), 10.38
+  elif gesture == 'double_straddles_cancel':
+    tokens, now = press(decoder, 30, 10.2), 10.25
+  elif gesture in ('short_release', 'double_release', 'long_release'):
+    now = 10.75 if gesture == 'long_release' else 10.25
+    tokens = frame(decoder, [(1, 30, 0)], now)
+  elif gesture == 'fast_key':
+    tokens, now = decoder.feed(0, 0, 0, 10.2), 10.2
+  elif gesture == 'fast_touch':
+    tokens, now = frame(decoder, [(3, 0, 450)], 10.2), 10.2
+  else:
+    if gesture == 'touch_long_direction':
+      assert frame(decoder, [(3, 0, 450)], 10.2) == []
+    now = 10.91
+    tokens = decoder.flush(now)
+  assert tokens and all(token.started == 10. for token in tokens)
+  emit('input-a', 'A', decoder, tokens, now)
+  assert writer.events['cruise'][-1]['started'] == 10.
+  assert writer.events['cruise'][-1]['time'] == now
+  assert reader.read(now=now + .03) is None
+  if gesture in ('long_flush_repeat', 'touch_long_direction'):
+    tokens = decoder.flush(now + .51)
+    assert tokens and decoder.repeated
+    emit('input-a', 'A', decoder, tokens, now + .51)
+    assert writer.events['cruise'][-1]['repeat']
+    assert reader.read(now=now + .54) is None
+
+  # The same decoder rearms after the old gesture ends; no reconnect/reset.
+  fresh = now + 1.
+  if 'touch' in gesture:
+    frame(decoder, [(1, 330, 0)], fresh - .05)
+    frame(decoder, [(3, 0, 300), (3, 1, 500), (1, 330, 1)], fresh)
+    tokens = frame(decoder, [(3, 0, 450)], fresh + .02)
+    emitted = fresh + .02
+    if gestures['long']:
+      tokens, emitted = decoder.flush(fresh + .75), fresh + .75
+  else:
+    frame(decoder, [(1, 30, 0)], fresh - .05)
+    tokens = frame(decoder, [(1, 30, 1)], fresh)
+    tokens += frame(decoder, [(1, 30, 0)], fresh + .05)
+    emitted = fresh + .05
+    if gestures['double']:
+      tokens, emitted = decoder.flush(fresh + .41), fresh + .41
+  assert tokens and all(token.started == fresh for token in tokens)
+  emit('input-a', 'A', decoder, tokens, emitted)
+  assert reader.read(now=emitted + .03) == mapping[tokens[0]]
+
