+def test_fms_ble_normal_completion_retires_old_torque_episode(monkeypatch):
+  sent, _ = run_fms_ble_source(monkeypatch, interruption="completed")
+  assert sent[4]["hold"] is None
+  assert sent[5]["hold"] is None
+  assert all(record["hold"] and record["hold"]["direction"] == "left" for record in sent[6:8])
