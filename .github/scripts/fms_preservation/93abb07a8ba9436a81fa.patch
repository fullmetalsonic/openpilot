+def run_fms_ble_source(monkeypatch, *, interruption="torque", fingerprint="KIA_SORENTO_HEV_4TH_GEN",
+                       ble=True, tap_during_block=False):
+  import json
+  from contextlib import nullcontext
+  from types import SimpleNamespace as NS
+  from test_blinker import Vehicle
+  # Load the production guard before the source fixture replaces messaging imports.
+  import importlib
+  importlib.import_module("opendbc.car.hyundai.hyundaicanfd")
+  import blink_source as source
+  from openpilot.selfdrive.carrot.bluetooth import model
+
+  class Desire:
+    def __init__(self, side):
+      self.raw = {"left": 3, "right": 4}.get(side, 0)
+
+    def __str__(self):
+      return {0: "none", 3: "laneChangeLeft", 4: "laneChangeRight"}[self.raw]
+
+  clock, sent, leases = [10.], [], []
+  received = set()
+  sm = Vehicle(speed=5.)
+  cs = sm["carState"]
+  cs.steeringPressed, cs.steeringTorque = False, 0.
+  cs.leftBlinkerStalkCount = cs.rightBlinkerStalkCount = 0
+  cs.trailerConnected = False
+  sm["modelV2"] = NS(meta=NS())
+  sm["carrotMan"] = NS(atcType="none", xDistToTurn=40)
+  sm["livePose"] = NS(inputsOK=True, sensorsOK=True, posenetOK=True, orientationNED=NS(valid=True, z=0.))
+  sm.services = list(sm)
+  sm.valid = dict.fromkeys(sm, True)
+  sm.alive = dict.fromkeys(sm, True)
+  sm["selfdriveState"].atcTurnStartMonoTime = 0
+  sm["selfdriveState"].atcTurnDirection = "none"
+
+  def tick(_):
+    index = len(sent)
+    clock[0] = 10. + index * .05
+    sm.recv_time = dict.fromkeys(sm, clock[0])
+    side = "none" if index in (0, 8) else "right" if index >= 9 else "left"
+    lane_state = "off" if index in (0, 8) else "preLaneChange" if index in (1, 9) else "laneChangeStarting"
+    if interruption == "cancel_then_torque" and index in (3, 4):
+      lane_state = "off"
+    if interruption == "completed" and index in (4, 5):
+      side, lane_state = "none", "off"
+    if interruption == "completed" and index == 6:
+      lane_state = "preLaneChange"
+    cs.steeringPressed = index == 2 or (index == 4 and interruption in ("torque", "cancel_then_torque"))
+    if interruption == "completed":
+      cs.steeringPressed = index in (2, 5)
+    cs.canValid = not (interruption == "invalid" and index == 4)
+    sm["carControl"].latActive = not (interruption == "lat_off" and index == 4)
+    cs.rightBlinkerStalkCount = int(index >= 9)
+    cs.leftBlinker, cs.rightBlinker = side == "left", side == "right"
+    meta = sm["modelV2"].meta
+    meta.desire = Desire(side if lane_state != "off" else "none")
+    meta.desireState = [0.] * 5
+    meta.autoTurnSignal, meta.autoTurnSignalLaneChange = side, side != "none"
+    meta.laneChangeState = lane_state
+    meta.laneChangeBlinkerHold = side if lane_state != "off" else "none"
+    meta.laneChangeCompletedMonoTime = 100 if interruption == "completed" and index >= 4 else 0
+
+  def receive(_):
+    index = len(sent)
+    received.add(index)
+    if index == 13:
+      return b""
+    previous = sent[-1]["hold"] if sent else None
+    return json.dumps({"stamp": 10. + index * .05, "state": "ready",
+                       "accepted_id": previous["id"] if previous else None}).encode()
+
+  sm.update = tick
+  monkeypatch.setitem(sys.modules, "openpilot.common.params", NS(Params=lambda: NS(
+    get=lambda _: b"cp", get_int=lambda key: 2 if key == "AutoBlinkerControl" else 0,
+    get_bool=lambda key: key == "AlwaysLateral")))
+  monkeypatch.setitem(sys.modules, "openpilot.cereal", NS(messaging=NS(SubMaster=lambda _: sm),
+    car=NS(CarParams=NS(from_bytes=lambda _: nullcontext(NS(carFingerprint=fingerprint, passive=False))))))
+  sock = NS(setblocking=lambda _: None, recv=receive, send=lambda raw: sent.append(json.loads(raw)))
+  monkeypatch.setattr(source.socket, "socket", lambda **kw: sock)
+  monkeypatch.setattr(source.select, "select", lambda *args: ([sock] if len(sent) not in received else [], [], []))
+  monkeypatch.setattr(source.time, "monotonic", lambda: clock[0])
+  monkeypatch.setattr(source.time, "sleep", lambda _: None)
+  monkeypatch.setattr(source, "PACKAGE_CONFIG", NS(read_text=lambda: json.dumps({"fingerprint": fingerprint})))
+  monkeypatch.setattr(source.Events, "read", lambda *args: [
+    {"id": "fresh-physical-tap", "time": clock[0], "direction": "right"}
+  ] if len(sent) == 6 and tap_during_block else [])
+  monkeypatch.setattr(model, "read_json", lambda *args: {})
+  monkeypatch.setattr(model, "config", dict)
+  monkeypatch.setattr(model, "atomic_json", lambda path, value: leases.append(value) if path.name == "physical-hold.json" else None)
+  source.main(0, ble=ble)
+  assert len(sent) == len(leases) == 13
+  return sent, leases
