+@pytest.mark.parametrize("interruption", ["torque", "cancel_then_torque", "invalid", "lat_off"])
+def test_fms_ble_source_releases_lane_hold_until_a_fresh_stalk(monkeypatch, interruption):
+  sent, leases = run_fms_ble_source(monkeypatch, interruption=interruption)
+  assert all(record["hold"] and record["hold"]["direction"] == "left" for record in sent[1:4])
+  assert all(record["hold"] is None and not record["activated"] for record in sent[4:9])
+  assert all(record["direction"] is None and not record["override"] for record in leases[4:9])
+  assert all(record["hold"] and record["hold"]["direction"] == "right" for record in sent[9:])
+  assert not any(record["events"] for record in sent)
+
+  from openpilot.selfdrive.carrot.bluetooth.b1_monitor import Intent
+  intent = Intent()
+  original = sent[3]["hold"]
+  intent.inflight = (3, original["id"])
+  intent.queued = (original, True, sent[4]["stamp"] + 3)
+  op, event, _ = intent.choose(sent[4], "ready", 3, sent[4]["stamp"])
+  assert op == (3 if interruption == "invalid" else 0) and event is None
+  assert intent.queued is None
+  assert all(intent.choose(record, "waiting", 3, record["stamp"])[0] not in (4, 5) for record in sent[4:6])
+
+
+def test_fms_ble_hold_block_preserves_fresh_physical_taps(monkeypatch):
+  sent, _ = run_fms_ble_source(monkeypatch, tap_during_block=True)
+  assert all(record["hold"] is None for record in sent[4:9])
+  assert sent[6]["events"] == [{"id": "fresh-physical-tap", "time": sent[6]["stamp"], "direction": "right"}]
+
