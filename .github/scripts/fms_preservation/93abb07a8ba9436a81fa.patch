+@pytest.mark.parametrize("fingerprint,ble", [
+  ("KIA_EV6", True),
+  ("HYUNDAI_IONIQ_5_PE", True),
+  ("HYUNDAI_IONIQ_5_PE", False),
+])
+def test_fms_ble_hold_adaptation_leaves_other_paths_on_original_policy(monkeypatch, fingerprint, ble):
+  sent, _ = run_fms_ble_source(monkeypatch, fingerprint=fingerprint, ble=ble)
+  assert all(record["hold"] and record["hold"]["direction"] == "left" for record in sent[1:6])
+
