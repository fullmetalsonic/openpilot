+def test_independent_and_normal_stop_mode_transition(camera):
+  cs = make_cs()
+  cs.softHoldActive = 2
+  cs.out.vEgo = cs.out.vEgoRaw = 0.
+  cs.out.wheelSpeeds = SimpleNamespace(fl=0., fr=0., rl=0., rr=0.)
+  controller = CanfdStopping()
+  previous_value = 0.
+  for _ in range(70):
+    values = send(camera, controller, cs, enabled=False, stopping=False, accel=0., previous_value=previous_value)
+    previous_value = values['aReqValue']
+    if values['StopReq']:
+      break
+  assert values['StopReq'] == 1
+  assert values['aReqRaw'] == pytest.approx(-.5)
+
+  # Longitudinal control resumes: upstream's adjustable -1.2 request owns
+  # both acceleration fields; no independent preparation remains active.
+  for _ in range(50):
+    values = send(camera, controller, cs, enabled=True, stopping=True, accel=-1.2,
+                  previous_value=previous_value, previous_target=-1.2)
+    previous_value = values['aReqValue']
+  assert controller.phase != StopPhase.prepare
+  assert values['StopReq'] == 1
+  assert values['aReqRaw'] == pytest.approx(-1.2)
+  assert values['aReqValue'] == pytest.approx(-1.2)
+
+  # A later independent episode starts with negative preparation again.
+  prior_value = values['aReqValue']
+  values = send(camera, controller, cs, enabled=False, stopping=False, accel=0.,
+                previous_value=prior_value)
+  assert controller.phase == StopPhase.prepare
+  assert values['StopReq'] == 0
+  assert values['aReqRaw'] == pytest.approx(-.5)
+  assert 0 <= values['aReqValue'] - prior_value <= .04 + .0051
+  assert values['aReqValue'] < -1.1
