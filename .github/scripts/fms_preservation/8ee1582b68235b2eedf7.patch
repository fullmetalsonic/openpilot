+def test_same_keys_missing_raw_api_fails_boot_check(monkeypatch, tmp_path):
+  header = tmp_path / 'params_keys.h'
+  header.write_text(SOURCE, encoding='utf-8')
+  monkeypatch.setattr(params_check, 'PARAMS_HEADER', header)
+  keys = [b'Existing', b'AutoNaviSpeedBumpEndDistance']
+
+  class OldParamsWithoutRawApi:
+    def __init__(self, path=None):
+      if not path:
+        raise ValueError('Production default constructor not allowed')
+      self.path = path
+
+    def all_keys(self):
+      return keys
+
+  native = SimpleNamespace(Params=OldParamsWithoutRawApi)
+  monkeypatch.setitem(sys.modules, 'openpilot.common.params', native)
+  assert params_check.main() == 1
+
+
+@pytest.mark.parametrize('bad_method', ['get_raw', 'get_many_raw', 'compare_and_set_raw'])
+def test_noncallable_raw_api_fails_boot_check(monkeypatch, tmp_path, bad_method):
+  header = tmp_path / 'params_keys.h'
+  header.write_text(SOURCE, encoding='utf-8')
+  monkeypatch.setattr(params_check, 'PARAMS_HEADER', header)
+  keys = [b'Existing', b'AutoNaviSpeedBumpEndDistance']
+
+  class ParamsWithNonCallableApi:
+    def __init__(self, path=None):
+      if not path:
+        raise ValueError('Production default constructor not allowed')
+      self.path = path
+
+    def all_keys(self):
+      return keys
+
+    get_raw = (lambda self, k: b'') if bad_method != 'get_raw' else 'not_callable'
+    get_many_raw = (lambda self, ks: {}) if bad_method != 'get_many_raw' else 123
+    compare_and_set_raw = (lambda self, k, v, e: {}) if bad_method != 'compare_and_set_raw' else None
+
+  native = SimpleNamespace(Params=ParamsWithNonCallableApi)
+  monkeypatch.setitem(sys.modules, 'openpilot.common.params', native)
   assert params_check.main() == 1
 
 
