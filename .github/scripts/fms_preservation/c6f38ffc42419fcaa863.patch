+@pytest.mark.parametrize("message", ("CRUISE_BUTTONS", "CRUISE_BUTTONS_ALT"))
+def test_sorento_main_feedback_preserves_paddle_cancel_and_independent_hold(sorento_chain, message):
+  from opendbc.car.hyundai.stopping import CanfdStopping
+  from opendbc.car.hyundai.tests.test_stopping import send
+
+  chain = sorento_chain(message)
+  # OEM MAIN before/during/after an OFF paddle gesture never changes the gap.
+  for main, paddle in ((False, 0), (True, 2), (False, 2), (True, 0)):
+    cs = chain.tick(main, paddle=paddle)
+    assert not cs.cruiseState.available and not cs.latEnabled and cs.activateCruise == 0
+  assert chain.params.writes == []
+
+  # A real SET arms driver intent; the separately supplied active control state
+  # then permits mode 4 to change only the stored gap.
+  chain.tick(True, buttons={"CRUISE_BUTTONS": Buttons.SET_DECEL})
+  cs = chain.tick(True)
+  assert cs.cruiseState.available and cs.latEnabled and cs.activateCruise == 0
+  chain.cc.enabled = chain.cc.longActive = True
+  chain.tick(False, paddle=2)
+  chain.tick(True, paddle=0)
+  assert chain.params.writes == [0]
+  assert chain.cs.activateCruise == 0 and not chain.helper._paddle_decel_active
+
+  # Same-batch CANCEL wins over the next gap request and latches through MAIN feedback.
+  cs = chain.tick(False, paddle=1, buttons={"CRUISE_BUTTONS": Buttons.CANCEL})
+  assert cs.activateCruise < 0 and chain.helper._cruise_cancel_state
+  chain.cc.enabled = chain.cc.longActive = False
+  for main, paddle in ((True, 1), (False, 0), (True, 1), (True, 0)):
+    cs = chain.tick(main, paddle=paddle)
+    assert cs.activateCruise <= 0 and chain.helper._cruise_cancel_state
+    assert not cs.latEnabled and not chain.cc.latActive
+  assert chain.params.writes == [0]
+
+  # A separate short CANCEL retains the configured lateral-off release policy.
+  chain.tick(True, buttons={"CRUISE_BUTTONS": Buttons.CANCEL})
+  assert not chain.tick(False).latEnabled
+  for main in (True, False, True):
+    cs = chain.tick(main)
+    assert cs.activateCruise <= 0 and not cs.latEnabled and not chain.cc.latActive
+
+  # With CANCEL retained, the approved brake hold remains independent of MAIN.
+  chain.tick(True, buttons={"ADAPTIVE_CRUISE_MAIN_BTN": 1})
+  assert not chain.tick(True).cruiseState.available
+  for frame in range(65):
+    cs = chain.tick(bool(frame % 2), brakePressed=True, vEgo=0., vEgoRaw=0.)
+    assert not cs.cruiseState.available and not cs.latEnabled and cs.activateCruise <= 0
+  assert cs.softHoldActive == chain.state.softHoldActive == 1
+  controllers = {camera: CanfdStopping() for camera in (False, True)}
+  previous = {camera: 0. for camera in controllers}
+  for frame in range(40):
+    cs = chain.tick(bool(frame % 2))
+    for camera, controller in controllers.items():
+      values = send(camera, controller, chain.state, enabled=False, stopping=False, accel=0., previous_value=previous[camera])
+      previous[camera] = values["aReqValue"]
+      assert values["ACCMode"] == 1 and values["aReqRaw"] < 0 and values["aReqValue"] < 0
+  assert all(controller.phase.name == "held" for controller in controllers.values())
+  assert values["StopReq"] == 1
+  assert chain.params.writes == [0]
+
+  cs = chain.tick(True, gasPressed=True, gas=.2, brakePressed=False)
+  assert cs.softHoldActive == 0 and cs.activateCruise <= 0 and chain.helper._cruise_cancel_state
+  for camera, controller in controllers.items():
+    values = send(camera, controller, chain.state, enabled=False, stopping=False, accel=0., previous_value=previous[camera])
+    assert values["ACCMode"] == 0 and values["StopReq"] == 0
+    assert values["aReqRaw"] == values["aReqValue"] == 0
