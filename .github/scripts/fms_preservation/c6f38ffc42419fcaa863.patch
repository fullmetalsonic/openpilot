+@pytest.fixture
+def sorento_chain(setup_driver):
+  """Real DBC parsers and production receive/publication blocks, without IPC.
+
+  The selected blocks execute unchanged; the complete card/controlsd processes
+  and actual Panda forwarding still require Linux/device verification.
+  """
+  from collections import deque
+
+  from opendbc.can import CANPacker
+  from opendbc.car import Bus, create_button_events, structs
+  from opendbc.car.hyundai.carstate import BUTTONS_DICT, READY_COUNT_OK
+  from opendbc.car.hyundai.values import CAR
+  from openpilot.selfdrive.car.tests.test_paddle_gap import MemoryParams
+  from openpilot.selfdrive.carrot.paddle_gap import PaddleGapWriter
+
+  root = Path(__file__).resolve().parents[4]
+
+  def method(path, cls, name):
+    tree = ast.parse((root / path).read_text(encoding="utf-8"))
+    owner = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == cls)
+    return next(n for n in owner.body if isinstance(n, ast.FunctionDef) and n.name == name)
+
+  def assignment(node, target):
+    return isinstance(node, ast.Assign) and any(ast.unparse(t) == target for t in node.targets)
+
+  body = method("opendbc_repo/opendbc/car/hyundai/carstate.py", "CarState", "update_canfd").body
+  main_start = next(i for i, n in enumerate(body) if assignment(n, "prev_main_buttons"))
+  main_end = next(i for i, n in enumerate(body) if assignment(n, "ret.cruiseState.available"))
+  buttons_start = next(i for i, n in enumerate(body) if assignment(n, "prev_cruise_buttons"))
+  buttons_end = next(i for i, n in enumerate(body) if isinstance(n, ast.Expr) and
+                     isinstance(n.value, ast.Call) and ast.unparse(n.value.func) == "self.cruise_buttons.extend")
+  tail_start = next(i for i, n in enumerate(body) if assignment(n, "paddle_button"))
+  receive = compile(ast.Module(body=body[main_start:main_end + 1] + body[buttons_start:buttons_end + 1] +
+                               body[tail_start:-1], type_ignores=[]), "<CarState MAIN/buttons>", "exec")
+  card_body = method("openpilot/selfdrive/car/card.py", "Car", "state_update").body
+  publication = compile(ast.Module(body=[n for n in card_body if any(assignment(n, target) for target in
+    ("CS.softHoldActive", "CS.activateCruise", "CS.latEnabled", "self.CI.CS.softHoldActive"))], type_ignores=[]),
+    "<card cruise publication>", "exec")
+  assert len([n for n in card_body if assignment(n, "CS.latEnabled")]) == 1
+  control = ast.parse((root / "openpilot/selfdrive/controls/controlsd.py").read_text(encoding="utf-8"))
+  gate = next(n for n in control.body if isinstance(n, ast.FunctionDef) and n.name == "lateral_control_allowed")
+  scope = {}
+  exec(compile(ast.Module(body=[gate], type_ignores=[]), "<controlsd lateral gate>", "exec"), scope)
+  writers = []
+
+  def make(message):
+    state, helper, initial_tick = setup_driver()
+    cs = initial_tick(False)
+    state.CP.carFingerprint = CAR.KIA_SORENTO_HEV_4TH_GEN
+    state.CP.safetyConfigs = [{"safetyModel": "hyundaiCanfd"}]
+    if message == "CRUISE_BUTTONS_ALT":
+      state.CP.flags |= int(HyundaiFlags.CANFD_ALT_BUTTONS)
+    parsers = state.get_can_parsers(state.CP)
+    cp, cp_cam = parsers[Bus.pt], parsers[Bus.cam]
+    for name in (message, "GEAR"):
+      if name not in cp.vl:
+        cp._add_message(name, 50)
+    for name in ("SCC_CONTROL", "LFAHDA_CLUSTER"):
+      cp_cam._add_message(name, 50)
+    state.__dict__.update(main_buttons=deque([0], maxlen=8), cruise_buttons=deque([0], maxlen=8),
+      cruise_buttons_alt2=None, cruise_btns_msg_canfd=message, gear_msg_canfd="GEAR", controls_ready_count=READY_COUNT_OK,
+      paddle_button_prev=0, speedcam_accel_swallow=False, speedcam_decel_hold=False, section_average=SimpleNamespace(unlocked=False),
+      canfdSccHoldActive=False, out=cs)
+    params = MemoryParams(current=1)
+    params.values.update(PaddleMode=4, AutoCruiseControl=1, SoftHoldOnCancel=True, CancelButtonMode=1,
+                         CruiseButtonLongDelay=40, CruiseSpeedUnit=10, CruiseSpeedUnitBasic=1)
+    helper.params = params
+    helper._paddle_mode = 4
+    writer = helper._paddle_gap_writer = PaddleGapWriter(lambda: params)
+    writers.append(writer)
+    cc = car.CarControl(enabled=False, longActive=False, latActive=False)
+    class Messages(dict):
+      alive = dict.fromkeys(("longitudinalPlan", "radarState", "drivingModelData"), False)
+      seen = {"carrotMan": False}
+
+      def all_checks(self, services):
+        assert services == ["carControl"]
+        return True
+
+    sm = Messages(carControl=cc)
+    packer = CANPacker("hyundai_canfd_generated")
+    card = SimpleNamespace(v_cruise_helper=helper, CI=SimpleNamespace(CS=state))
+    frame = 0
+
+    def tick(stock_main, *, buttons=None, source_bus=0, paddle=0, **values):
+      nonlocal frame
+      frame += 1
+      for name, value in values.items():
+        setattr(cs, name, value)
+      button_values = dict(buttons or {})
+      paddle_values = {"RIGHT_PADDLE": int(paddle == 2), "LEFT_PADDLE": int(paddle == 1)}
+      if message == "CRUISE_BUTTONS":
+        button_values.update(paddle_values)
+      frames = [packer.make_can_msg(message, source_bus, button_values),
+                packer.make_can_msg("GEAR", 0, paddle_values),
+                packer.make_can_msg("SCC_CONTROL", 2, {"MainMode_ACC": int(stock_main)}),
+                packer.make_can_msg("LFAHDA_CLUSTER", 2, {"HDA_LFA_SymSta": 1})]
+      for parser in (cp, cp_cam):
+        parser.update([1_000_000_000 + frame * 10_000_000, frames])
+      exec(receive, {"self": state, "cp": cp, "cp_cam": cp_cam, "ret": cs,
+                     "HyundaiFlags": HyundaiFlags, "READY_COUNT_OK": READY_COUNT_OK,
+                     "BUTTONS_DICT": BUTTONS_DICT, "ButtonType": structs.CarState.ButtonEvent.Type,
+                     "create_button_events": create_button_events, "speedcam_decel_long_press": False})
+      helper.update_v_cruise(cs, sm, True, paddle_cancel_seen=state.paddle_input.cancel_seen)
+      exec(publication, {"self": card, "CS": cs})
+      state.scc_control = dict(cp_cam.vl["SCC_CONTROL"])
+      cc.latActive = scope["lateral_control_allowed"](False, True, cs.latEnabled, False, False, False, False, False)
+      writer._queue.join()
+      return cs
+
+    return SimpleNamespace(state=state, helper=helper, cs=cs, cc=cc, params=params, tick=tick, cp=cp)
+
+  yield make
+  for writer in writers:
+    writer.close()
+
+
+@pytest.mark.parametrize("message", ("CRUISE_BUTTONS", "CRUISE_BUTTONS_ALT"))
+@pytest.mark.parametrize("source_bus", (2, 130))
+def test_camera_main_requests_and_tx_echo_cannot_become_physical_main(sorento_chain, message, source_bus):
+  chain = sorento_chain(message)
+  for main, pressed in ((False, 0), (True, 1), (True, 1), (True, 0), (False, 0), (True, 0)):
+    cs = chain.tick(main, buttons={"ADAPTIVE_CRUISE_MAIN_BTN": pressed}, source_bus=source_bus)
+    assert not cs.cruiseState.available and not cs.latEnabled and not chain.cc.latActive
+    assert cs.activateCruise == 0 and not chain.state.manual_main_off_latched
+    assert chain.cp.vl[message]["ADAPTIVE_CRUISE_MAIN_BTN"] == 0
+    assert not any(b.type == "mainCruise" for b in cs.buttonEvents)
+
+  chain.tick(True, buttons={"ADAPTIVE_CRUISE_MAIN_BTN": 1})
+  cs = chain.tick(True)
+  assert cs.cruiseState.available and cs.latEnabled and chain.cc.latActive
+  assert any(b.type == "mainCruise" and not b.pressed for b in cs.buttonEvents)
+  chain.tick(True, buttons={"ADAPTIVE_CRUISE_MAIN_BTN": 1})
+  assert not chain.tick(True).cruiseState.available
+  for main in (True, False, True):
+    assert not chain.tick(main).cruiseState.available
+
