+def restore_saved_readers(run, monkeypatch):
+  """Exercise the production mode poll and 10/20/30/40-cycle parameter reader."""
+  from openpilot.selfdrive.carrot import signal_mode
+  source = (REPO/'openpilot/selfdrive/carrot/carrot_functions.py').read_text(encoding='utf8')
+  node = next(n for n in ast.parse(source).body if isinstance(n, ast.ClassDef) and n.name == 'CarrotPlanner')
+  method = next(n for n in node.body if isinstance(n, ast.FunctionDef) and n.name == '_params_update')
+  namespace = run.p.update.__func__.__globals__
+  exec(compile(ast.Module([method], type_ignores=[]), 'actual_params_reader', 'exec'), namespace)
+  type(run.p)._params_update = namespace['_params_update']
+  values = dict(MyDrivingMode=3, MyDrivingModeAuto=0, TrafficLightDetectMode=2,
+                SignalAssistMode=2, StopDistanceCarrot=520, TrafficStopDistanceAdjust=0,
+                TFollowGap1=50, TFollowGap2=100, TFollowGap3=150, TFollowGap4=200,
+                LeadAccelResponse=3, LeadAccelResponseTF1=4, LeadAccelResponseTF2=3,
+                LeadAccelResponseTF3=2, LeadAccelResponseTF4=1, DynamicTFollowLC=80,
+                SpeedTFFactor=10, TFollowDecelBoost=0, AutoNaviSpeedDecelRate=120,
+                AChangeCostStarting=10, VEgoStopping=1)
+  class SavedParams:
+    def get_int(self, name): return int(values.get(name, 0))
+    def get_float(self, name): return float(values.get(name, 0))
+  run.p.params = SavedParams()
+  for _ in range(40):
+    run.p._params_update()
+  assert run.p.myDrivingMode.value == 3 and run.p.trafficLightDetectMode == 2
+  assert run.p.stop_distance == 5.2 and run.p.trafficStopDistanceAdjust == 0
+  assert run.p.tFollowGap1 == .5 and run.p.leadAccelResponseTF[0] == 4
+  # RunningPlanner normally replaces the mode lookup for withdrawal scenarios;
+  # restore its real function and fake only the native Params storage boundary.
+  import importlib
+  namespace_mode = {}
+  exec(compile((REPO/'openpilot/selfdrive/carrot/signal_mode.py').read_text(encoding='utf8'),
+               'actual_signal_mode_reader', 'exec'), namespace_mode)
+  namespace_mode['_params'] = run.p.params
+  monkeypatch.setattr(signal_mode, 'signal_mode', namespace_mode['signal_mode'])
+  return values
+
