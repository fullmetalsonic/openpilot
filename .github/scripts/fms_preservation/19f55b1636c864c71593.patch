+@pytest.mark.parametrize('color', ['red', 'unknown', 'green'])
+@pytest.mark.parametrize('stay', [False, True])
+def test_real_mode_saved_settings_transport_to_mpc_and_final_guard(monkeypatch, tmp_path, color, stay):
+  from openpilot.selfdrive.carrot.tests.test_signal_off_release import RunningPlanner
+  from openpilot.selfdrive.carrot.tests.test_signal_departure import current_mpc
+  run = RunningPlanner(monkeypatch, tmp_path, mode=2, stay=stay, lead=False,
+                       speed=0., planner_mode='acc', acquire=False)
+  active_acc(run.sm)
+  saved = restore_saved_readers(run, monkeypatch)
+  run.sm['selfdriveState'].personality = 0
+  for _ in range(15):
+    run.tick(color='red', elapsed=.05)
+  assert run.runtime.guard.hold and run.p.start_decision.hold
+  run.sm['radarState'].leadOne = NS(status=True, dRel=4., vLead=2., radar=False)
+  for cycle in range(20):
+    mpc = run.tick(color=color, elapsed=.05)
+    assert not run.p.start_decision.hold and run.p.start_decision.reason == 'lead_follow'
+    assert not run.p.start_decision.green_confirmed and not run.p.start_decision.released
+    assert not final_output(run.p).output_should_stop
+    assert run.p.xState.name == 'lead' and run.p.stop_dist == 1000.
+    assert mpc.source != 'e2e' and mpc.params[0, 2] > 0.
+    assert mpc.params[0, 7] == pytest.approx(5.2)
+    assert run.p.carrot_stay_stop is stay  # no deletion of the real navigation state
+    if cycle > 0:
+      assert run.p.v_cruise > 0
+  assert saved['VEgoStopping'] * .01 == .01 and saved['StopDistanceCarrot'] == 520
+  # Current red reacquires during a bypass; unknown retains existing red. A
+  # real confirmed green may legitimately retire the guard's internal latch.
+  if color != 'green':
+    run.sm['radarState'].leadOne.status = False
+    run.tick(color='unknown', elapsed=.05)
+    assert run.p.start_decision.hold and final_output(run.p).output_should_stop
+    assert current_mpc(run.p, run.sm).source == 'e2e'
+
