+def test_same_batch_cancel_negative_request_reaches_planner_then_existing_controls_off():
+  from openpilot.cereal import car, log
+  from openpilot.selfdrive.car.tests.test_carrot_cruise_buttons import make_remote_helper
+  from openpilot.selfdrive.car.car_specific import CarSpecificEvents
+  from openpilot.selfdrive.selfdrived.state import StateMachine
+  helper, cs, cc = make_remote_helper(None, enabled=True)
+  # The parser's same-batch press/release evidence survives even when the
+  # public final transition list is empty. Exercise its real VCruise consumer.
+  cs.buttonEvents = []
+  helper._update_cruise_buttons(cs, cc, 80., paddle_cancel_seen=True)
+  assert helper._cruise_cancel_state and helper._activate_cruise == -1
+  cs.activateCruise = helper._activate_cruise  # actual card publication field
+  p, sm = setup(); active_acc(sm)
+  sm['carState'].activateCruise = cs.activateCruise
+  sm['radarState'].leadOne = NS(status=True, dRel=4.)
+  update(p, sm, 1., 'unknown')
+  assert p.start_decision.hold and p.start_decision.reason != 'lead_follow'
+  # CarControl still reflects the previous enabled frame here. The existing
+  # common-events path consumes that negative request and disables controls.
+  events = CarSpecificEvents(NS(pcmCruise=False, openpilotLongitudinalControl=True))
+  state = StateMachine(); state.state = log.SelfdriveState.OpenpilotState.enabled
+  enabled, _ = state.update(events.create_common_events(cs, car.CarState(), pcm_enable=False))
+  assert not enabled
+  # The next card cycle resets the request to zero; it is not a planner latch.
+  # Current enabled/longActive context now removes permission independently.
+  sm['carState'].activateCruise = 0
+  sm['selfdriveState'].enabled = sm['carControl'].enabled = sm['carControl'].longActive = enabled
+  ctx = dict(now=1.05, enabled=enabled, valid=True, drive=True)
+  p.update(sm, 80., 'acc', start_context=ctx, signal_context=ctx)
+  assert p.start_decision.reason != 'lead_follow'
+  assert not sm['carControl'].enabled and not sm['carControl'].longActive
+
