+@pytest.mark.parametrize('order', ['native_first', 'auxiliary_first'])
+@pytest.mark.parametrize('planner_mode', ['acc', 'blended'])
+def test_native_episode_lead_handover_then_same_cycle_loss_and_off(monkeypatch, tmp_path, order, planner_mode):
+  from openpilot.selfdrive.carrot.tests.test_signal_off_release import native_episode, published_source, stop_output
+  # Once normal ACC follows the lead, both native/aux provenance belongs to
+  # the old stop episode. After lead loss+OFF, the real native FSM must match
+  # the same ordinary lead-to-model transition with the auxiliary mode OFF.
+  traces = []
+  for source in (published_source(), None):
+    with monkeypatch.context() as patch:
+      run = native_episode(patch, tmp_path, order, planner_mode, source)
+      active_acc(run.sm)
+      run.sm['radarState'].leadOne = NS(status=True, dRel=4., vLead=2.)
+      if source is not None:
+        run.selection[0] = 0  # baseline normal native lead handover, no auxiliary veto
+      run.tick(elapsed=.6)
+      assert run.p.xState.name == 'lead' and run.p.stop_dist == 1000.
+      if source is None:
+        assert run.runtime.guard.hold and not run.p.start_decision.hold
+        assert not run.p._signal_stop_owned and not run.p._signal_stop_native
+      run.sm['radarState'].leadOne.status = False
+      run.selection[0] = 0
+      trace = []
+      for _ in range(3):
+        trace.append(stop_output(run, run.tick(elapsed=.6)))
+        assert not run.runtime.guard.hold
+      traces.append(trace)
+  assert traces[0] == traces[1]
