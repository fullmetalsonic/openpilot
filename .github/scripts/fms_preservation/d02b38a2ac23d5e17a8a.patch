+  def _observe_control_cache(self, sm):
+    observer = getattr(self, "_consumer_observer", None)
+    if observer is None:
+      return
+    try:
+      from openpilot.selfdrive.carrot.control_advisor.consumer_observer import field, observe
+    except Exception:
+      self._consumer_observer = None
