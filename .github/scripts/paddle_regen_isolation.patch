+def input_batch(parser, packer, ticks, sequence):
+  packets = [(timestamp, [packer.make_can_msg("CRUISE_BUTTONS", 0, dict(LEFT_PADDLE=l, RIGHT_PADDLE=r, CRUISE_BUTTONS=c))])
+             for timestamp, l, r, c in ticks]
