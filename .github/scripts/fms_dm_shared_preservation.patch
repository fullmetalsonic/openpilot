+      settings_dir, _, evidence_root = self._paths
+      evidence_root.mkdir(parents=True, exist_ok=True)
+      lease = _RootLease(evidence_root)
+      with self._lock:
+        self._root_lease = lease
+      _root_budget(evidence_root)
