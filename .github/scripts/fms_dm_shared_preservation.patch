+def test_new_stopped_red_needs_new_confirmation_after_departure():
+  g = held()
+  assert not step(g, .7, speed=21.25).hold
+  assert not step(g, 1.05, 'unknown').hold
+  assert not step(g, 1.4, 'red').hold
+  assert step(g, 1.75, 'red').hold
