+    try:
+      self._checkpoints.get_nowait()
+    except queue.Empty:
+      pass
+    self._checkpoints.put_nowait({"checkpoint": token, "archive_watermark": self._archive_watermark})
+    self._last_checkpoint_sequence = token["sequence"]
