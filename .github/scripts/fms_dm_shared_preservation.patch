+  )
+  if err_evidence:
+    paths_valid = False
+    blockers_collection.extend(err_evidence)
+  elif can_evidence is None:
+    blockers_collection.append("evidence_root_missing")
+
+  can_candidates, res_candidates, err_candidates = _validate_directory(
