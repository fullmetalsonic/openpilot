+"""Bounded, side-effect-free diagnostics for explicitly normalized observations.
+
+The caller owns the original logs, normalization, settings-epoch evidence and
+profile qualification. These statistics are not parameter recommendations.
+"""
+
+from bisect import bisect_right
+from dataclasses import dataclass, field
+import math
+from numbers import Real
+from typing import Iterable
+
+
+AXES = ("lateral", "longitudinal")
+
+
+@dataclass(frozen=True)
+class Observation:
+  mono_ns: int
+  axis: str
+  target: float | None
+  actual: float | None
+  active: bool
+  valid: bool
+  driver_override: bool | None
+  recovery_ready: bool
+  epoch: str
+  context: dict = field(default_factory=dict)
+
+
+@dataclass(frozen=True)
+class AnalysisProfile:
+  profile_id: str
+  pre_margin_ns: int
+  recovery_ns: int
+  max_gap_ns: int
+  dependency_ns: int
+  max_samples: int = 100_000
+
+  def __post_init__(self):
+    if not isinstance(self.profile_id, str) or not self.profile_id.strip():
+      raise ValueError("profile_id must be a nonempty string")
+    for name in ("pre_margin_ns", "recovery_ns", "max_gap_ns", "dependency_ns", "max_samples"):
+      value = getattr(self, name)
+      if type(value) is not int or value < 0:
+        raise ValueError(f"{name} must be a nonnegative integer")
+    if self.max_gap_ns == 0 or self.max_samples == 0:
+      raise ValueError("max_gap_ns and max_samples must be positive")
+
+
+def _validate_observation(item):
+  if not isinstance(item, Observation):
+    raise ValueError("input must contain Observation instances")
+  if type(item.mono_ns) is not int or item.mono_ns < 0:
+    raise ValueError("mono_ns must be a nonnegative integer")
+  if item.axis not in AXES:
+    raise ValueError("axis must be lateral or longitudinal")
+  if not isinstance(item.epoch, str) or not item.epoch.strip():
+    raise ValueError("epoch must be a nonempty string")
+  if not isinstance(item.context, dict):
+    raise ValueError("context must be a dictionary")
+  for name in ("saturated", "output_limited"):
+    value = item.context.get(name)
+    if value is not None and type(value) is not bool:
+      raise ValueError(f"context {name} must be boolean or None")
+  for name in ("active", "valid", "recovery_ready"):
+    if type(getattr(item, name)) is not bool:
+      raise ValueError(f"{name} must be boolean")
+  if item.driver_override is not None and type(item.driver_override) is not bool:
+    raise ValueError("driver_override must be boolean or None")
+  for name in ("target", "actual"):
+    value = getattr(item, name)
+    if value is not None and (isinstance(value, bool) or not isinstance(value, Real)):
+      raise ValueError(f"{name} must be numeric or None")
+
+
+def _error(item):
+  if item.target is None or item.actual is None:
+    return None, "measurement_missing"
+  try:
+    target, actual = float(item.target), float(item.actual)
+  except (OverflowError, ValueError) as exc:
+    raise ValueError("measurement cannot be represented as a finite float") from exc
+  if not math.isfinite(target) or not math.isfinite(actual):
+    return None, "measurement_nonfinite"
+  error = actual - target
+  if not math.isfinite(error):
+    raise ValueError("finite measurement difference overflowed")
+  return error, None
+
+
+def _metrics(errors):
+  count = len(errors)
+  if not count:
+    return {"count": 0, "bias": None, "rmse": None, "p95_absolute_error": None}
+  scale = max(abs(error) for error in errors)
+  if scale:
+    bias = scale * (math.fsum(error / scale for error in errors) / count)
+    rmse = scale * math.sqrt(math.fsum((error / scale) ** 2 for error in errors) / count)
+  else:
+    bias = rmse = 0.0
+  p95 = sorted(abs(error) for error in errors)[math.ceil(count * 0.95) - 1]
+  return {"count": count, "bias": bias, "rmse": rmse, "p95_absolute_error": p95}
+
+
+def _merge_intervals(intervals):
+  """Merge half-open intervals; integer timestamps let points use [t, t+1)."""
+  merged = []
+  for start, end in sorted(intervals):
+    if merged and start <= merged[-1][1]:
+      merged[-1] = (merged[-1][0], max(end, merged[-1][1]))
+    else:
+      merged.append((start, end))
+  return merged
+
+
+def _mask_axis(rows, profile):
+  reasons = [set() for _ in rows]
+  stable_since = None
+  previous = None
+  pre_intervals = []
+  gaps = []
+  epoch_starts = []
+  epoch_start = rows[0].mono_ns
+  for index, item in enumerate(rows):
+    current = reasons[index]
+    if previous is None or item.epoch != previous.epoch:
+      stable_since = None
+      epoch_start = item.mono_ns
+    epoch_starts.append(epoch_start)
+    if previous is not None and item.mono_ns - previous.mono_ns > profile.max_gap_ns:
+      current.add("signal_gap")
+      gaps.append((previous.mono_ns + 1, item.mono_ns + 1))
+    if not item.active:
+      current.add("control_inactive")
+    if not item.valid:
+      current.add("invalid_signal")
+    if not item.recovery_ready:
+      current.add("recovery_not_ready")
+    if item.context.get("saturated") is True or item.context.get("output_limited") is True:
+      current.add("output_limited")
+    if item.driver_override is None:
+      current.add("intervention_unknown")
+    elif item.driver_override:
+      current.add("driver_intervention")
+      pre_intervals.append((max(0, item.mono_ns - profile.pre_margin_ns), item.mono_ns + 1))
+    _, measurement_reason = _error(item)
+    if measurement_reason:
+      current.add(measurement_reason)
+    if current:
+      stable_since = None
+    else:
+      if stable_since is None:
+        stable_since = item.mono_ns
+      if item.mono_ns - stable_since < profile.recovery_ns:
+        current.add("recovery")
+    previous = item
+
+  merged_pre = _merge_intervals(pre_intervals)
+  pre_starts = [interval[0] for interval in merged_pre]
+  for index, item in enumerate(rows):
+    position = bisect_right(pre_starts, item.mono_ns) - 1
+    if position >= 0 and item.mono_ns < merged_pre[position][1] and item.driver_override is not True:
+      reasons[index].add("intervention_pre_margin")
+
+  # A bad observed state remains uncertain until the next observation. Derived
+  # dependency exclusions must not recursively extend this base uncertainty.
+  unsafe = list(gaps)
+  for index, item in enumerate(rows):
+    if reasons[index]:
+      end = rows[index + 1].mono_ns if index + 1 < len(rows) else item.mono_ns + 1
+      unsafe.append((item.mono_ns, end))
+  merged_unsafe = _merge_intervals(unsafe)
+  unsafe_starts = [interval[0] for interval in merged_unsafe]
+  if profile.dependency_ns:
+    for index, item in enumerate(rows):
+      if reasons[index]:
+        continue
+      window_start = item.mono_ns - profile.dependency_ns
+      if window_start < epoch_starts[index]:
+        reasons[index].add("dependency_unobserved")
+      position = bisect_right(unsafe_starts, item.mono_ns) - 1
+      if position >= 0 and merged_unsafe[position][1] > window_start:
+        reasons[index].add("dependency_window")
+  return reasons
+
+
+def _summarize_epoch(records, boundary, max_gap_ns):
+  raw_errors, eligible_errors = [], []
+  provisional = excluded = 0
+  observed_duration = eligible_duration = 0
+  limit_observation = {"saturated_known_count": 0, "output_limited_known_count": 0,
+                       "fully_known_count": 0, "unknown_count": 0, "limited_count": 0}
+  intervals = []
+  active_intervals = {}
+  previous, previous_eligible = None, False
+  for item, reasons in records:
+    saturated_known = type(item.context.get("saturated")) is bool
+    limited_known = type(item.context.get("output_limited")) is bool
+    limit_observation["saturated_known_count"] += saturated_known
+    limit_observation["output_limited_known_count"] += limited_known
+    limit_observation["fully_known_count"] += saturated_known and limited_known
+    limit_observation["unknown_count"] += not (saturated_known and limited_known)
+    limit_observation["limited_count"] += item.context.get("saturated") is True or item.context.get("output_limited") is True
+    eligible = item.mono_ns <= boundary and not reasons
+    if previous is not None:
+      elapsed = item.mono_ns - previous.mono_ns
+      if elapsed <= max_gap_ns:
+        observed_duration += elapsed
+        if eligible and previous_eligible:
+          eligible_duration += elapsed
+    error, _ = _error(item)
+    if error is not None:
+      raw_errors.append(error)
+    if item.mono_ns > boundary:
+      provisional += 1
+      current_reasons = set()
+    elif reasons:
+      excluded += 1
+      current_reasons = reasons
+    else:
+      eligible_errors.append(error)
+      current_reasons = set()
+    for reason in list(active_intervals):
+      if reason not in current_reasons:
+        intervals.append(active_intervals.pop(reason))
+    for reason in sorted(current_reasons):
+      if reason not in active_intervals:
+        active_intervals[reason] = {"reason": reason, "start_ns": item.mono_ns,
+                                    "end_ns": item.mono_ns, "sample_count": 0}
+      active_intervals[reason]["end_ns"] = item.mono_ns
+      active_intervals[reason]["sample_count"] += 1
+    previous, previous_eligible = item, eligible
+  intervals.extend(active_intervals.values())
+  intervals.sort(key=lambda entry: (entry["start_ns"], entry["reason"]))
+  return {
+    "raw_metrics": _metrics(raw_errors),
+    "eligible_metrics": _metrics(eligible_errors),
+    "sample_count": len(records),
+    "eligible_count": len(eligible_errors),
+    "excluded_count": excluded,
+    "provisional_count": provisional,
+    "observed_duration_ns": observed_duration,
+    "eligible_duration_ns": eligible_duration,
+    "output_limit_observation": limit_observation,
+    "scope_limitations": ["output_limit_state_unknown"] if limit_observation["unknown_count"] else [],
+    "exclusions": intervals,
+  }
+
+
+def analyze(observations: Iterable[Observation], profile: AnalysisProfile,
+            finalized_through_ns: int | None = None) -> dict:
+  """Analyze bounded monotonic inputs without assuming the tail is finalized.
+
+  Exclusion interval endpoints are inclusive timestamps of consecutive observed
+  samples with a reason, not interpolated claims about unobserved measurements.
+  Raw metrics cover finite measurements including excluded/provisional samples.
+  The caller must provide a new epoch ID for each settings/code/model event.
+  """
+  if not isinstance(profile, AnalysisProfile):
+    raise ValueError("profile must be an AnalysisProfile")
+  if finalized_through_ns is not None and (type(finalized_through_ns) is not int or finalized_through_ns < 0):
+    raise ValueError("finalized_through_ns must be a nonnegative integer or None")
+  axis_rows = {axis: [] for axis in AXES}
+  closed_epochs = {axis: set() for axis in AXES}
+  count = 0
+  for item in observations:
+    if count >= profile.max_samples:
+      raise ValueError("max_samples exceeded; input was not silently truncated")
+    _validate_observation(item)
+    rows = axis_rows[item.axis]
+    if rows:
+      previous = rows[-1]
+      if item.mono_ns <= previous.mono_ns:
+        raise ValueError("mono_ns must strictly increase per axis")
+      if item.epoch != previous.epoch:
+        closed_epochs[item.axis].add(previous.epoch)
+        if item.epoch in closed_epochs[item.axis]:
+          raise ValueError("a closed epoch ID cannot reappear on the same axis")
+    rows.append(item)
+    count += 1
+  safe_ends = [rows[-1].mono_ns - profile.pre_margin_ns - profile.dependency_ns
+               for rows in axis_rows.values() if rows]
+  safe_end = max(-1, min(safe_ends)) if safe_ends else None
+  if finalized_through_ns is not None and (safe_end is None or finalized_through_ns > safe_end):
+    raise ValueError("finalized_through_ns exceeds the observed safe boundary")
+  boundary = finalized_through_ns if finalized_through_ns is not None else safe_end
+  result = {"schema_version": 1, "profile_id": profile.profile_id,
+            "finalized_through_ns": boundary,
+            "raw_metrics_scope": "all_finite_measurements_including_excluded_and_provisional",
+            "eligible_metrics_scope": "finalized_state_and_dependency_eligible",
+            "exclusion_interval_semantics": "consecutive_observed_samples_inclusive_endpoints",
+            "axes": {}}
+  for axis, rows in axis_rows.items():
+    if not rows:
+      continue
+    reasons = _mask_axis(rows, profile)
+    epochs = {}
+    for item, item_reasons in zip(rows, reasons):
+      epochs.setdefault(item.epoch, []).append((item, item_reasons))
+    result["axes"][axis] = {"epochs": {epoch: _summarize_epoch(records, boundary, profile.max_gap_ns)
+                                        for epoch, records in epochs.items()}}
+  return result
diff --git a/openpilot/selfdrive/carrot/control_advisor/analysis_control.py b/openpilot/selfdrive/carrot/control_advisor/analysis_control.py
--- /dev/null
+++ b/openpilot/selfdrive/carrot/control_advisor/analysis_control.py
@@ -0,0 +1,182 @@
+"""Bounded explicit analysis intents; recording observations never run a model."""
+from collections import OrderedDict
+from copy import deepcopy
+import re
+
+
+STATES = {"recording", "queued", "running", "waiting_for_tail", "ready", "failed", "incomplete"}
+
+
+def initial_control():
+  return {"schema_version": 1, "mode": "manual_or_park", "scope": "trip_since_apply", "state": "recording",
+          "request_id": None, "trigger": None, "range_start_ns": None, "range_end_ns": None, "apply_cut_ns": None,
+          "progress": {"completed_sources": 0, "total_sources": 0}, "reason_codes": ["trip_observation_required"], "can_analyze": False}
+
+
+def validate_control(value):
+  expected = initial_control()
+  if type(value) is not dict or set(value) != set(expected) or value["schema_version"] != 1 or value["mode"] != expected["mode"] or value["scope"] != expected["scope"] or value["state"] not in STATES:
+    raise ValueError("invalid_analysis_control")
+  for key in ("range_start_ns", "range_end_ns", "apply_cut_ns"):
+    stamp = value[key]
+    if stamp is not None and (type(stamp) is not str or re.fullmatch(r"0|[1-9][0-9]{0,18}", stamp) is None or int(stamp) > 2**63 - 1):
+      raise ValueError("invalid_analysis_control_time")
+  if (value["request_id"] is not None and (type(value["request_id"]) is not str or re.fullmatch(r"[A-Za-z0-9_-]{1,80}", value["request_id"]) is None)
+      or value["trigger"] not in {None, "manual", "park"} or type(value["can_analyze"]) is not bool):
+    raise ValueError("invalid_analysis_control_request")
+  if type(value["progress"]) is not dict or set(value["progress"]) != {"completed_sources", "total_sources"} or any(type(n) is not int or not 0 <= n <= 128 for n in value["progress"].values()):
+    raise ValueError("invalid_analysis_control_progress")
+  if type(value["reason_codes"]) is not list or len(value["reason_codes"]) > 16 or any(type(reason) is not str or re.fullmatch(r"[a-z0-9_]{1,128}", reason) is None for reason in value["reason_codes"]):
+    raise ValueError("invalid_analysis_control_reasons")
+  return deepcopy(value)
+
+
+def validate_binding(value):
+  if (type(value) is not dict or set(value) != {"trip_binding", "cut_revision"}
+      or type(value["cut_revision"]) is not int or value["cut_revision"] < 0
+      or type(value["trip_binding"]) is not dict or set(value["trip_binding"]) != {"vehicle_id", "boot_id", "route"}
+      or any(type(item) is not str or not 1 <= len(item) <= 256 for item in value["trip_binding"].values())):
+    raise ValueError("invalid_analysis_binding")
+  return deepcopy(value)
+
+
+class AnalysisControl:
+  """Owned by the recorder lock; at most one active and one latest intent."""
+  def __init__(self, session_id, boot_id, *, profile_sha256, objectives_sha256):
+    self.session_id, self.boot_id = session_id, boot_id
+    self.profile_hash, self.objective_hash = profile_sha256, objectives_sha256
+    self.goal_id = None
+    self.trip = self.start_ns = self.end_ns = self.cut_ns = None
+    self.binding_valid = False
+    self.cut_revision = 0
+    self.active = self.pending = None
+    self.seen = OrderedDict()
+    self.armed = False
+    self.park_seen = False
+    self.revision = 0
+    self.public = initial_control()
+
+  def observe(self, stamp, route, identity, parking, nonpark_ns=None):
+    self.binding_valid = False
+    if type(stamp) is not int or stamp < 0:
+      self.public.update(can_analyze=False, reason_codes=["analysis_source_stale"])
+      self.armed = False
+      return
+    vehicle = identity.get("physical_group_id") if type(identity) is dict and identity.get("state") == "observed" else None
+    if not vehicle or not self.boot_id or not route or route.get("state") != "observed":
+      self.public.update(can_analyze=False, reason_codes=["trip_observation_required"])
+      return
+    trip = {"vehicle_id": vehicle, "boot_id": self.boot_id, "route": route["route"]}
+    self.binding_valid = True
+    if trip != self.trip:
+      self.trip, self.start_ns, self.end_ns = trip, stamp, stamp
+      self.cut_ns, self.cut_revision = None, 0
+      self.armed = self.park_seen = False
+      self.pending = None
+      self.public = initial_control()
+      self.revision += 1
+    self.end_ns = max(self.end_ns, stamp)
+    self.public["can_analyze"] = self.end_ns > max(self.start_ns, self.cut_ns or 0)
+    if self.public["state"] == "recording":
+      self.public["reason_codes"] = []
+    state = parking.get("state") if parking.get("source_kind") == "native_event" else "unknown"
+    # Unknown never arms or creates an edge. A confirmed P consumes the armed
+    # edge, so stale->P cannot repeat it. Moving observations rearm explicitly.
+    if state == "moving" or type(nonpark_ns) is int and 0 <= stamp - nonpark_ns <= 250_000_000:
+      self.armed, self.park_seen = True, False
+    elif state == "unknown":
+      self.armed = False
+    elif state == "park_observed" and self.armed and not self.park_seen:
+      self.armed, self.park_seen = False, True
+      self.request("park_" + str(parking["observed_mono_ns"]), "park")
+
+  def request(self, request_id, trigger="manual"):
+    if type(request_id) is not str or re.fullmatch(r"[A-Za-z0-9_-]{1,80}", request_id) is None or trigger not in {"manual", "park"}:
+      raise ValueError("invalid_analysis_request")
+    if request_id in self.seen:
+      previous = self.seen[request_id]
+      if previous["profile_sha256"] != self.profile_hash or previous["objectives_sha256"] != self.objective_hash:
+        raise ValueError("analysis_request_id_conflict")
+      if (self.active is None and self.public["state"] in {"failed", "incomplete"}
+          and self.public["request_id"] == request_id and previous["trip_binding"] == self.trip
+          and previous["cut_revision"] == self.cut_revision):
+        self.pending = deepcopy(previous)
+        self._show(previous, "queued")
+        self.revision += 1
+        return True
+      return False
+    if len(self.seen) >= 128:
+      raise ValueError("analysis_request_budget")
+    if not self.public["can_analyze"]:
+      raise ValueError("analysis_trip_not_ready")
+    intent = {"schema_version": 1, "session_id": self.session_id, "request_id": request_id, "trigger": trigger,
+              "range_start_ns": max(self.start_ns, self.cut_ns or 0), "requested_end_ns": self.end_ns,
+              "cut_revision": self.cut_revision, "trip_binding": deepcopy(self.trip),
+              "profile_sha256": self.profile_hash, "objectives_sha256": self.objective_hash}
+    if self.goal_id is not None:
+      intent["goal_id"] = self.goal_id
+    self.seen[request_id] = deepcopy(intent)
+    self.pending = intent
+    if self.active is None:
+      self._show(intent, "queued")
+    self.revision += 1
+    return True
+
+  def change_goal(self, profile_sha256, objectives_sha256, goal_id):
+    self.profile_hash, self.objective_hash, self.goal_id = profile_sha256, objectives_sha256, goal_id
+    self.active = self.pending = None
+    self.public.update(state="recording", request_id=None, trigger=None, reason_codes=["analysis_goal_changed"])
+    self.revision += 1
+
+  def _show(self, intent, state, reason=None):
+    self.public.update(state=state, request_id=intent["request_id"], trigger=intent["trigger"],
+                       range_start_ns=str(intent["range_start_ns"]), range_end_ns=str(intent["requested_end_ns"]),
+                       apply_cut_ns=None if self.cut_ns is None else str(self.cut_ns), reason_codes=[] if reason is None else [reason])
+
+  def take(self):
+    if self.active is None and self.pending is not None:
+      self.active, self.pending = self.pending, None
+      self._show(self.active, "queued")
+      self.revision += 1
+      return deepcopy(self.active)
+    return None
+
+  def update(self, status):
+    if self.active is None:
+      return
+    state = {"waiting": "waiting_for_tail", "running": "running", "ready": "ready", "partial": "incomplete", "failed": "failed", "stopped": "incomplete"}.get(status["state"], "queued")
+    if status.get("reason") == "analysis_continuation":
+      state = "running"
+    self._show(self.active, state, status.get("reason"))
+    attempt = status.get("attempt") or {}
+    self.public["progress"] = {"completed_sources": attempt.get("processed_windows", 0), "total_sources": attempt.get("source_count", 0)}
+    if state == "ready":
+      self.public["progress"]["completed_sources"] = attempt.get("source_count", 0)
+    if state in {"ready", "failed", "incomplete"}:
+      self.active = None
+      self.revision += 1
+
+  def apply_receipt(self, receipt, trip_binding, *, observed_now_ns=None):
+    # Receipts arrive only after native durable CAS/readback. Registration and
+    # restoration never call this path. A receipt for an earlier trip is inert.
+    stamp, revision = receipt.get("stored_mono_ns"), receipt.get("revision")
+    if (self.trip is None or any(self.trip.get(key) != value for key, value in trip_binding.items())
+        or not {"vehicle_id", "boot_id"} <= set(trip_binding) or type(stamp) is not int or type(revision) is not int
+        or self.start_ns is None or not self.start_ns <= stamp <= (self.end_ns if observed_now_ns is None else observed_now_ns)
+        or stamp <= (self.cut_ns or 0) or revision <= self.cut_revision):
+      return False
+    self.cut_ns, self.cut_revision = stamp, revision
+    self.active = self.pending = None
+    self.public.update(state="recording", apply_cut_ns=str(stamp), can_analyze=False, reason_codes=["recording_since_successful_apply"])
+    self.revision += 1
+    return True
+
+  def durable(self):
+    return {"schema_version": 1, "session_id": self.session_id, "trip_binding": deepcopy(self.trip),
+            "state": self.public["state"], "profile_sha256": self.profile_hash,
+            "objectives_sha256": self.objective_hash, "goal_id": self.goal_id,
+            "range_start_ns": self.start_ns, "range_end_ns": self.end_ns, "cut_ns": self.cut_ns, "cut_revision": self.cut_revision,
+            "active": deepcopy(self.active), "pending": deepcopy(self.pending), "requests": list(self.seen.values())}
+
+  def snapshot(self):
+    return validate_control(self.public)
diff --git a/openpilot/selfdrive/carrot/control_advisor/apply_requests.py b/openpilot/selfdrive/carrot/control_advisor/apply_requests.py
--- /dev/null
+++ b/openpilot/selfdrive/carrot/control_advisor/apply_requests.py
@@ -0,0 +1,776 @@
+"""Durable requests with explicitly injected PC or guarded native storage.
+
+Usage: IsolatedPCStore(root, target_id, initial_values).request_binding() feeds
+the trusted evidence resolver. ApplyRequestController(..., enabled=True,
+pc_store=store).register(body) only registers; execute(request_id) performs a
+single PC CAS. A separate consumer/comparison provider may advance review().
+No Params construction, automatic retry, or consumer application ACK exists.
+All public methods may perform bounded disk/resolver I/O: call off the UI loop.
+"""
+from copy import deepcopy
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import threading
+import time
+from types import SimpleNamespace
+import uuid
+
+from .candidate_report import _read
+from .evidence import _sync_directory
+from .registry import load_registry
+
+
+KEYS = frozenset(item["key"] for item in load_registry()["items"])
+BODY_FIELDS = {"request_id", "target_id", "session_id", "artifact_sha256", "result_revision", "item_key",
+               "expected_current_raw", "expected_settings_revision", "dependency_digest"}
+STATES = {"registered", "held", "intent", "stored", "consumer_observed", "comparison_ready", "cancelled", "expired", "rejected", "indeterminate"}
+_ID = re.compile(r"^[A-Za-z0-9_.-]{1,128}$")
+_SHA = re.compile(r"^[0-9a-f]{64}$")
+_ZERO = "0" * 64
+
+
+class RequestConflict(ValueError):
+  pass
+
+
+class RequestDisabled(ValueError):
+  pass
+
+
+class RequestNotFound(LookupError):
+  pass
+
+
+def _canonical(value):
+  return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+
+
+def _hash(value):
+  return hashlib.sha256(_canonical(value)).hexdigest()
+
+
+def _integer(value, minimum=0, maximum=2**63 - 1):
+  if type(value) is not int or not minimum <= value <= maximum:
+    raise ValueError("invalid_request_integer")
+
+
+def _identifier(value):
+  if type(value) is not str or _ID.fullmatch(value) is None:
+    raise ValueError("invalid_request_identifier")
+
+
+def _sha(value):
+  if type(value) is not str or _SHA.fullmatch(value) is None:
+    raise ValueError("invalid_request_hash")
+
+
+def _fields(value, required):
+  if type(value) is not dict or set(value) != set(required):
+    raise ValueError("invalid_request_fields")
+
+
+def validate_request(body):
+  trial = type(body) is dict and body.get("purpose") == "manual_trial"
+  _fields(body, BODY_FIELDS | {"purpose", "trial_id"} if trial else BODY_FIELDS)
+  if trial:
+    if body["item_key"] not in {"SteerActuatorDelay", "LatSmoothSec", "LongActuatorDelay"}:
+      raise ValueError("manual_trial_parameter_invalid")
+    _sha(body["trial_id"])
+  for name in ("request_id", "target_id", "session_id"):
+    _identifier(body[name])
+  if body["item_key"] not in KEYS:
+    raise ValueError("unknown_request_parameter")
+  for name in ("artifact_sha256", "dependency_digest"):
+    _sha(body[name])
+  for name in ("result_revision", "expected_settings_revision"):
+    _integer(body[name])
+  if body["expected_current_raw"] is not None:
+    _integer(body["expected_current_raw"], -1000000, 1000000)
+  return deepcopy(body)
+
+
+def validate_request_status(value):
+  fields = {"request_id", "target_id", "session_id", "artifact_sha256", "result_revision", "item_key", "scope", "state", "reason",
+            "created_ns", "expires_at_ns", "current_raw", "candidate_raw", "settings_revision", "store_receipt", "consumer_observed",
+            "comparison_ready", "comparison", "request_registration_enabled", "pc_simulation_enabled", "recommendations_enabled", "apply_enabled", "device_qualified"}
+  trial = type(value) is dict and value.get("purpose") == "manual_trial"
+  _fields(value, fields | {"purpose", "trial_id"} if trial else fields)
+  if trial:
+    if value["item_key"] not in {"SteerActuatorDelay", "LatSmoothSec", "LongActuatorDelay"}:
+      raise ValueError("manual_trial_parameter_invalid")
+    _sha(value["trial_id"])
+  for key in ("request_id", "target_id", "session_id"):
+    _identifier(value[key])
+  _sha(value["artifact_sha256"])
+  if value["item_key"] not in KEYS or value["scope"] not in {"vehicle", "pc_simulation"} or value["state"] not in STATES:
+    raise ValueError("invalid_request_status")
+  if value["reason"] is not None:
+    _identifier(value["reason"])
+  for key in ("created_ns", "expires_at_ns", "settings_revision", "result_revision"):
+    _integer(value[key])
+  for key in ("current_raw", "candidate_raw"):
+    if key != "current_raw" or value[key] is not None:
+      _integer(value[key], -1000000, 1000000)
+  for key in ("consumer_observed", "comparison_ready", "request_registration_enabled", "pc_simulation_enabled"):
+    if type(value[key]) is not bool:
+      raise ValueError("invalid_request_status_boolean")
+  if any(value[key] is not False for key in ("recommendations_enabled", "device_qualified")) or type(value["apply_enabled"]) is not bool:
+    raise ValueError("request_qualification_claim")
+  if value["consumer_observed"] != (value["state"] in {"consumer_observed", "comparison_ready"}) or value["comparison_ready"] != (value["state"] == "comparison_ready"):
+    raise ValueError("request_observation_state_mismatch")
+  if value["apply_enabled"] and (value["scope"] != "vehicle" or not value["request_registration_enabled"] or value["state"] != "registered"):
+    raise ValueError("request_apply_readiness_invalid")
+  if value["state"] == "held" and value["store_receipt"] is not None:
+    raise ValueError("held_request_has_receipt")
+  if value["store_receipt"] is not None:
+    receipt = value["store_receipt"]
+    _fields(receipt, {"request_id", "revision", "value"})
+    if receipt["request_id"] != value["request_id"] or receipt["value"] != value["candidate_raw"]:
+      raise ValueError("request_receipt_mismatch")
+    _integer(receipt["revision"], 1)
+  if value["comparison"] is not None:
+    from .comparison import validate_public_comparison
+    validate_public_comparison(value["comparison"])
+  if len(_canonical(value)) > 96 * 1024:
+    raise ValueError("request_public_status_budget")
+  return deepcopy(value)
+
+
+def _values(values):
+  if type(values) is not dict or set(values) - KEYS:
+    raise ValueError("invalid_pc_values")
+  for value in values.values():
+    if value is not None:
+      _integer(value, -1000000, 1000000)
+  return deepcopy(values)
+
+
+def _atomic(path, value):
+  if path.is_symlink():
+    raise ValueError("request_file_link")
+  temporary = path.with_name(path.name + "." + uuid.uuid4().hex + ".partial")
+  with temporary.open("xb") as stream:
+    stream.write(_canonical(value))
+    stream.flush()
+    os.fsync(stream.fileno())
+  os.replace(temporary, path)
+  _sync_directory(path.parent)
+
+
+def _root(path, marker):
+  path = Path(path)
+  if not path.is_absolute() or any(part.is_symlink() or (hasattr(part, "is_junction") and part.is_junction()) for part in (path, *path.parents)):
+    raise ValueError("request_root_requires_absolute_unlinked_directory")
+  path.mkdir(mode=0o700, parents=False, exist_ok=True)
+  marker_path = path / "owner.json"
+  if marker_path.exists():
+    if _read(marker_path, 1024)[0] != marker:
+      raise ValueError("request_root_not_owned")
+  elif any(path.iterdir()):
+    raise ValueError("request_root_not_empty")
+  from .recording import _RootLease
+  lease = _RootLease(path)
+  try:
+    if not marker_path.exists():
+      _atomic(marker_path, marker)
+    return path, lease
+  except BaseException:
+    lease.close()
+    raise
+
+
+class IsolatedPCStore:
+  """A fake file namespace, with durable atomic values/revision/request receipt."""
+  scope = "pc_simulation"
+
+  def __init__(self, root, target_id, initial_values, *, session_id=None, generation=0, clock_ns=time.monotonic_ns):
+    _identifier(target_id)
+    _integer(generation)
+    self.clock_ns, self._lock = clock_ns, threading.RLock()
+    self.root, self._lease = _root(root, {"schema_version": 1, "scope": "isolated_pc_simulation_store"})
+    self.path, self.target_id = self.root / "pc-store.json", target_id
+    self._closed = False
+    try:
+      if self.path.exists():
+        self._state, _ = _read(self.path, 256 * 1024)
+        _fields(self._state, {"schema_version", "target_id", "store_id", "session_id", "generation", "revision", "values", "receipts"})
+        if self._state["schema_version"] != 1 or self._state["target_id"] != target_id:
+          raise ValueError("pc_store_identity_mismatch")
+        _values(self._state["values"])
+        _integer(self._state["revision"])
+        if type(self._state["receipts"]) is not dict or len(self._state["receipts"]) > 128:
+          raise ValueError("pc_store_receipt_budget")
+      else:
+        values = {key: None for key in KEYS}
+        values.update(_values(initial_values))
+        self._state = {"schema_version": 1, "target_id": target_id, "store_id": uuid.uuid4().hex,
+                       "session_id": session_id or uuid.uuid4().hex, "generation": generation, "revision": 0,
+                       "values": values, "receipts": {}}
+        _identifier(self._state["session_id"])
+        _atomic(self.path, self._state)
+    except BaseException:
+      self._lease.close()
+      raise
+
+  def snapshot(self):
+    with self._lock:
+      if _read(self.path, 256 * 1024)[0] != self._state:
+        raise RequestConflict("pc_store_changed")
+      return {key: deepcopy(self._state[key]) for key in ("target_id", "store_id", "session_id", "generation", "revision", "values")}
+
+  def request_binding(self):
+    value = self.snapshot()
+    return {"session_id": value["session_id"], "generation": value["generation"], "source_mode": "pc_simulation", "state": "running",
+            "settings_revision": value["revision"], "settings_raw": value["values"], "observed_mono_ns": self.clock_ns(), "settings_observation_fresh": True}
+
+  def request_receipt(self, request_id):
+    with self._lock:
+      self.snapshot()
+      return deepcopy(self._state["receipts"].get(request_id))
+
+  def compare_and_swap(self, *, request_id, request_sha256, item_key, expected_current_raw, expected_settings_revision,
+                       expected_dependencies, dependency_digest, candidate_raw):
+    _identifier(request_id)
+    _sha(request_sha256)
+    _sha(dependency_digest)
+    _values(expected_dependencies)
+    if item_key not in KEYS:
+      raise ValueError("unknown_pc_parameter")
+    for value in (expected_current_raw, candidate_raw):
+      _integer(value, -1000000, 1000000)
+    _integer(expected_settings_revision)
+    with self._lock:
+      if self._closed:
+        raise RequestDisabled("pc_store_closed")
+      self.snapshot()
+      old = self._state["receipts"].get(request_id)
+      if old is not None:
+        if old["request_sha256"] != request_sha256:
+          raise RequestConflict("pc_request_id_conflict")
+        return deepcopy(old)
+      if len(self._state["receipts"]) >= 128:
+        raise RequestConflict("pc_store_receipt_budget")
+      if (self._state["revision"] != expected_settings_revision or self._state["values"].get(item_key) != expected_current_raw
+          or any(self._state["values"].get(key) != value for key, value in expected_dependencies.items())):
+        raise RequestConflict("compare_and_swap_conflict")
+      receipt = {"schema_version": 1, "request_id": request_id, "request_sha256": request_sha256, "target_id": self.target_id,
+                 "store_id": self._state["store_id"], "item_key": item_key, "previous_raw": expected_current_raw,
+                 "value": candidate_raw, "previous_revision": expected_settings_revision, "revision": expected_settings_revision + 1,
+                 "dependency_digest": dependency_digest, "stored_mono_ns": self.clock_ns()}
+      updated = deepcopy(self._state)
+      updated["values"][item_key], updated["revision"] = candidate_raw, receipt["revision"]
+      updated["receipts"][request_id] = receipt
+      _atomic(self.path, updated)
+      self._state = updated
+      return deepcopy(receipt)
+
+  def close(self):
+    with self._lock:
+      if not self._closed:
+        self._closed = True
+        self._lease.close()
+
+
+def _context(value):
+  required = {"target_id", "scope", "session_id", "session_generation", "artifact_sha256", "result_revision", "item_key", "current_raw", "candidate_raw",
+              "settings_revision", "dependencies", "dependency_digest", "pointer_token", "resolved_at_ns", "expires_at_ns", "provenance"}
+  _fields(value, required)
+  for name in ("target_id", "session_id"):
+    _identifier(value[name])
+  if value["scope"] not in {"vehicle", "pc_simulation"} or value["item_key"] not in KEYS:
+    raise ValueError("invalid_request_scope_or_key")
+  if value["scope"] == "pc_simulation" and value["current_raw"] is None:
+    raise ValueError("invalid_pc_current_raw")
+  for name in ("artifact_sha256", "dependency_digest", "pointer_token"):
+    _sha(value[name])
+  for name in ("session_generation", "result_revision", "settings_revision", "resolved_at_ns", "expires_at_ns"):
+    _integer(value[name])
+  for name in ("current_raw", "candidate_raw"):
+    if name != "current_raw" or value[name] is not None:
+      _integer(value[name], -1000000, 1000000)
+  _values(value["dependencies"])
+  if value["expires_at_ns"] < value["resolved_at_ns"] or value["candidate_raw"] == value["current_raw"]:
+    raise ValueError("invalid_request_candidate_or_expiry")
+  provenance = value["provenance"]
+  provenance_fields = {"evidence_sha256", "profile_sha256", "code_hashes", "source_epoch_id", "route", "boot_id", "settings_history_reference", "evidence_reference",
+                       "comparison_profile", "comparison_profile_sha256"}
+  identity_fields = {"identity_version", "vehicle_identity"}
+  if type(provenance) is not dict or set(provenance) - identity_fields != provenance_fields:
+    raise ValueError("invalid_request_fields")
+  if set(provenance) & identity_fields:
+    from .vehicle_identity import validate_identity
+    if not identity_fields <= set(provenance) or type(provenance["identity_version"]) is not int or provenance["identity_version"] != 1:
+      raise ValueError("request_vehicle_identity_invalid")
+    validate_identity(provenance["vehicle_identity"])
+  for name in ("evidence_sha256", "profile_sha256"):
+    _sha(provenance[name])
+  comparison_profile = provenance["comparison_profile"]
+  if comparison_profile is None:
+    if provenance["comparison_profile_sha256"] is not None:
+      raise ValueError("comparison_profile_binding_invalid")
+  else:
+    _sha(provenance["comparison_profile_sha256"])
+    if type(comparison_profile) is not dict or len(_canonical(comparison_profile)) > 16 * 1024 or _hash(comparison_profile) != provenance["comparison_profile_sha256"]:
+      raise ValueError("comparison_profile_binding_invalid")
+  # Analyzer and actual-consumer manifests together exceed 64 source files.
+  # Keep the path/digest checks and the overall 32 KiB context budget below.
+  if type(provenance["code_hashes"]) is not dict or not 1 <= len(provenance["code_hashes"]) <= 128:
+    raise ValueError("invalid_request_code_provenance")
+  for path, digest in provenance["code_hashes"].items():
+    if type(path) is not str or len(path) > 180 or ".." in path or "\\" in path:
+      raise ValueError("invalid_request_code_path")
+    _sha(digest)
+  if len(_canonical(value)) > 32 * 1024:
+    raise ValueError("request_context_budget")
+  return deepcopy(value)
+
