+def _physical(item, raw):
+  if raw is None or item["key"] in _CONTEXT_ONLY or raw in _MODE_SENTINELS.get(item["key"], set()) or (item["key"] == "CustomSR" and raw <= 10):
+    return None
+  return raw * item["raw_scale"]
