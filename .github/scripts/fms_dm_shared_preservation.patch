-         xEventGroupGetBits(wifi_events)&1 ? "true" : "false", IP2STR(&ip.ip), ap.rssi, ap.primary,
-         ap.bssid[0], ap.bssid[1], ap.bssid[2], ap.bssid[3], ap.bssid[4], ap.bssid[5],
