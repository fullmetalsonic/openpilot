+  del rows[10]
+  leases.observe(11, 2.)
+  leases.expire(4.)
+  assert rows[11][1] == [1, 2]
+  leases.expire(float('inf'))
+  assert writes[-1] == (11, [0, 0])
+  assert leases.entries == {}
