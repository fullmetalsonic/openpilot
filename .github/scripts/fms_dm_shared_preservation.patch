+        with patch("openpilot.selfdrive.carrot.control_advisor.archive.uuid.uuid4", return_value=SimpleNamespace(hex="2" * 32)):
+          last = self.append_segment(fixture, 2, 120_050_000_000, 180_000_000_000)
