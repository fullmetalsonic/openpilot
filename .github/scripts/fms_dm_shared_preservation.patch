+    config["Web"][host]["Handlers"]["/"]["Proxy"] = "http://127.0.0.1:9999"
+    tunnel.checked_at = 0
+    self.assertIn("연결 준비", tunnel.status())
+    config["Web"][host]["Handlers"]["/"]["Proxy"] = "http://127.0.0.1:8766"
