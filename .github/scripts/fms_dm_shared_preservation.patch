+      raise ValueError("snapshot_archive_receipt_conflict")
+    result[identity] = record
+  if not result:
+    raise ValueError("snapshot_no_committed_archive")
+  return result
+
+
+def _write(path, data):
+  with path.open("xb") as stream:
+    if stream.write(data) != len(data):
+      raise OSError("snapshot_short_write")
+    stream.flush()
+    os.fsync(stream.fileno())
+
+
+def _prefix_digest(path, size, *, destination=None, exact=False):
+  """Copy/hash one immutable prefix with bounded memory, allowing source append."""
+  path = _regular_file(path)
+  before = path.lstat()
+  if type(size) is not int or size < 0 or before.st_size < size or (exact and before.st_size != size):
+    raise ValueError("snapshot_prefix_size")
+  digest, remaining = hashlib.sha256(), size
+  with path.open("rb") as stream:
+    opened = os.fstat(stream.fileno())
+    if not stat.S_ISREG(opened.st_mode) or (before.st_dev, before.st_ino) != (opened.st_dev, opened.st_ino):
+      raise ValueError("snapshot_prefix_replaced")
+    output = destination.open("xb") if destination is not None else None
+    try:
+      while remaining:
+        data = stream.read(min(64 * 1024, remaining))
+        if not data:
+          raise ValueError("snapshot_prefix_truncated")
+        digest.update(data)
+        if output is not None and output.write(data) != len(data):
+          raise OSError("snapshot_short_write")
+        remaining -= len(data)
+      if output is not None:
+        output.flush()
+        os.fsync(output.fileno())
+    finally:
+      if output is not None:
+        output.close()
+    final = _regular_file(path).stat()
+    if (before.st_dev, before.st_ino) != (final.st_dev, final.st_ino) or final.st_size < size:
+      raise ValueError("snapshot_prefix_replaced")
+    if exact and _version(before) != _version(final):
+      raise ValueError("snapshot_prefix_changed")
+  return digest.hexdigest()
+
+
+def _selected_files(root, token, selection):
+  from .journal_segments import iter_verified_catalog
+  wanted = set(selection["segment_indices"])
+  catalog = token["catalog"]
+  result = [{"path": catalog["path"], "bytes": catalog["bytes"],
+             "sha256": _prefix_digest(root / catalog["path"], catalog["bytes"]), "copy_mode": "prefix"}]
+  for item in iter_verified_catalog(root, token):
+    if item["index"] in wanted:
+      result.append({"path": item["path"], "bytes": item["bytes"], "sha256": item["content_sha256"], "copy_mode": "prefix"})
+      wanted.remove(item["index"])
+  active = token["active"]
+  if active is not None and active["index"] in wanted:
+    result.append({"path": active["path"], "bytes": active["bytes"], "sha256": active["content_sha256"], "copy_mode": "prefix"})
+    wanted.remove(active["index"])
+  if wanted or sum(item["bytes"] for item in result) > WINDOW_MAX_BYTES:
+    raise ValueError("snapshot_selection_budget_or_missing_segment")
+  return result
+
+
+def _time_selected(items, limit):
+  if len(items) <= limit:
+    return items
+  return [items[index * (len(items) - 1) // (limit - 1)] for index in range(limit)]
+
+
+def select_pid_references(references, analysis_range, *, selection_version=3):
+  return _select_pid_references(references, analysis_range, selection_version)[0]
+
+
+def _select_pid_references(references, analysis_range, selection_version):
+  """Time-only complete bursts; sealed old snapshots retain their selection."""
+  if type(selection_version) is not int or selection_version not in (1, 2, 3):
+    raise ValueError("invalid_pid_selection_version")
+  if analysis_range is None:
+    return references, None
+  start, end = analysis_range["start_ns"], analysis_range["end_ns"]
+  if type(start) is not int or type(end) is not int or not 0 <= start <= end:
+    raise ValueError("invalid_pid_selection_range")
+  groups = {}
+  for reference in references:
+    groups.setdefault(reference["burst_id"], []).append(reference)
+  candidates = []
+  for burst_id, parts in groups.items():
+    parts.sort(key=lambda row: row["chunk_sequence"])
+    if ([row["chunk_sequence"] for row in parts] != list(range(len(parts))) or not parts[-1]["terminal"]
+        or any(row["terminal"] for row in parts[:-1]) or len({row["dependency_digest"] for row in parts}) != 1):
+      continue
+    lo, hi = min(row["mono_start_ns"] for row in parts), max(row["mono_end_ns"] for row in parts)
+    if max(row["frame_end"] for row in parts) - min(row["frame_start"] for row in parts) + 1 != 1000:
+      continue
+    candidates.append((lo, hi, burst_id, parts))
+  cuts = [start, start + (end - start) // 3, start + 2 * (end - start) // 3, end]
+  chosen, audit = [], []
+  limit = {1: 1, 2: 2, 3: 4}[selection_version]
+  for split, lo, hi in zip(("fit", "select", "holdout"), cuts, cuts[1:]):
+    eligible = sorted((row for row in candidates if lo + 2_100_000_000 <= row[0] and row[1] <= hi - 2_100_000_000), key=lambda row: (row[0], row[2]))
+    selected = eligible[:1] if limit == 1 else _time_selected(eligible, limit)
+    for item in selected:
+      chosen.extend(item[3])
+    audit.append({"split": split, "row_budget": limit * 1000, "max_bursts": limit, "eligible_count": len(eligible),
+      "selected_burst_ids": [item[2] for item in selected], "excluded_counts": {"time_budget": max(0, len(eligible) - len(selected))}})
+  return chosen, audit
+
+
+def _pin_pid_chunks(source, target, history, *, copy_files=False, analysis_range=None):
+  """Pin only payloads named by this verified prefix, with a separate budget."""
+  records = [entry["record"] for entry in history["records"] if entry["record"]["type"] == "pid_burst_chunk"]
+  if not records:
+    return None
+  from .pid_burst import MAX_ROUND_BYTES, load_chunk, validate_reference
+  references, rounds = {}, {}
+  for record in records:
+    reference = validate_reference(record["reference"])
+    previous = references.get(reference["path"])
+    if previous is not None:
+      if previous != reference:
+        raise ValueError("snapshot_pid_reference_conflict")
+      continue
+    references[reference["path"]] = reference
+    key = reference["path"].split("/")[1], reference["round_id"]
+    rounds[key] = rounds.get(key, 0) + reference["bytes"]
+    if rounds[key] > MAX_ROUND_BYTES:
+      raise ValueError("snapshot_pid_payload_budget")
+  all_references = [references[path] for path in sorted(references)]
+  # Sealed old snapshots retain their original one-burst selection contract.
+  version = 3
+  marker_path = target / "snapshot.json"
+  if marker_path.exists():
+    marker = _object(_read(marker_path, 64 * 1024))
+    policy = (marker.get("pid_burst_inventory") or {}).get("selection_policy")
+    version = {"complete_two_bursts_each_frozen_time_third_v2": 2,
+      "complete_four_bursts_each_frozen_time_third_v3": 3}.get(policy, 1)
+  selected, audit = _select_pid_references(all_references, analysis_range, version)
+  ordered = sorted(selected, key=lambda row: row["path"])
+  if len(ordered) > PID_SNAPSHOT_MAX_FILES or sum(item["bytes"] for item in ordered) > PID_SNAPSHOT_MAX_BYTES:
+    raise ValueError("snapshot_pid_payload_budget")
+  for reference in ordered:
+    load_chunk(source, reference)
+    destination = target / reference["path"]
+    if copy_files:
+      destination.parent.mkdir(parents=True, exist_ok=True)
+      if _prefix_digest(source / reference["path"], reference["bytes"], destination=destination, exact=True) != reference["sha256"]:
+        raise ValueError("snapshot_pid_source_changed")
+    load_chunk(target, reference)
+  inventory = {"file_count": len(ordered), "bytes": sum(item["bytes"] for item in ordered),
+               "sha256": hashlib.sha256(_canonical(ordered)).hexdigest()}
+  if analysis_range is not None:
+    policy = {1: "complete_burst_each_frozen_time_third_v1", 2: "complete_two_bursts_each_frozen_time_third_v2",
+      3: "complete_four_bursts_each_frozen_time_third_v3"}[version]
+    inventory.update(selection_policy=policy, selection_range=analysis_range,
+      burst_ids=sorted({row["burst_id"] for row in ordered}), original_reference_count=len(all_references),
+      original_reference_sha256=hashlib.sha256(_canonical(all_references)).hexdigest())
+    if version >= 2:
+      inventory["split_selection"] = audit
+  return inventory
+
+
+def checkpoint_reference(root, checkpoint):
+  """Original final row reference, not a synthetic row or a rewritten journal."""
+  token = validate_checkpoint(checkpoint)
+  if token["schema_version"] == 1:
+    return {"path": "settings.jsonl", "sequence": token["sequence"], "sha256": token["chain_sha256"],
+            "bytes": token["bytes"], "durable": True}
+  from .journal_segments import iter_verified_catalog, validate_reference
+  active = token["active"]
+  if active is None or not active["bytes"]:
+    active = None
+    for entry in iter_verified_catalog(root, token):
+      active = entry
+  if active is None:
+    raise ValueError("snapshot_checkpoint_empty")
+  return validate_reference({"schema_version": 2, "session_id": token["session_id"], "segment_index": active["index"],
+    "path": active["path"], "sequence": token["sequence"], "sha256": token["chain_sha256"],
+    "bytes": active["bytes"], "total_bytes": token["bytes"], "durable": True})
+
+
+def _create_segmented_snapshot(session_directory, destination, token, *, window_seconds, analysis_range=None):
+  from .settings_history import select_history_window
+  if analysis_range is None and (type(window_seconds) is not int or window_seconds not in (180, 300)):
+    raise ValueError("invalid_snapshot_window")
+  source, target = Path(session_directory), Path(destination)
+  if source.resolve() == target.resolve() or source.resolve() in target.resolve().parents or target.resolve() in source.resolve().parents:
+    raise ValueError("snapshot_source_destination_overlap")
+  if any(part.is_symlink() or (hasattr(part, "is_junction") and part.is_junction()) for part in (target.parent, *target.parent.parents)):
+    raise ValueError("snapshot_directory_link")
+  metadata = _read(source / "recording.json", 64 * 1024)
+  if _object(metadata).get("session_id") != token["session_id"]:
+    raise ValueError("snapshot_session_mismatch")
+  # Include the closing log segment and intervention/recovery margin. This is
+  # evidence closure, not an assertion that this extra time is tuning eligible.
+  end = token["cutoff_mono_ns"]
+  if analysis_range is not None:
+    if (type(analysis_range) is not dict or set(analysis_range) != {"start_ns", "end_ns"}
+        or any(type(value) is not int or value < 0 for value in analysis_range.values())
+        or not analysis_range["start_ns"] <= analysis_range["end_ns"] <= end):
+      raise ValueError("invalid_snapshot_range")
+    start, end = max(0, analysis_range["start_ns"] - 65_000_000_000), analysis_range["end_ns"]
+  else:
+    start = max(0, end - (window_seconds + 65) * 1_000_000_000)
+  selection = select_history_window(source, token, start, end)
+  files = _selected_files(source, token, selection)
+  target.mkdir(exist_ok=False)
+  (target / "history").mkdir()
+  _write(target / "recording.json", metadata)
+  for item in files:
+    if _prefix_digest(source / item["path"], item["bytes"], destination=target / item["path"]) != item["sha256"]:
+      raise ValueError("snapshot_source_changed")
+  history = load_history(target, checkpoint=token, selection=selection, include_records=True,
+                         max_bytes=WINDOW_MAX_BYTES, max_events=WINDOW_MAX_EVENTS)
+  if history["state"] != "complete" or history.get("selected_closure_complete") is not True:
+    raise ValueError("snapshot_selection_unverified")
+  archives = committed_archives(history)
+  pid_inventory = _pin_pid_chunks(source, target, history, copy_files=True, analysis_range=analysis_range)
+  marker = {"schema_version": 2, "kind": "advisor_journal_snapshot", "session_id": token["session_id"],
+            "checkpoint": token, "selection": selection, "history_files": files,
+            "history_byte_count": sum(item["bytes"] for item in files),
+            "recording_sha256": hashlib.sha256(metadata).hexdigest(), "selected_closure_complete": True,
+            "source_session_closed": history["closed"], "archive_ids": sorted(archives),
+            "power_loss_durability": "file_fsync_only" if os.name == "nt" else "file_and_directory_fsync"}
+  if pid_inventory is not None:
+    marker["pid_burst_inventory"] = pid_inventory
+  _sync_directory(target / "history")
+  _write(target / "snapshot.json", _canonical(marker) + b"\n")
+  _sync_directory(target)
+  _sync_directory(target.parent)
+  _load_segmented_snapshot(source, target, marker, _read(target / "snapshot.json", 64 * 1024))
+  return _archive_summary(source, target, token, history, archives)
+
+
+def _load_segmented_snapshot(source, root, marker, marker_bytes):
+  required = {"schema_version", "kind", "session_id", "checkpoint", "selection", "history_files", "history_byte_count",
+              "recording_sha256", "selected_closure_complete", "source_session_closed", "archive_ids", "power_loss_durability"}
+  if (set(marker) not in (required, required | {"pid_burst_inventory"}) or type(marker["schema_version"]) is not int or marker["schema_version"] != 2
+      or marker["kind"] != "advisor_journal_snapshot" or marker["selected_closure_complete"] is not True
+      or type(marker["source_session_closed"]) is not bool
+      or marker["power_loss_durability"] not in {"file_fsync_only", "file_and_directory_fsync"}):
+    raise ValueError("invalid_snapshot_marker")
+  token = validate_checkpoint(marker["checkpoint"])
+  if token["schema_version"] != 2 or token["session_id"] != marker["session_id"]:
+    raise ValueError("snapshot_session_mismatch")
+  history = load_history(root, checkpoint=token, selection=marker["selection"], include_records=True,
+                         max_bytes=WINDOW_MAX_BYTES, max_events=WINDOW_MAX_EVENTS)
+  files = _selected_files(root, token, marker["selection"])
+  metadata = _read(root / "recording.json", 64 * 1024)
+  if (history["state"] != "complete" or history.get("selected_closure_complete") is not True
+      or files != marker["history_files"] or sum(item["bytes"] for item in files) != marker["history_byte_count"]
+      or hashlib.sha256(metadata).hexdigest() != marker["recording_sha256"]
+      or _object(metadata).get("session_id") != token["session_id"] or history["closed"] != marker["source_session_closed"]):
+    raise ValueError("snapshot_selection_mismatch")
+  for item in files:
+    if _prefix_digest(root / item["path"], item["bytes"], exact=True) != item["sha256"]:
+      raise ValueError("snapshot_selection_changed")
+    if source.resolve() != root.resolve() and _prefix_digest(source / item["path"], item["bytes"]) != item["sha256"]:
+      raise ValueError("snapshot_source_changed")
+  if source.resolve() != root.resolve() and _read(source / "recording.json", 64 * 1024) != metadata:
+    raise ValueError("snapshot_source_changed")
+  archives = committed_archives(history)
+  if _pin_pid_chunks(source, root, history, analysis_range=(marker.get("pid_burst_inventory") or {}).get("selection_range")) != marker.get("pid_burst_inventory"):
+    raise ValueError("snapshot_pid_inventory_mismatch")
+  if sorted(archives) != marker["archive_ids"] or _read(root / "snapshot.json", 64 * 1024) != marker_bytes:
+    raise ValueError("snapshot_archive_inventory_mismatch")
+  return {"marker": marker, "history": history, "archive_receipts": archives, "recording": _object(metadata),
+          "recording_bytes": metadata, "history_bytes": None, "history_byte_count": marker["history_byte_count"],
+          "history_files": files, "selection": marker["selection"]}
+
+
+def create_journal_snapshot(session_directory, destination, checkpoint, *, max_bytes=MAX_BYTES, max_events=MAX_EVENTS, window_seconds=300, analysis_range=None):
+  """Child-process I/O only. A failed snapshot keeps an incomplete new directory."""
+  _limits(max_bytes, max_events)
+  token = validate_checkpoint(checkpoint)
+  if token["schema_version"] == 2:
+    if analysis_range is not None:
+      from .trip_history import create_trip_snapshot
+      return create_trip_snapshot(session_directory, destination, token, analysis_range)
+    return _create_segmented_snapshot(session_directory, destination, token, window_seconds=window_seconds, analysis_range=analysis_range)
+  if token["bytes"] > max_bytes or token["sequence"] > max_events:
+    raise ValueError("snapshot_checkpoint_budget")
+  source, target = Path(session_directory), Path(destination)
+  if source.resolve() == target.resolve() or source.resolve() in target.resolve().parents or target.resolve() in source.resolve().parents:
+    raise ValueError("snapshot_source_destination_overlap")
+  if any(part.is_symlink() or (hasattr(part, "is_junction") and part.is_junction()) for part in (target.parent, *target.parent.parents)):
+    raise ValueError("snapshot_directory_link")
+  metadata = _read(source / "recording.json", 64 * 1024)
+  if _object(metadata).get("session_id") != token["session_id"]:
+    raise ValueError("snapshot_session_mismatch")
+  prefix = _read(source / "settings.jsonl", token["bytes"], prefix=True)
+  target.mkdir(exist_ok=False)
+  _write(target / "recording.json", metadata)
+  _write(target / "settings.jsonl", prefix)
+  history = load_history(target / "settings.jsonl", max_bytes=max_bytes, max_events=max_events,
+                         include_records=True, checkpoint=token)
+  if history["state"] != "complete" or history.get("snapshot_prefix_complete") is not True:
+    raise ValueError("snapshot_prefix_unverified")
+  archives = committed_archives(history)
+  pid_inventory = _pin_pid_chunks(source, target, history, copy_files=True, analysis_range=analysis_range)
+  marker = {"schema_version": 1, "kind": "advisor_journal_snapshot", "session_id": token["session_id"], "checkpoint": token,
+            "settings_sha256": hashlib.sha256(prefix).hexdigest(), "recording_sha256": hashlib.sha256(metadata).hexdigest(),
+            "snapshot_prefix_complete": True, "source_session_closed": history["closed"], "archive_ids": sorted(archives),
+            "power_loss_durability": "file_fsync_only" if os.name == "nt" else "file_and_directory_fsync"}
+  if pid_inventory is not None:
+    marker["pid_burst_inventory"] = pid_inventory
+  if _read(source / "settings.jsonl", token["bytes"], prefix=True) != prefix or _read(source / "recording.json", 64 * 1024) != metadata:
+    raise ValueError("snapshot_source_changed")
+  _sync_directory(target)
+  _write(target / "snapshot.json", _canonical(marker) + b"\n")
+  _sync_directory(target)
+  _sync_directory(target.parent)
+  return _archive_summary(source, target, token, history, archives)
+
+
+def _archive_summary(source, target, token, history, archives):
+  from .inspection import inspect_session
+  inspection = inspect_session(source, session_snapshot=target)
+  archive_sources, expected = [], {}
+  for identity, receipt in archives.items():
+    start, end = receipt.get("start_mono_ns"), receipt.get("end_mono_ns")
+    declared = type(start) is int and type(end) is int and 0 <= start <= end
+    expected[identity] = {"archive_id": identity, **{key: receipt.get(key) for key in ("sha256", "bytes", "route", "segment")},
+                          "start_ns": start if declared else None, "end_ns": end if declared else None,
+                          "range_kind": "receipt_declared" if declared else "unknown", "coverage_verified": False,
+                          "state": "unavailable", "reason": "archive_not_inspected"}
+  for item in inspection["archives"]["items"]:
+    declared = expected[item["archive_id"]]
+    if item["state"] != "verified":
+      declared["reason"] = item.get("reason") or "archive_verification_failed"
+      continue
+    receipt = archives[item["archive_id"]]
+    marker_path = source / "archive" / item["archive_id"] / "archive.json"
+    data = _read(marker_path, 64 * 1024)
+    if hashlib.sha256(data).hexdigest() != item["manifest_sha256"]:
+      raise ValueError("snapshot_archive_changed")
+    manifest = _object(data)
+    payload = _regular_file(marker_path.parent / manifest["file"]["path"])
+    archive_sources.append({"path": str(payload.resolve()), "archive_id": item["archive_id"],
+                            **{key: receipt[key] for key in ("sha256", "bytes", "route", "segment")},
+                            "start_ns": manifest["coverage"]["services"]["carState"]["mono_min_ns"],
+                            "end_ns": manifest["coverage"]["services"]["carState"]["mono_max_ns"]})
+    declared.update(start_ns=archive_sources[-1]["start_ns"], end_ns=archive_sources[-1]["end_ns"],
+                    range_kind="verified_car_state", coverage_verified=True, state="available", reason=None)
+  route = next((entry["record"]["route_observation"] for entry in reversed(history["records"])
+                if entry["record"]["type"] == "settings_observation"), None)
+  return {"snapshot_directory": str(target.resolve()), "session_id": token["session_id"], "sequence": token["sequence"],
+          "chain_sha256": token["chain_sha256"], "bytes": token["bytes"], "snapshot_prefix_complete": token["schema_version"] == 1,
+          "source_session_closed": history["closed"], "committed_archive_count": len(archives),
+          "archive_sources": archive_sources, "expected_archive_sources": list(expected.values()), "route_observation": route}
+
+
+def load_journal_snapshot(session_directory, snapshot_directory, *, max_bytes=MAX_BYTES, max_events=MAX_EVENTS):
+  if (type(max_bytes) is not int or not 0 < max_bytes <= WINDOW_MAX_BYTES
+      or type(max_events) is not int or not 0 < max_events <= WINDOW_MAX_EVENTS):
+    raise ValueError("invalid_snapshot_budget")
+  source, root = Path(session_directory), Path(snapshot_directory)
+  marker_bytes = _read(root / "snapshot.json", 64 * 1024)
+  marker = _object(marker_bytes)
+  if marker.get("schema_version") == 3:
+    from .trip_history import load_trip_snapshot
+    return load_trip_snapshot(source, root, marker, marker_bytes)
+  if marker.get("schema_version") == 2:
+    return _load_segmented_snapshot(source, root, marker, marker_bytes)
+  # A caller supporting both formats cannot enlarge the v1 format's bounds.
+  max_bytes, max_events = min(max_bytes, MAX_BYTES), min(max_events, MAX_EVENTS)
+  required = {"schema_version", "kind", "session_id", "checkpoint", "settings_sha256", "recording_sha256",
+              "snapshot_prefix_complete", "source_session_closed", "archive_ids", "power_loss_durability"}
+  if (set(marker) not in (required, required | {"pid_burst_inventory"}) or type(marker["schema_version"]) is not int or marker["schema_version"] != 1
+      or marker["kind"] != "advisor_journal_snapshot" or marker["snapshot_prefix_complete"] is not True
+      or type(marker["source_session_closed"]) is not bool
+      or marker["power_loss_durability"] not in {"file_fsync_only", "file_and_directory_fsync"}):
+    raise ValueError("invalid_snapshot_marker")
+  token = validate_checkpoint(marker["checkpoint"])
+  if token["bytes"] > max_bytes or token["sequence"] > max_events:
+    raise ValueError("snapshot_checkpoint_budget")
+  prefix = _read(root / "settings.jsonl", token["bytes"])
+  metadata = _read(root / "recording.json", 64 * 1024)
+  history = load_history(root / "settings.jsonl", max_bytes=max_bytes, max_events=max_events,
+                         include_records=True, checkpoint=token)
+  if (history["state"] != "complete" or history.get("snapshot_prefix_complete") is not True
+      or history["verified_bytes_sha256"] != marker["settings_sha256"]
+      or hashlib.sha256(prefix).hexdigest() != marker["settings_sha256"]
+      or hashlib.sha256(metadata).hexdigest() != marker["recording_sha256"]
+      or _object(metadata).get("session_id") != token["session_id"] or marker["session_id"] != token["session_id"]
+      or history["closed"] != marker["source_session_closed"]
+      or _read(source / "settings.jsonl", token["bytes"], prefix=True) != prefix
+      or _read(source / "recording.json", 64 * 1024) != metadata):
+    raise ValueError("snapshot_prefix_mismatch")
+  archives = committed_archives(history)
+  if _pin_pid_chunks(source, root, history, analysis_range=(marker.get("pid_burst_inventory") or {}).get("selection_range")) != marker.get("pid_burst_inventory"):
+    raise ValueError("snapshot_pid_inventory_mismatch")
+  if marker["archive_ids"] != sorted(archives) or _read(root / "snapshot.json", 64 * 1024) != marker_bytes:
+    raise ValueError("snapshot_archive_inventory_mismatch")
+  return {"marker": marker, "history": history, "archive_receipts": archives, "recording": _object(metadata),
+          "recording_bytes": metadata, "history_bytes": prefix}
+
+
+def iter_snapshot_consumer_events(session_directory, snapshot_directory):
+  """Stream every immutable consumer event, including unselected time strata."""
+  sealed = load_journal_snapshot(session_directory, snapshot_directory)
+  if sealed["marker"]["schema_version"] == 3:
+    from .journal_segments import iter_verified_records
+    from .consumer_observer import validate_event
+    for item in iter_verified_records(Path(snapshot_directory), sealed["marker"]["checkpoint"]):
+      record = item["envelope"]["record"]
+      if record.get("type") == "consumer_observation":
+        yield validate_event(record["event"])
+  else:
+    for item in sealed["history"]["records"]:
+      if item["record"]["type"] == "consumer_observation":
+        yield item["record"]["event"]
diff --git a/openpilot/selfdrive/carrot/control_advisor/lateral_observations.py b/openpilot/selfdrive/carrot/control_advisor/lateral_observations.py
--- /dev/null
+++ b/openpilot/selfdrive/carrot/control_advisor/lateral_observations.py
@@ -0,0 +1,367 @@
+"""Pure, bounded lateral measurements from one explicitly identified recording.
+
+The caller binds the recorded CP, settings epoch and consumer evidence. These
+measurements do not establish a selected torque callback or a parameter ACK.
+"""
+from bisect import bisect_left, bisect_right
+from collections import deque
+from copy import deepcopy
+from itertools import islice
+import math
+import re
+
+
+CP_FIELDS = ("mass", "rotationalInertia", "wheelbase", "centerToFront", "steerRatioRear",
+             "tireStiffnessFront", "tireStiffnessRear", "steerRatio")
+SERVICES = frozenset(("carState", "carOutput", "carControl", "liveParameters", "liveCalibration",
+                      "livePose", "liveDelay", "carParams"))
+G = 9.81
+ENGAGEMENT_NS = 2_000_000_000
+MAX_SUPPORTS = 4096
+
+
+class _Unavailable(ValueError):
+  pass
+
+
+def _number(value):
+  if type(value) not in (int, float) or abs(value) > 1e100 or not math.isfinite(value):
+    raise _Unavailable("invalid_numeric_input")
+  return float(value)
+
+
+def _timestamp(value):
+  if type(value) is not int or not 0 <= value <= 2**63 - 1:
+    raise ValueError("invalid_timestamp")
+  return value
+
+
+def _measurement(value):
+  if type(value) is not dict or value.get("valid") is not True:
+    raise _Unavailable("pose_measurement_invalid")
+  return [_number(value.get(axis)) for axis in ("x", "y", "z")]
+
+
+def _scalar(value):
+  if value is None or type(value) is bool:
+    return value
+  if type(value) in (int, float):
+    return value if abs(value) <= 1e12 and math.isfinite(value) else None
+  return value if type(value) is str and len(value) <= 64 else None
+
+
+def _project(service, data):
+  """Copy only scalar fields needed here, never arbitrary event payloads."""
+  if type(data) is not dict:
+    raise _Unavailable("event_data_invalid")
+  if service == "carState":
+    return {key: _scalar(data.get(key)) for key in ("vEgo", "steeringAngleDeg", "steeringPressed")}
+  if service == "carOutput":
+    output = data.get("actuatorsOutput")
+    return {"torque": _scalar(output.get("torque")) if type(output) is dict else None}
+  if service == "carControl":
+    return {"latActive": _scalar(data.get("latActive"))}
+  if service == "livePose":
+    result = {key: _scalar(data.get(key)) for key in ("inputsOK", "sensorsOK", "posenetOK")}
+    stamp = data.get("timestamp")
+    result["timestamp"] = stamp if type(stamp) is int and 0 <= stamp <= 2**63 - 1 else None
+    for key in ("angularVelocityDevice", "orientationNED"):
+      value = data.get(key)
+      result[key] = {name: _scalar(value.get(name)) for name in ("x", "y", "z", "valid")} if type(value) is dict else None
+    return result
+  if service == "liveCalibration":
+    rpy = data.get("rpyCalib")
+    return {"calStatus": _scalar(data.get("calStatus")), "rpyCalib": [_scalar(value) for value in rpy] if type(rpy) in (list, tuple) and len(rpy) == 3 else None}
+  if service == "liveDelay":
+    return {key: _scalar(data.get(key)) for key in ("lateralDelay", "status", "validBlocks")}
+  if service == "liveParameters":
+    return {key: _scalar(data.get(key)) for key in ("valid", "sensorValid", "posenetValid", "angleOffsetDeg",
+            "stiffnessFactor", "steerRatio", "roll", "angleOffsetValid", "steerRatioValid", "stiffnessFactorValid") if key in data}
+  return {key: _scalar(data.get(key)) for key in CP_FIELDS}
+
+
+class LateralObservationBuilder:
+  def __init__(self, source_cp, *, max_age_ns, max_alignment_ns, max_buffer_events, include_pid_inputs=False):
+    if type(include_pid_inputs) is not bool:
+      raise ValueError("invalid_pid_input_mode")
+    self.include_pid_inputs = include_pid_inputs
+    if (type(source_cp) is not dict or set(source_cp) != {"schema_version", "source_id", "epoch_id", "config_sha256", "mono_ns", "values"}
+        or source_cp.get("schema_version") != 1 or type(source_cp.get("schema_version")) is not int):
+      raise ValueError("recorded_cp_required")
+    for key in ("source_id", "epoch_id"):
+      if type(source_cp[key]) is not str or not 1 <= len(source_cp[key]) <= 128 or not source_cp[key].strip():
+        raise ValueError("recorded_cp_identity_invalid")
+    if type(source_cp["config_sha256"]) is not str or re.fullmatch("[a-f0-9]{64}", source_cp["config_sha256"]) is None:
+      raise ValueError("recorded_cp_identity_invalid")
+    _timestamp(source_cp["mono_ns"])
+    if type(source_cp["values"]) is not dict or set(source_cp["values"]) != set(CP_FIELDS):
+      raise ValueError("recorded_cp_values_invalid")
+    cp = {key: _number(source_cp["values"][key]) for key in CP_FIELDS}
+    if (any(cp[key] <= 0 for key in ("mass", "rotationalInertia", "wheelbase", "tireStiffnessFront", "tireStiffnessRear", "steerRatio"))
+        or not 0 < cp["centerToFront"] < cp["wheelbase"] or abs(cp["steerRatioRear"]) >= 1):
+      raise ValueError("recorded_cp_values_invalid")
+    for value in (max_age_ns, max_alignment_ns):
+      if type(value) is not int or not 0 < value <= 60_000_000_000:
+        raise ValueError("invalid_time_bound")
+    if type(max_buffer_events) is not int or not 1 <= max_buffer_events <= 100_000:
+      raise ValueError("invalid_buffer_bound")
+    self._source = deepcopy(source_cp)
+    self._cp = cp
+    self.max_age_ns, self.max_alignment_ns = max_age_ns, max_alignment_ns
+    self._events = deque(maxlen=max_buffer_events)
+    self._by_service = {service: deque() for service in SERVICES}
+    self._keys = {service: deque() for service in SERVICES}
+    self._last = {}
+    self._cp_invalid_from = None
+
+  @property
+  def buffer_count(self):
+    return len(self._events)
+
+  def feed(self, event):
+    if type(event) is not dict:
+      raise ValueError("invalid_event")
+    service = event.get("service")
+    if type(service) is not str or service not in SERVICES:
+      return
+    stamp = _timestamp(event.get("mono_ns"))
+    previous = self._last.get(service, stamp)
+    effective = max(stamp, previous)
+    self._last[service] = effective
+    reason = None
+    if event.get("service_time_ordered") is not True or stamp < previous:
+      reason = "source_time_regression"
+    elif event.get("valid") is not True:
+      reason = "source_event_invalid"
+    try:
+      data = _project(service, event.get("data"))
+    except _Unavailable as exc:
+      data, reason = {}, str(exc)
+    if service == "carParams":
+      try:
+        if reason or any(_number(data.get(key)) != self._cp[key] for key in CP_FIELDS):
+          raise _Unavailable("recorded_cp_changed")
+      except _Unavailable:
+        self._cp_invalid_from = effective if self._cp_invalid_from is None else min(effective, self._cp_invalid_from)
+    item = {"service": service, "mono_ns": stamp, "effective_ns": effective, "data": data, "reason": reason}
+    if self.include_pid_inputs:
+      item["source_id"] = event.get("source_id")
+    if len(self._events) == self._events.maxlen:
+      oldest = self._events[0]
+      old_svc = oldest["service"]
+      self._by_service[old_svc].popleft()
+      self._keys[old_svc].popleft()
+    self._events.append(item)
+    self._by_service[service].append(item)
+    self._keys[service].append(effective)
+
+  def _history(self, service, anchor):
+    events = self._by_service.get(service)
+    if not events:
+      return []
+    idx = bisect_right(self._keys[service], anchor)
+    if idx == 0:
+      return []
+    if idx == len(events):
+      return list(events)
+    return list(islice(events, idx))
+
+  def _latest(self, service, at, supports):
+    events = self._by_service.get(service)
+    if not events:
+      raise _Unavailable(service + "_missing")
+    idx = bisect_right(self._keys[service], at)
+    if idx == 0:
+      raise _Unavailable(service + "_missing")
+    event = events[idx - 1]
+    self._use(event, supports)
+    if at - event["mono_ns"] > self.max_age_ns:
+      raise _Unavailable(service + "_stale")
+    return event
+
+  @staticmethod
+  def _use(event, supports):
+    if event["reason"]:
+      raise _Unavailable(event["reason"])
+    used = supports.setdefault(event["service"], set())
+    used.add(event["mono_ns"])
+    if sum(len(items) for items in supports.values()) > MAX_SUPPORTS:
+      raise _Unavailable("provenance_support_budget")
+
+  def _interpolate(self, service, field, at, anchor, allowance, supports):
+    events = self._by_service.get(service)
+    if not events:
+      raise _Unavailable(service + "_alignment_support_missing")
+    keys = self._keys[service]
+    anchor_idx = bisect_right(keys, anchor)
+    left_idx = bisect_right(keys, at, 0, anchor_idx) - 1
+    right_idx = bisect_left(keys, at, 0, anchor_idx)
+    if left_idx < 0 or right_idx >= anchor_idx:
+      raise _Unavailable(service + "_alignment_support_missing")
+    left, right = events[left_idx], events[right_idx]
+    self._use(left, supports)
+    self._use(right, supports)
+    if right["mono_ns"] - left["mono_ns"] > self.max_alignment_ns:
+      raise _Unavailable(service + "_alignment_gap")
+    if any(anchor - event["mono_ns"] > self.max_age_ns + allowance for event in (left, right)):
+      raise _Unavailable(service + "_alignment_stale")
+    a, b = _number(left["data"].get(field)), _number(right["data"].get(field))
+    span = right["mono_ns"] - left["mono_ns"]
+    value = a if span == 0 else a + (b - a) * ((at - left["mono_ns"]) / span)
+    return _number(value), max(left["mono_ns"], right["mono_ns"])
+
+  def _continuous(self, service, key, expected, start, end, supports):
+    events = self._by_service.get(service)
+    if not events:
+      raise _Unavailable(service + "_engagement_support_missing")
+    keys = self._keys[service]
+    end_idx = bisect_right(keys, end)
+    first_idx = bisect_right(keys, start, 0, end_idx) - 1
+    if first_idx < 0:
+      raise _Unavailable(service + "_engagement_support_missing")
+    previous = start
+    for event in islice(events, first_idx, end_idx):
+      self._use(event, supports)
+      if event["data"].get(key) is not expected:
+        raise _Unavailable("steering_override" if key == "steeringPressed" else "lateral_inactive")
+      if abs(event["mono_ns"] - previous) > self.max_age_ns:
+        raise _Unavailable(service + "_engagement_gap")
+      previous = event["mono_ns"]
+    if end - previous > self.max_age_ns:
+      raise _Unavailable(service + "_engagement_gap")
+
+  def observe(self, anchor_ns):
+    anchor = _timestamp(anchor_ns)
+    signals, supports, availability = {}, {}, {}
+    provenance = {key: self._source[key] for key in ("source_id", "epoch_id", "config_sha256")}
+    provenance.update(response_mono_ns=None, pose_event_mono_ns=None, supports={},
+                      alignment={"kind": "none", "delay_ns": None}, consumer_mapping_verified=False,
+                      parameter_application_ack=False, closed_loop_improvement_proven=False)
+
+    def signal(name, value, unit, source, stamp):
+      signals[name] = {"value": _number(value), "unit": unit, "source": source, "source_mono_ns": stamp}
+
+    def state(branch, reason=None):
+      availability[branch] = {"available": reason is None, "reason_codes": [] if reason is None else [reason]}
+
+    try:
+      if anchor < self._source["mono_ns"]:
+        raise _Unavailable("recorded_cp_future")
+      if self._cp_invalid_from is not None and anchor >= self._cp_invalid_from:
+        raise _Unavailable("recorded_cp_changed")
+      pose = self._latest("livePose", anchor, supports)
+      data = pose["data"]
+      response = _timestamp(data.get("timestamp"))
+      if response < self._source["mono_ns"] or response > pose["mono_ns"]:
+        raise _Unavailable("pose_timestamp_invalid")
+      if anchor - response > self.max_age_ns:
+        raise _Unavailable("pose_response_stale")
+      if any(data.get(key) is not True for key in ("inputsOK", "sensorsOK", "posenetOK")):
+        raise _Unavailable("pose_inputs_invalid")
+      angular, orientation = _measurement(data.get("angularVelocityDevice")), _measurement(data.get("orientationNED"))
+      calibration = self._latest("liveCalibration", response, supports)["data"]
+      if calibration.get("calStatus") != "calibrated" or calibration.get("rpyCalib") is None:
+        raise _Unavailable("calibration_invalid")
+      roll, pitch, yaw = [_number(value) for value in calibration["rpyCalib"]]
+      cx, sx, cy, sy, cz, sz = math.cos(roll), math.sin(roll), math.cos(pitch), math.sin(pitch), math.cos(yaw), math.sin(yaw)
+      calibrated_yaw = _number((cz * sy * cx + sz * sx) * angular[0] + (sz * sy * cx - cz * sx) * angular[1] + cy * cx * angular[2])
+      provenance.update(response_mono_ns=response, pose_event_mono_ns=pose["mono_ns"])
+      signal("yaw_rate_calibrated", calibrated_yaw, "rad/s", "independent_measurement", response)
+      state("pose")
+    except (ValueError, OverflowError) as exc:
+      reason = str(exc) if isinstance(exc, _Unavailable) else "pose_timestamp_invalid"
+      for branch in ("pose", "torque_response", "geometry", "manual_geometry"):
+        state(branch, reason)
+      return self._result(signals, availability, provenance, supports)
+
+    if self.include_pid_inputs:
+      try:
+        speed, speed_stamp = self._interpolate("carState", "vEgo", response, anchor, 0, supports)
+        if speed <= 0:
+          raise _Unavailable("positive_speed_required")
+        # Raw kinematic response at the pose clock: no gravity correction or
+        # actuator-delay shift. Repeated poses retain their original timestamp.
+        signal("lateral_accel_kinematic", speed * calibrated_yaw, "m/s^2", "independent_measurement", response)
+        provenance["pid_kinematic"] = {"source_id": pose.get("source_id"), "source_mono_ns": response,
+          "pose_event_mono_ns": pose["mono_ns"], "speed_support_mono_ns": speed_stamp,
+          "calibration_valid": True, "gravity_corrected": False}
+        state("pid_kinematic")
+      except (ValueError, OverflowError) as exc:
+        state("pid_kinematic", str(exc) if isinstance(exc, _Unavailable) else "kinematic_numeric_invalid")
+
+    try:
+      delay = self._latest("liveDelay", response, supports)["data"]
+      if delay.get("status") != "estimated" or type(delay.get("validBlocks")) is not int or delay["validBlocks"] <= 0:
+        raise _Unavailable("lateral_delay_unestimated")
+      seconds = _number(delay.get("lateralDelay"))
+      if seconds < 0 or seconds * 1e9 > self.max_alignment_ns:
+        raise _Unavailable("lateral_delay_out_of_bounds")
+      lag = round(seconds * 1e9)
+      target = response - lag
+      if target < 0:
+        raise _Unavailable("lateral_delay_support_missing")
+      self._continuous("carControl", "latActive", True, response - ENGAGEMENT_NS - lag, response, supports)
+      self._continuous("carState", "steeringPressed", False, response - ENGAGEMENT_NS - lag, response, supports)
+      speed, _ = self._interpolate("carState", "vEgo", target, anchor, lag, supports)
+      torque, stamp = self._interpolate("carOutput", "torque", target, anchor, lag, supports)
+      if speed <= 0:
+        raise _Unavailable("positive_speed_required")
+      accel = _number(speed * calibrated_yaw - math.sin(orientation[0]) * G)
+      signal("sent_torque", -torque, "1", "controller_output", stamp)
+      signal("lateral_accel_independent", accel, "m/s^2", "independent_measurement", response)
+      provenance["alignment"] = {"kind": "recorded_lateral_delay", "delay_ns": lag}
+      state("torque_response")
+    except (ValueError, OverflowError) as exc:
+      state("torque_response", str(exc) if isinstance(exc, _Unavailable) else "torque_numeric_invalid")
+
+    try:
+      live_event = self._latest("liveParameters", response, supports)
+      live = live_event["data"]
+      if (any(live.get(key) is not True for key in ("valid", "sensorValid", "posenetValid"))
+          or any(key in live and live[key] is not True for key in ("angleOffsetValid", "stiffnessFactorValid"))):
+        raise _Unavailable("live_parameters_invalid")
+      speed, speed_stamp = self._interpolate("carState", "vEgo", response, anchor, 0, supports)
+      angle, angle_stamp = self._interpolate("carState", "steeringAngleDeg", response, anchor, 0, supports)
+      stiffness = _number(live.get("stiffnessFactor"))
+      road_roll, offset = _number(live.get("roll")), _number(live.get("angleOffsetDeg"))
+      if min(speed, stiffness) <= 0:
+        raise _Unavailable("geometry_positive_values_required")
+      cp = self._cp
+      front, rear = stiffness * cp["tireStiffnessFront"], stiffness * cp["tireStiffnessRear"]
+      slip = cp["mass"] * (front * cp["centerToFront"] - rear * (cp["wheelbase"] - cp["centerToFront"])) / (cp["wheelbase"] ** 2 * front * rear)
+      denominator = 1 - slip * speed ** 2
+      if not math.isfinite(denominator) or abs(denominator) <= 1e-12:
+        raise _Unavailable("vehicle_model_singular")
+      factor = _number((1 - cp["steerRatioRear"]) / denominator / cp["wheelbase"])
+      roll_curvature = _number(0. if abs(slip) < 1e-6 else G * road_roll * slip / denominator)
+      corrected = _number(math.radians(angle - offset))
+      # Prepare all values before publishing: failed geometry never leaves partial signals.
+      values = (("curvature_independent", calibrated_yaw / speed, "1/m", "independent_measurement", response),
+                ("lateral_accel_kinematic", speed * calibrated_yaw, "m/s^2", "independent_measurement", response),
+                ("steering_angle_corrected", corrected, "rad", "derived_input", max(angle_stamp, live_event["mono_ns"])),
+                ("vm_curvature_factor", factor, "1/m", "derived_input", max(speed_stamp, live_event["mono_ns"])),
+                ("roll_curvature", roll_curvature, "1/m", "derived_input", max(speed_stamp, live_event["mono_ns"])))
+      for args in values:
+        _number(args[1])
+      for args in values:
+        signal(*args)
+      state("manual_geometry")
+      if live.get("steerRatioValid", True) is not True:
+        raise _Unavailable("live_parameters_invalid")
+      ratio = _number(live.get("steerRatio"))
+      if ratio <= 0:
+        raise _Unavailable("geometry_positive_values_required")
+      signal("live_steer_ratio", ratio, "1", "learned_estimate", live_event["mono_ns"])
+      state("geometry")
+    except (ValueError, OverflowError, ZeroDivisionError) as exc:
+      if "manual_geometry" not in availability:
+        state("manual_geometry", str(exc) if isinstance(exc, _Unavailable) else "vehicle_model_numeric_invalid")
+      state("geometry", str(exc) if isinstance(exc, _Unavailable) else "vehicle_model_numeric_invalid")
+    return self._result(signals, availability, provenance, supports)
+
+  @staticmethod
+  def _result(signals, availability, provenance, supports):
+    provenance["supports"] = {key: sorted(values) for key, values in supports.items()}
+    return {"signals": signals, "availability": availability,
+            "reason_codes": sorted({reason for item in availability.values() for reason in item["reason_codes"]}),
+            "provenance": provenance}
diff --git a/openpilot/selfdrive/carrot/control_advisor/live.py b/openpilot/selfdrive/carrot/control_advisor/live.py
--- /dev/null
+++ b/openpilot/selfdrive/carrot/control_advisor/live.py
@@ -0,0 +1,464 @@
+"""Bounded read-only live transport and host-provisional diagnostic session.
+
+No scheduler/affinity, Params, control output or recommendation writer lives
+here. Missing native IPC is an unavailable source, never a synthetic fallback.
+"""
+
+from collections import deque
+from copy import deepcopy
+from dataclasses import dataclass
+import heapq
+import time
+
+from .analysis import AnalysisProfile, Observation, analyze
+from .normalizer import EventNormalizer, SERVICES
+from .parking import ParkingObserver
+
+
+MAX_EVENT_BYTES = 1024 * 1024
+LIVE_SERVICES = (*SERVICES, "deviceState")
+TERMINAL_STATES = {"ended", "stopped", "unavailable", "failed"}
+TRANSITION_RECOVERY_NS = TRANSITION_MAX_AGE_NS = 2_000_000_000
+TRANSITION_REASONS = {"transition_waiting", "transition_ready", "transition_recovering", "transition_driver_override",
+                      "transition_invalid_telemetry", "transition_axis_inactive", "transition_observation_gap",
+                      "transition_invalidated", "transition_session_ended", "transition_input_stale",
+                      "transition_parent_observation_stale", "transition_parent_session_inactive", "transition_parent_heartbeat_stale"}
+
+
+def unknown_transition(reason="transition_waiting"):
+  return {axis: {"ready": False, "reason": reason, "observed_mono_ns": None, "valid_since_mono_ns": None,
+                 "last_blocked_mono_ns": None, "recovery_ns": TRANSITION_RECOVERY_NS, "max_age_ns": TRANSITION_MAX_AGE_NS}
+          for axis in ("lateral", "longitudinal")}
+
+
+def validate_transition(value):
+  if type(value) is not dict or set(value) != {"lateral", "longitudinal"}:
+    raise ValueError("invalid_worker_transition")
+  fields = set(unknown_transition()["lateral"])
+  for item in value.values():
+    if (type(item) is not dict or set(item) != fields or type(item["ready"]) is not bool
+        or type(item["reason"]) is not str or item["reason"] not in TRANSITION_REASONS
+        or type(item["recovery_ns"]) is not int or item["recovery_ns"] != TRANSITION_RECOVERY_NS
+        or type(item["max_age_ns"]) is not int or item["max_age_ns"] != TRANSITION_MAX_AGE_NS):
+      raise ValueError("invalid_worker_transition")
+    for name in ("observed_mono_ns", "valid_since_mono_ns", "last_blocked_mono_ns"):
+      if item[name] is not None and (type(item[name]) is not int or not 0 <= item[name] <= 2**63 - 1):
+        raise ValueError("invalid_worker_transition")
+    stamp, since, blocked = (item[name] for name in ("observed_mono_ns", "valid_since_mono_ns", "last_blocked_mono_ns"))
+    if (since is not None and (stamp is None or since > stamp or blocked is not None and blocked > since)
+        or blocked is not None and stamp is not None and blocked > stamp
+        or item["ready"] and (stamp is None or since is None or stamp - since < TRANSITION_RECOVERY_NS or item["reason"] != "transition_ready")):
+      raise ValueError("invalid_worker_transition")
+  return deepcopy(value)
+
+
+@dataclass(frozen=True)
+class LiveEvent:
+  service: str
+  mono_ns: int
+  valid: bool
+  data: dict
+  recv_ns: int
+  source_bytes: int = 1
+
+
+class NativeTransport:
+  def __init__(self, *, messaging_module=None, max_event_bytes=MAX_EVENT_BYTES, clock_ns=time.monotonic_ns):
+    if type(max_event_bytes) is not int or max_event_bytes <= 0:
+      raise ValueError("max_event_bytes must be positive")
+    if messaging_module is None:
+      try:
+        from openpilot.cereal import messaging as messaging_module
+      except (ImportError, OSError, RuntimeError) as exc:
+        raise RuntimeError("native_messaging_unavailable") from exc
+    self.messaging, self.max_event_bytes, self.clock_ns = messaging_module, max_event_bytes, clock_ns
+    self.sockets, self.cursor = {}, 0
+    self.received_events = self.rejected_events = self.budget_overruns = 0
+    self.last_poll_ns = 0
+    try:
+      for service in LIVE_SERVICES:
+        self.sockets[service] = self.messaging.sub_sock(service, conflate=False)
+    except Exception:
+      self.close()
+      raise
+
+  def poll(self, *, max_events=256, budget_ns=5_000_000) -> list[LiveEvent]:
+    if type(max_events) is not int or max_events <= 0 or type(budget_ns) is not int or budget_ns <= 0:
+      raise ValueError("poll count/time budgets must be positive integers")
+    start, reads, empty = self.clock_ns(), 0, 0
+    result = []
+    while reads < max_events and self.clock_ns() - start < budget_ns:
+      service = LIVE_SERVICES[self.cursor]
+      self.cursor = (self.cursor + 1) % len(LIVE_SERVICES)
+      raw = self.sockets[service].receive(non_blocking=True)
+      if raw is None:
+        empty += 1
+        if empty >= len(LIVE_SERVICES):
+          break
+        continue
+      reads += 1
+      empty = 0
+      self.received_events += 1
+      recv_ns = self.clock_ns()
+      if not isinstance(raw, bytes) or len(raw) > self.max_event_bytes:
+        self.rejected_events += 1
+        continue
+      try:
+        # Check bytes before a bounded decode; do not use unlimited log_from_bytes.
+        with self.messaging.log.Event.from_bytes(raw, traversal_limit_in_words=max(1, self.max_event_bytes // 8),
+                                                  nesting_limit=64) as event:
+          if event.which() != service:
+            raise ValueError("native service mismatch")
+          result.append(LiveEvent(service, int(event.logMonoTime), bool(event.valid),
+                                  getattr(event, service).to_dict(), recv_ns, len(raw)))
+      except Exception:
+        self.rejected_events += 1
+    self.last_poll_ns = max(0, self.clock_ns() - start)
+    # A single native decode is not preemptible. Exceeding this cooperative host
+    # budget is recorded; it is not a proven device scheduling upper bound.
+    self.budget_overruns += self.last_poll_ns > budget_ns
+    return result
+
+  def close(self):
+    for socket in self.sockets.values():
+      close = getattr(socket, "close", None)
+      if close is not None:
+        try:
+          close()
+        except Exception:
+          pass
+    self.sockets.clear()
+
+
+def _compact_diagnostic(diagnostic):
+  """Bound display details, retaining exact counts and metrics from the full mask."""
+  result = {**diagnostic, "axes": {}}
+  for axis, axis_result in diagnostic["axes"].items():
+    epochs = {}
+    for epoch, summary in axis_result["epochs"].items():
+      reasons = {}
+      for interval in summary["exclusions"]:
+        reasons[interval["reason"]] = reasons.get(interval["reason"], 0) + interval["sample_count"]
+      epochs[epoch] = {**summary, "exclusions": summary["exclusions"][:32],
+                       "exclusion_intervals_total": len(summary["exclusions"]),
+                       "exclusion_intervals_omitted": max(0, len(summary["exclusions"]) - 32),
+                       "exclusion_reason_counts": reasons}
+    result["axes"][axis] = {"epochs": epochs}
+  return result
+
+
+class LiveSession:
+  def __init__(self, session_id: str, *, source_mode: str, interval_seconds: int = 300,
+               max_queue_events: int = 4096, max_buffer_bytes: int = 8 * 1024 * 1024,
+               lateness_ns: int = 100_000_000, max_observations: int = 100_000,
+               max_session_seconds: int | None = None, clock_ns=time.monotonic_ns):
+    if not isinstance(session_id, str) or not session_id or len(session_id) > 128:
+      raise ValueError("session_id must contain 1..128 characters")
+    if source_mode not in ("live", "synthetic") or type(interval_seconds) is not int or interval_seconds not in (180, 300):
+      raise ValueError("source mode/interval must be live|synthetic and 180|300")
+    for name, value in (("max_queue_events", max_queue_events), ("max_buffer_bytes", max_buffer_bytes),
+                        ("max_observations", max_observations)):
+      if type(value) is not int or value <= 0:
+        raise ValueError(f"{name} must be a positive integer")
+    if max_session_seconds is not None and (type(max_session_seconds) is not int or max_session_seconds <= 0):
+      raise ValueError("max_session_seconds must be None or a positive integer")
+    if type(lateness_ns) is not int or lateness_ns < 0:
+      raise ValueError("lateness_ns must be a nonnegative integer")
+    self.session_id, self.source_mode, self.interval_ns = session_id, source_mode, interval_seconds * 1_000_000_000
+    self.max_queue_events, self.max_buffer_bytes = max_queue_events, max_buffer_bytes
+    self.lateness_ns, self.max_observations = lateness_ns, max_observations
+    self.max_session_ns = None if max_session_seconds is None else max_session_seconds * 1_000_000_000
+    self.clock_ns = clock_ns
+    self.profile = AnalysisProfile(f"{source_mode}-host-unvalidated-v1", 100_000_000, 2_000_000_000,
+                                   250_000_000, 100_000_000, max_observations)
+    self.state, self.reason = "waiting_for_data", "waiting_for_source"
+    self.worker_runtime = None
+    self.received_events = self.observations = self.late_events = self.overflow_events = self.gap_events = self.dropped_events = 0
+    self.poll_budget_overruns = self.diagnostic_revision = 0
+    self.diagnostic, self.history = None, deque(maxlen=6)
+    self.preservation_bookmark = None
+    self._bookmark_start_ns = None
+    self._bookmark_end_ns = None
+    self.nonpark_observed_ns = None
+    self._heap, self._window = [], deque()
+    self._sequence = self._queued_bytes = 0
+    self._max_seen_ns = self._released_through_ns = -1
+    self._last_service_ns = {}
+    self._last_received_wall_ns = None
+    self._started_wall_ns = self.clock_ns()
+    self._next_evaluation_ns = self._last_diagnostic_end_ns = None
+    self._needs_fresh_window = self._stale_invalidated = False
+    self._settings_epoch = "unverified-session"
+    self.observed_settings_revision = None
+    self.settings_observation_state = "unavailable"
+    self._settings_notice_token = None
+    self._settings_boundary_ns = None
+    self._route_observation = None
+    self.recording_status = None
+    self.consumer_observations = None
+    self.transition = unknown_transition()
+    self._normalizer = self._new_normalizer()
+    self.parking = ParkingObserver(source_kind="native_event" if source_mode == "live" else "synthetic_event", clock_ns=clock_ns,
+                                   source_clock_ns=clock_ns if source_mode == "live" else lambda: max(0, self._max_seen_ns))
+
+  def _new_normalizer(self):
+    return EventNormalizer(epoch=self._settings_epoch, max_age_ns=200_000_000,
+                           source=f"{self.source_mode}_car_state_anchor")
+
+  def observe_settings(self, notice):
+    """Observed storage revisions are uncertain boundaries, never consumer ACKs."""
+    if self.state in TERMINAL_STATES:
+      return
+    revision = notice.get("revision")
+    if type(revision) is not int or revision < 0:
+      raise ValueError("observed settings revision must be a nonnegative integer")
+    state = notice.get("state", "unavailable")
+    route_notice = notice.get("route_observation") or {}
+    token = (revision, state, notice.get("durable_revision"), notice.get("journal", {}).get("durable"),
+             route_notice.get("route"), route_notice.get("state"))
+    observation = notice.get("observation") or {}
+    gap = observation.get("gap") is True or notice.get("notification_gap") is True
+    if token == self._settings_notice_token and not gap:
+      return
+    initial = self._settings_notice_token is None
+    self._settings_notice_token = token
+    self.observed_settings_revision = revision if revision > 0 else None
+    self.settings_observation_state = state
+    self._route_observation = deepcopy(notice.get("route_observation"))
+    self._settings_boundary_ns = observation.get("end_ns")
+    self._settings_epoch = f"observed-{revision}" if revision > 0 else "unverified-session"
+    reason = "stored_settings_observation_gap" if gap else "stored_settings_initial_observation" if initial else "stored_settings_observation_changed"
+    self.invalidate(reason)
+
+  def invalidate(self, reason: str, *, overflow: bool = False):
+    if self.state in TERMINAL_STATES:
+      return
+    self.parking.invalidate()
+    self.nonpark_observed_ns = None
+    self.transition = unknown_transition("transition_invalidated")
+    self.dropped_events += len(self._heap)
+    self._heap.clear()
+    self._queued_bytes = 0
+    self._window.clear()
+    self._normalizer = self._new_normalizer()
+    self._next_evaluation_ns = self._last_diagnostic_end_ns = None
+    self._needs_fresh_window = True
+    self.state, self.reason = "degraded", reason
+    if overflow:
+      self.overflow_events += 1
+    if self.diagnostic is not None and not self.diagnostic.get("invalidated"):
+      self.diagnostic_revision += 1
+      self.diagnostic = {**self.diagnostic, "revision": self.diagnostic_revision,
+                         "invalidated": True, "invalidation_reason": reason}
+      self.history.append({"revision": self.diagnostic_revision, "state": "invalidated", "reason": reason})
+
+  def ingest_batch(self, events):
+    if self.state in TERMINAL_STATES:
+      return
+    for event in events:
+      self.received_events += 1
+      if not isinstance(event, LiveEvent) or event.service not in LIVE_SERVICES or type(event.mono_ns) is not int or event.mono_ns < 0:
+        raise ValueError("malformed live event")
+      if type(event.recv_ns) is not int or event.recv_ns < 0 or type(event.valid) is not bool or not isinstance(event.data, dict):
+        raise ValueError("malformed live event metadata")
+      if type(event.source_bytes) is not int or event.source_bytes <= 0:
+        raise ValueError("source_bytes must be a positive integer")
+      if event.service == "deviceState":
+        # Auxiliary evidence never advances a control watermark or freshness.
+        valid = (event.valid and event.source_bytes <= MAX_EVENT_BYTES
+                 and event.recv_ns - event.mono_ns <= 2_000_000_000
+                 and event.mono_ns - event.recv_ns <= self.lateness_ns)
+        self.parking.feed(event.service, event.mono_ns, valid, event.data,
+                          event.recv_ns if self.source_mode == "live" else None)
+        continue
+      self._last_received_wall_ns = self.clock_ns()
+      self._stale_invalidated = False
+      if self._settings_boundary_ns is not None and event.mono_ns < self._settings_boundary_ns:
+        self.dropped_events += 1
+        continue
+      if event.source_bytes > MAX_EVENT_BYTES:
+        self.dropped_events += 1
+        self.invalidate("event_byte_limit", overflow=True)
+        continue
+      if event.recv_ns - event.mono_ns > 2_000_000_000 or event.mono_ns - event.recv_ns > self.lateness_ns:
+        self.late_events += 1
+        self.dropped_events += 1
+        self.invalidate("source_clock_or_delivery_stale")
+        continue
+      if event.mono_ns <= self._released_through_ns:
+        self.late_events += 1
+        self.dropped_events += 1
+        self.invalidate("late_event_after_watermark")
+        continue
+      previous = self._last_service_ns.get(event.service)
+      if previous is not None and event.mono_ns - previous > 1_000_000_000:
+        self.gap_events += 1
+        self.invalidate("service_timestamp_gap")
+      self._last_service_ns[event.service] = max(event.mono_ns, previous if previous is not None else event.mono_ns)
+      if len(self._heap) >= self.max_queue_events or self._queued_bytes + event.source_bytes > self.max_buffer_bytes:
+        self.dropped_events += 1
+        self.invalidate("event_queue_limit", overflow=True)
+        continue
+      heapq.heappush(self._heap, (event.mono_ns, SERVICES.index(event.service), self._sequence, event))
+      self._sequence += 1
+      self._queued_bytes += event.source_bytes
+      self._max_seen_ns = max(self._max_seen_ns, event.mono_ns)
+    self._drain(self._max_seen_ns - self.lateness_ns)
+
+  def _drain(self, through_ns):
+    while self._heap and self._heap[0][0] <= through_ns:
+      _, _, _, event = heapq.heappop(self._heap)
+      self._queued_bytes -= event.source_bytes
+      if event.service in {"carState", "carControl"}:
+        self.parking.feed(event.service, event.mono_ns, event.valid, event.data,
+                          event.recv_ns if self.source_mode == "live" else None)
+      if event.service == "carState":
+        self.nonpark_observed_ns = (event.mono_ns if event.valid and event.data.get("canValid") is True
+          and event.data.get("canTimeout") is not True and event.data.get("gearShifter") in {"drive", "reverse", "neutral", "low", "sport", "eco", "brake"} else None)
+      try:
+        rows = self._normalizer.feed(event.service, event.mono_ns, event.valid, event.data, event.recv_ns)
+      except ValueError:
+        self.invalidate("normalization_rejected")
+        self.dropped_events += 1
+        break
+      if len(self._window) + len(rows) > self.max_observations:
+        self.invalidate("observation_limit", overflow=True)
+        break
+      for row in rows:
+        self._observe_transition(row)
+        row["context"].update(observed_settings_revision=self.observed_settings_revision,
+                              settings_observation_state=self.settings_observation_state)
+        self._window.append(Observation(**row))
+        self.observations += 1
+      if rows:
+        if not self._needs_fresh_window:
+          self.state, self.reason = "running", "collecting_unvalidated_diagnostics"
+        if self._next_evaluation_ns is None:
+          self._next_evaluation_ns = rows[0]["mono_ns"] + self.interval_ns
+        guard_ns = self.profile.pre_margin_ns + self.profile.recovery_ns + self.profile.dependency_ns
+        earliest = rows[-1]["mono_ns"] - guard_ns
+        while self._window and self._window[0].mono_ns < earliest:
+          self._window.popleft()
+        if self._bookmark_start_ns is None:
+          self._bookmark_start_ns = rows[0]["mono_ns"]
+        if rows[-1]["mono_ns"] - (self._bookmark_end_ns if self._bookmark_end_ns is not None else self._bookmark_start_ns) >= 60_000_000_000:
+          self.bookmark()
+    self._released_through_ns = max(self._released_through_ns, through_ns)
+
+  def _observe_transition(self, row):
+    item = self.transition[row["axis"]]
+    stamp, previous = row["mono_ns"], item["observed_mono_ns"]
+    gap = previous is not None and not 0 < stamp - previous <= self.profile.max_gap_ns
+    if gap:
+      item.update(ready=False, valid_since_mono_ns=None, last_blocked_mono_ns=stamp, reason="transition_observation_gap")
+    item["observed_mono_ns"] = stamp
+    reason = ("transition_driver_override" if row["driver_override"] is True else
+              "transition_invalid_telemetry" if row["valid"] is not True or row["driver_override"] is not False else
+              "transition_axis_inactive" if row["active"] is not True else
+              "transition_invalid_telemetry" if row["recovery_ready"] is not True else None)
+    if reason is not None:
+      item.update(ready=False, reason=reason, valid_since_mono_ns=None, last_blocked_mono_ns=stamp)
+    else:
+      if item["valid_since_mono_ns"] is None:
+        item["valid_since_mono_ns"] = stamp
+      ready = stamp - item["valid_since_mono_ns"] >= TRANSITION_RECOVERY_NS
+      item.update(ready=ready, reason="transition_ready" if ready else "transition_recovering")
+
+  def _evaluate(self, *, partial=False):
+    if not self._window or self._window[-1].mono_ns == self._last_diagnostic_end_ns:
+      return
+    first, last = self._window[0].mono_ns, self._window[-1].mono_ns
+    incomplete_after_loss = self._needs_fresh_window and last - first < self.interval_ns
+    if incomplete_after_loss and not partial:
+      return
+    diagnostic = _compact_diagnostic(analyze(self._window, self.profile))
+    self.diagnostic_revision += 1
+    diagnostic.update(revision=self.diagnostic_revision, invalidated=incomplete_after_loss, partial_window=partial,
+                      window_start_ns=first, window_end_ns=last, window_includes_pre_history=True,
+                      independence="not_established", settings_history="unknown",
+                      observed_settings_revision=self.observed_settings_revision,
+                      route_observation=deepcopy(self._route_observation),
+                      settings_observation_state=self.settings_observation_state,
+                      recommendations_enabled=False, apply_enabled=False, device_qualified=False)
+    if incomplete_after_loss:
+      diagnostic["invalidation_reason"] = "fresh_window_incomplete"
+    self.diagnostic = diagnostic
+    summary = {axis: {epoch: {key: value for key, value in values.items() if key != "exclusions"}
+                      for epoch, values in axes["epochs"].items()} for axis, axes in diagnostic["axes"].items()}
+    self.history.append({"revision": self.diagnostic_revision, "state": "invalidated" if incomplete_after_loss else "diagnostic",
+                         "partial_window": partial,
+                         "window_start_ns": first, "window_end_ns": last, "summary": summary})
+    self._last_diagnostic_end_ns, self._next_evaluation_ns = last, last + self.interval_ns
+    self._needs_fresh_window = incomplete_after_loss
+    self.state, self.reason = "running", "unvalidated_diagnostic_ready"
+
+  def bookmark(self, *, partial=False):
+    """Bound a preservation job without evaluating or suggesting settings."""
+    if self._bookmark_start_ns is None or not self._window:
+      return None
+    end = self._window[-1].mono_ns
+    if end == self._bookmark_end_ns:
+      return self.preservation_bookmark
+    self.diagnostic_revision += 1
+    self.preservation_bookmark = {"revision": self.diagnostic_revision, "window_start_ns": self._bookmark_start_ns,
+      "window_end_ns": end, "profile_id": self.profile.profile_id, "invalidated": False, "partial_window": partial,
+      "observed_settings_revision": self.observed_settings_revision, "route_observation": deepcopy(self._route_observation),
+      "recording_only": True}
+    self._bookmark_start_ns = self._bookmark_end_ns = end
+    return self.preservation_bookmark
+
+  def tick(self):
+    self.parking.tick()
+    if self.state in TERMINAL_STATES:
+      return
+    now = self.clock_ns()
+    if self.max_session_ns is not None and now - self._started_wall_ns >= self.max_session_ns:
+      self.finish("session_time_limit")
+    elif self._last_received_wall_ns is not None and now - self._last_received_wall_ns > 2_000_000_000 and not self._stale_invalidated:
+      self.gap_events += 1
+      self.invalidate("input_stale")
+      self._stale_invalidated = True
+
+  def finish(self, reason="session_ended"):
+    if self.state in TERMINAL_STATES:
+      return
+    self._drain(self._max_seen_ns)
+    self.bookmark(partial=True)
+    self.state, self.reason = "ended", reason
+    self.parking.stop()
+    self.transition = unknown_transition("transition_session_ended")
+
+  def snapshot(self):
+    if self.state in TERMINAL_STATES:
+      self.parking.stop()
+    parking = self.parking.snapshot()
+    transition = deepcopy(self.transition)
+    source_now = self.clock_ns() if self.source_mode == "live" else self._max_seen_ns
+    for item in transition.values():
+      stamp = item["observed_mono_ns"]
+      if self.state in TERMINAL_STATES:
+        item.update(ready=False, reason="transition_session_ended")
+      elif stamp is None or not 0 <= source_now - stamp <= TRANSITION_MAX_AGE_NS:
+        item.update(ready=False, reason="transition_input_stale")
+    age_ms = None if self._last_received_wall_ns is None else max(0, self.clock_ns() - self._last_received_wall_ns) / 1_000_000
+    counters = {name: getattr(self, name) for name in ("received_events", "observations", "late_events", "overflow_events",
+                                                     "gap_events", "dropped_events", "poll_budget_overruns")}
+    result = {"schema_version": 1, "session_id": self.session_id, "source_mode": self.source_mode,
+            "state": self.state, **counters, "counters": counters, "age_ms": age_ms,
+            "diagnostic_revision": self.diagnostic_revision, "diagnostic": self.diagnostic, "history": list(self.history),
+            "reason": self.reason, "settings_history": "unknown", "recommendations_enabled": False,
+            "apply_enabled": False, "parking_confirmed": self.source_mode == "live" and parking["state"] == "park_observed",
+            "parking": parking, "last_park_observation": self.parking.last_park_observation(),
+            "clock_mode": "accelerated_synthetic" if self.source_mode == "synthetic" else "native_monotonic",
+            "finalized_through_ns": self.diagnostic.get("finalized_through_ns") if self.diagnostic else None,
+            "diagnostic_invalidated": bool(self.diagnostic and self.diagnostic.get("invalidated")),
+            "metadata": {"settings_history": "unknown", "gap_detection": "timestamp_heuristic_no_sequence",
+                         "device_qualified": False, "overlapping_windows": True}}
+    if self.recording_status is not None:
+      result["recording"] = self.recording_status
+    if self.consumer_observations is not None:
+      result["consumer_observations"] = self.consumer_observations
+    if self.worker_runtime is not None:
+      result["metadata"]["worker_runtime"] = deepcopy(self.worker_runtime)
+    result["transition"] = transition
+    return result
