-static void library_task(void *arg) {
-  while (1) {
-    uint32_t flags = 0;
-    esp_err_t err = usb_host_lib_handle_events(pdMS_TO_TICKS(1000), &flags);
-    if (err != ESP_OK && err != ESP_ERR_TIMEOUT) {
-      ESP_LOGE(TAG, "USB library error: %s", esp_err_to_name(err));
-    }
-  }
-}
