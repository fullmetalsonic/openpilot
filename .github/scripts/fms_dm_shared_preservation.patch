-      memcpy(response_data, transfer->data_buffer, response_length);
-    }
-  } else if (!ok) {
-    ESP_LOGE(TAG, "OUT status=%d actual=%d requested=%d", transfer->status, transfer->actual_num_bytes, size);
-  }
-  usb_host_transfer_free(transfer);
-  return ok;
-}
