+      ci.CS.vehicleNaviCanControl, ci.CS.speedcamSkipBox, ci.CS.speedcam_policy.__dict__, ci.CS.hda_info_4a3)
+    assert any(str(b.type)=='accelCruise' and b.pressed for b in decoded.buttonEvents) == (not(master and enabled))
+    driver.tick()
+  else:
