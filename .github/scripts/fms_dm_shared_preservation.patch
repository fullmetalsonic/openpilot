-class Clock:
-  def __init__(self, now=100.0, overshoot=0.0):
-    self.now = now
-    self.overshoot = overshoot
-
-  def monotonic(self):
-    return self.now
-
-  def sleep(self, seconds):
-    assert seconds > 0
-    self.now += seconds + self.overshoot
