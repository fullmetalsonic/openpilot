+"""Local physical-vehicle groups, independent of mutable CarParams configuration.
+
+Only the authenticated server writes this registry. Recorders read it without
+creating groups; unidentified historical observations remain unidentified.
+"""
+from copy import deepcopy
+from pathlib import Path
+import re
+import threading
+import uuid
+
+from .apply_requests import _atomic, _root
+from .candidate_report import _read
+from .vehicle_identity import validate_identity
+
+
+def binding_root(request_root):
+  path = Path(request_root)
+  return path.with_name(path.name + "-native")
+
+
+def _validate(value):
+  if type(value) is not dict or set(value) != {"schema_version", "groups", "confirmation"} or value["schema_version"] != 1:
+    raise ValueError("vehicle_bindings_invalid")
+  groups = value["groups"]
+  if type(groups) is not dict or len(groups) > 128:
+    raise ValueError("vehicle_bindings_invalid")
+  vins = set()
+  for key, group in groups.items():
+    if (type(key) is not str or re.fullmatch(r"[a-f0-9]{32}", key) is None or type(group) is not dict
+        or set(group) != {"car_fingerprint", "vin_sha256"} or type(group["car_fingerprint"]) is not str
+        or not 1 <= len(group["car_fingerprint"]) <= 256):
+      raise ValueError("vehicle_group_invalid")
+    vin = group["vin_sha256"]
+    if vin is not None:
+      if type(vin) is not str or re.fullmatch(r"[a-f0-9]{64}", vin) is None or vin in vins:
+        raise ValueError("vehicle_group_vin_invalid")
+      vins.add(vin)
+  confirmation = value["confirmation"]
+  if confirmation is not None and (type(confirmation) is not dict or set(confirmation) != {"boot_id", "group_id"}
+      or confirmation["group_id"] not in groups or type(confirmation["boot_id"]) is not str
+      or re.fullmatch(r"[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}", confirmation["boot_id"]) is None):
+    raise ValueError("vehicle_confirmation_invalid")
+  return value
+
+
+def _resolve(descriptor, value, boot_id):
+  result = validate_identity(descriptor)
+  result.update(physical_group_id=None, physical_group_basis=None)
+  if result["state"] != "observed":
+    return result
+  vin = result["vin_sha256"]
+  matches = [key for key, group in value["groups"].items() if vin is not None and group["vin_sha256"] == vin]
+  basis = "vin"
+  if not matches:
+    confirmation = value["confirmation"]
+    if confirmation is None or confirmation["boot_id"] != boot_id:
+      return result
+    key = confirmation["group_id"]
+    group = value["groups"][key]
+    # A newly observed VIN must be explicitly attached, never silently adopted.
+    if group["car_fingerprint"] != result["car_fingerprint"] or vin != group["vin_sha256"]:
+      return result
+    matches, basis = [key], "local_confirmation"
+  group = value["groups"][matches[0]]
+  if group["car_fingerprint"] == result["car_fingerprint"]:
+    result.update(physical_group_id=matches[0], physical_group_basis=basis)
+  return validate_identity(result)
+
+
+def load_bound_identity(descriptor, root, boot_id):
+  """Read-only recorder entry point; absent registry leaves the CP unbound."""
+  path = Path(root) / "bindings.json"
+  if any(part.is_symlink() or (hasattr(part, "is_junction") and part.is_junction()) for part in (path, *path.parents)):
+    raise ValueError("vehicle_bindings_link")
+  if not path.exists():
+    return _resolve(descriptor, {"groups": {}, "confirmation": None}, boot_id)
+  try:
+    value = _validate(_read(path, 128 * 1024)[0])
+  except FileNotFoundError:
+    return _resolve(descriptor, {"groups": {}, "confirmation": None}, boot_id)
+  return _resolve(descriptor, value, boot_id)
+
+
+class VehicleBindings:
+  def __init__(self, root, boot_id):
+    if type(boot_id) is not str or re.fullmatch(r"[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}", boot_id) is None:
+      raise ValueError("vehicle_boot_identity_required")
+    self.root, self._lease = _root(root, {"schema_version": 1, "scope": "native_advisor_vehicles"})
+    self.boot_id, self._lock, self._closed = boot_id, threading.RLock(), False
+    self.path = self.root / "bindings.json"
+    try:
+      if self.path.exists():
+        self._value = _validate(_read(self.path, 128 * 1024)[0])
+      else:
+        self._value = {"schema_version": 1, "groups": {}, "confirmation": None}
+        _atomic(self.path, self._value)
+    except BaseException:
+      self._lease.close()
+      raise
+
+  def _check(self):
+    if self._closed or _validate(_read(self.path, 128 * 1024)[0]) != self._value:
+      raise ValueError("vehicle_bindings_changed_or_closed")
+
+  def resolve(self, descriptor):
+    with self._lock:
+      self._check()
+      return _resolve(descriptor, self._value, self.boot_id)
+
+  def groups(self):
+    with self._lock:
+      self._check()
+      return [{"group_id": key, "car_fingerprint": group["car_fingerprint"], "vin_known": group["vin_sha256"] is not None}
+              for key, group in self._value["groups"].items()]
+
+  def confirm(self, descriptor, group_id=None):
+    descriptor = validate_identity(descriptor)
+    if descriptor["state"] != "observed":
+      raise ValueError("vehicle_identity_unavailable")
+    with self._lock:
+      self._check()
+      current = _resolve(descriptor, self._value, self.boot_id)
+      known_vin = next((key for key, group in self._value["groups"].items()
+                        if descriptor["vin_sha256"] is not None and group["vin_sha256"] == descriptor["vin_sha256"]), None)
+      if group_id == "new":
+        if known_vin or current["physical_group_id"]:
+          raise ValueError("vehicle_already_bound")
+        group_id = uuid.uuid4().hex
+      elif group_id is None:
+        group_id = known_vin or current["physical_group_id"]
+        if group_id is None:
+          if self._value["groups"]:
+            raise ValueError("vehicle_group_selection_required")
+          group_id = uuid.uuid4().hex
+      elif group_id not in self._value["groups"]:
+        raise ValueError("vehicle_group_not_found")
+      if known_vin is not None and known_vin != group_id:
+        raise ValueError("vehicle_vin_already_bound")
+      value = deepcopy(self._value)
+      group = value["groups"].get(group_id)
+      if group is not None and (group["car_fingerprint"] != descriptor["car_fingerprint"]
+          or group["vin_sha256"] is not None and group["vin_sha256"] != descriptor["vin_sha256"]):
+        raise ValueError("vehicle_group_mismatch")
+      value["groups"][group_id] = {"car_fingerprint": descriptor["car_fingerprint"], "vin_sha256": descriptor["vin_sha256"]}
+      value["confirmation"] = {"boot_id": self.boot_id, "group_id": group_id}
+      _validate(value)
+      try:
+        _atomic(self.path, value)
+      except BaseException:
+        # Do not use in-memory authorization after an uncertain registry write.
+        self._closed = True
+        raise
+      self._value = value
+      return _resolve(descriptor, value, self.boot_id)
+
+  def close(self):
+    self._closed = True
+    self._lease.close()
diff --git a/openpilot/selfdrive/carrot/control_advisor/vehicle_identity.py b/openpilot/selfdrive/carrot/control_advisor/vehicle_identity.py
--- /dev/null
+++ b/openpilot/selfdrive/carrot/control_advisor/vehicle_identity.py
@@ -0,0 +1,111 @@
+"""Bounded CarParams descriptors. Fingerprints name configurations, not vehicles."""
+from copy import deepcopy
+from functools import lru_cache
+import hashlib
+import json
+from pathlib import Path
+import re
+
+
+MAX_CP_BYTES = 1024 * 1024
+FIELDS = {"identity_version", "state", "reason", "config_sha256", "schema_sha256", "raw_sha256", "vin_sha256",
+          "car_fingerprint", "physical_group_id", "physical_group_basis"}
+_SHA = re.compile(r"[a-f0-9]{64}")
+
+
+def unavailable_identity(reason="car_params_unavailable"):
+  if type(reason) is not str or re.fullmatch(r"[a-z0-9_]{1,128}", reason) is None:
+    raise ValueError("vehicle_identity_reason_invalid")
+  return {"identity_version": 1, "state": "unavailable", "reason": reason,
+          **dict.fromkeys(FIELDS - {"identity_version", "state", "reason"})}
+
+
+def validate_identity(value, *, require_bound=False):
+  if type(value) is not dict or set(value) != FIELDS or type(value["identity_version"]) is not int or value["identity_version"] != 1:
+    raise ValueError("vehicle_identity_invalid")
+  if value["state"] == "unavailable":
+    if value != unavailable_identity(value["reason"]) or require_bound:
+      raise ValueError("vehicle_identity_unavailable")
+    return deepcopy(value)
+  if value["state"] != "observed" or value["reason"] is not None:
+    raise ValueError("vehicle_identity_invalid")
+  for name in ("config_sha256", "schema_sha256", "raw_sha256", "vin_sha256"):
+    if name == "vin_sha256" and value[name] is None:
+      continue
+    if type(value[name]) is not str or _SHA.fullmatch(value[name]) is None:
+      raise ValueError("vehicle_identity_hash_invalid")
+  label = value["car_fingerprint"]
+  if type(label) is not str or not 1 <= len(label) <= 256 or any(ord(char) < 32 for char in label):
+    raise ValueError("vehicle_fingerprint_invalid")
+  group, basis = value["physical_group_id"], value["physical_group_basis"]
+  if group is None and basis is None:
+    if require_bound:
+      raise ValueError("vehicle_physical_group_unconfirmed")
+  elif (type(group) is not str or re.fullmatch(r"[a-f0-9]{32}", group) is None or type(basis) is not str
+        or basis not in {"vin", "local_confirmation"} or basis == "vin" and value["vin_sha256"] is None):
+    raise ValueError("vehicle_physical_group_invalid")
+  return deepcopy(value)
+
+
+def same_vehicle_identity(first, second, *, require_group=True):
+  try:
+    first, second = validate_identity(first, require_bound=require_group), validate_identity(second, require_bound=require_group)
+  except ValueError:
+    return False
+  if first["state"] != "observed" or second["state"] != "observed":
+    return False
+  names = ["config_sha256", "schema_sha256", "vin_sha256", "car_fingerprint"]
+  if require_group:
+    names.extend(("physical_group_id", "physical_group_basis"))
+  return all(first[name] == second[name] for name in names)
+
+
+@lru_cache(maxsize=1)
+def _schema():
+  import capnp
+  path = Path(__file__).resolve().parents[4] / "opendbc_repo/opendbc/car/car.capnp"
+  raw = path.read_bytes()
+  parser = capnp.SchemaParser()
+  schema = parser.load(str(path), "/car.capnp", imports=[str(path.parent), str(path.parent / "include")])
+  return parser, schema, hashlib.sha256(raw).hexdigest()
+
+
+def _plain(value):
+  if isinstance(value, bytes):
+    return {"capnp_data_hex": value.hex()}
+  if isinstance(value, dict):
+    return {key: _plain(item) for key, item in value.items()}
+  if isinstance(value, list):
+    return [_plain(item) for item in value]
+  return value
+
+
+def describe_car_params(raw):
+  """Decode this exact captured message; never reread Params or retain a VIN."""
+  if raw is None:
+    return unavailable_identity()
+  if type(raw) is not bytes or not 0 < len(raw) <= MAX_CP_BYTES:
+    return unavailable_identity("car_params_size_or_type_invalid")
+  try:
+    _, schema, schema_hash = _schema()
+    with schema.CarParams.from_bytes(raw, traversal_limit_in_words=MAX_CP_BYTES // 8) as message:
+      data = _plain(message.to_dict(verbose=True))
+    vin = data.pop("carVin", "")
+    fingerprint = data.get("carFingerprint")
+    if type(fingerprint) is not str or not fingerprint or len(fingerprint) > 256:
+      return unavailable_identity("car_fingerprint_unavailable")
+    if str(data.get("brand", "")).strip().lower() == "mock" or fingerprint.strip().lower() == "mock":
+      return unavailable_identity("mock_car_params")
+    canonical = json.dumps(data, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+    if len(canonical) > 4 * MAX_CP_BYTES:
+      return unavailable_identity("car_params_decoded_limit")
+    vin = vin.strip().upper() if isinstance(vin, str) else ""
+    valid_vin = re.fullmatch(r"[A-HJ-NPR-Z0-9]{17}", vin) is not None and vin != "0" * 17
+    result = {"identity_version": 1, "state": "observed", "reason": None,
+              "config_sha256": hashlib.sha256(canonical).hexdigest(), "schema_sha256": schema_hash,
+              "raw_sha256": hashlib.sha256(raw).hexdigest(),
+              "vin_sha256": hashlib.sha256(b"control_advisor.vehicle_vin.v1\0" + vin.encode("ascii")).hexdigest() if valid_vin else None,
+              "car_fingerprint": fingerprint, "physical_group_id": None, "physical_group_basis": None}
+    return validate_identity(result)
+  except Exception:
+    return unavailable_identity("car_params_decode_unavailable")
diff --git a/openpilot/selfdrive/carrot/control_advisor/vehicle_store.py b/openpilot/selfdrive/carrot/control_advisor/vehicle_store.py
--- /dev/null
+++ b/openpilot/selfdrive/carrot/control_advisor/vehicle_store.py
@@ -0,0 +1,449 @@
+"""Explicit native storage only: raw CAS receipts are never consumer acknowledgements.
+
+Local observation revisions do not imply native transactions or ABA protection.
+An intent without a durable successful receipt is never recovered from equal values.
+"""
+import base64
+from copy import deepcopy
+from pathlib import Path
+import re
+import threading
+import time
+import uuid
+
+from .apply_requests import KEYS, RequestConflict, RequestDisabled, _atomic, _canonical, _context, _hash, _identifier, _integer, _root, _sha
+from .candidate_report import _read
+from .vehicle_identity import describe_car_params, validate_identity, same_vehicle_identity
+
+
+class NativeStoreFailed(ValueError):
+  """Native API explicitly reported no mutation."""
+
+
+class NativeStoreUncertain(ValueError):
+  """A mutation might have happened; never retry automatically."""
+
+
+def _encode(raw):
+  if type(raw) is not dict or set(raw) != KEYS:
+    raise ValueError("native_raw_inventory_invalid")
+  result = {}
+  for key, value in raw.items():
+    if value is not None and (type(value) is not bytes or len(value) > 256):
+      raise ValueError("native_raw_value_invalid")
+    result[key] = None if value is None else base64.b64encode(value).decode("ascii")
+  return result
+
+
+def _decode(encoded):
+  if type(encoded) is not dict or set(encoded) != KEYS:
+    raise ValueError("native_raw_inventory_invalid")
+  try:
+    raw = {key: None if value is None else base64.b64decode(value, validate=True) for key, value in encoded.items()}
+  except (ValueError, TypeError) as error:
+    raise ValueError("native_raw_encoding_invalid") from error
+  if _encode(raw) != encoded:
+    raise ValueError("native_raw_encoding_invalid")
+  return raw
+
+
+def _parsed(raw):
+  result = {}
+  for key, value in raw.items():
+    if value is None:
+      result[key] = None
+      continue
+    if re.fullmatch(rb"[ \t\r\n]*[+-]?[0-9]+[ \t\r\n]*", value) is None:
+      raise ValueError("native_parameter_not_integer")
+    parsed = int(value)
+    if not -1000000 <= parsed <= 1000000:
+      raise ValueError("native_parameter_integer_range")
+    result[key] = parsed
+  return result
+
+
+class NativeParamsStore:
+  scope = "vehicle"
+
+  @property
+  def write_ready(self):
+    return self.enabled and not self._closed and not self._poisoned
+
+  def __init__(self, root, target_id, params, *, session_context, write_guard, enabled=False, clock_ns=time.monotonic_ns, identity_provider=None):
+    _identifier(target_id)
+    if not all(callable(getattr(params, name, None)) for name in ("get_many_raw", "compare_and_set_raw")):
+      raise ValueError("native_params_raw_api_required")
+    if not callable(session_context) or not callable(write_guard):
+      raise ValueError("native_store_context_and_guard_required")
+    self.params, self.target_id, self.session_context, self.write_guard = params, target_id, session_context, write_guard
+    self.clock_ns, self.enabled = clock_ns, bool(enabled)
+    if identity_provider is not None and not callable(identity_provider):
+      raise ValueError("native_identity_provider_invalid")
+    self.identity_provider, self._current_cp = identity_provider, None
+    self._lock, self._lease, self._closed, self._poisoned, self._prepared = threading.RLock(), None, False, False, None
+    self.root = self.path = None
+    self._state = None
+    if not self.enabled:
+      return
+    # Never place the advisor journal inside Params, even with a differently spelled root.
+    getter = getattr(params, "get_param_path", None)
+    if not callable(getter):
+      raise ValueError("native_params_path_required")
+    native_root = Path(getter()).resolve()
+    journal_root = Path(root).resolve()
+    if native_root == journal_root or native_root in journal_root.parents or journal_root in native_root.parents:
+      raise ValueError("native_store_root_overlap")
+    self.root, self._lease = _root(root, {"schema_version": 1, "scope": "native_advisor_params_store"})
+    self.path = self.root / "vehicle-store.json"
+    try:
+      if self.path.exists():
+        self._state = _read(self.path, 4 * 1024 * 1024)[0]
+        self._validate_state()
+        self._baseline()
+      else:
+        if (self.root / "baseline.json").exists():
+          raise ValueError("native_store_orphan_baseline")
+        self._state = {"schema_version": 1, "target_id": target_id, "store_id": uuid.uuid4().hex,
+                       "revision": 0, "raw": None, "baseline_sha256": None, "operations": {}, "restores": {}}
+        self._save(self._state)
+    except BaseException:
+      self._lease.close()
+      raise
+
+  def _available(self):
+    if not self.enabled or self._closed or self._poisoned:
+      raise RequestDisabled("native_store_uncertain" if self._poisoned else "native_store_disabled")
+
+  def _validate_state(self):
+    state = self._state
+    if (type(state) is not dict or set(state) - {"identity_version", "vehicle_identity"} != {"schema_version", "target_id", "store_id", "revision", "raw", "baseline_sha256", "operations", "restores"}
+        or state["schema_version"] != 1 or state["target_id"] != self.target_id):
+      raise ValueError("native_store_identity_invalid")
+    _identifier(state["store_id"])
+    _integer(state["revision"])
+    if "vehicle_identity" in state or "identity_version" in state:
+      if type(state.get("identity_version")) is not int or state["identity_version"] != 1:
+        raise ValueError("native_vehicle_identity_invalid")
+      validate_identity(state.get("vehicle_identity"))
+    if state["raw"] is not None:
+      _parsed(_decode(state["raw"]))
+    for name in ("operations", "restores"):
+      if type(state[name]) is not dict or len(state[name]) > 128:
+        raise ValueError("native_store_operation_budget")
+      for request_id, operation in state[name].items():
+        _identifier(request_id)
+        if type(operation) is not dict or operation.get("state") not in {"intent", "stored", "failed", "conflict", "uncertain"} or operation.get("sha256") != _hash(operation.get("intent")):
+          raise ValueError("native_store_operation_corrupt")
+        if operation["state"] == "stored" and (type(operation.get("receipt")) is not dict or operation.get("receipt_sha256") != _hash(operation["receipt"])):
+          raise ValueError("native_store_receipt_corrupt")
+
+  def _save(self, state):
+    if len(_canonical(state)) > 4 * 1024 * 1024:
+      raise RequestConflict("native_store_byte_budget")
+    try:
+      _atomic(self.path, state)
+    except BaseException:
+      self._poisoned = True
+      raise
+    self._state = deepcopy(state)
+
+  def _assert_disk(self):
+    if _read(self.path, 4 * 1024 * 1024)[0] != self._state:
+      raise RequestConflict("native_store_journal_changed")
+    self._baseline()
+
+  def _session(self):
+    value = self.session_context()
+    if type(value) is not dict or not {"session_id", "generation", "source_mode", "state"} <= set(value):
+      raise RequestDisabled("native_session_unavailable")
+    _identifier(value["session_id"])
+    _integer(value["generation"])
+    if value["source_mode"] != "live" or value["state"] != "running" or value.get("target_id", self.target_id) != self.target_id:
+      raise RequestDisabled("native_session_not_current_live")
+    return value
+
+  def _observe(self):
+    self._available()
+    self._assert_disk()
+    observed = self.params.get_many_raw(sorted((*KEYS, "CarParams")))
+    if type(observed) is not dict or set(observed) != KEYS | {"CarParams"}:
+      raise ValueError("native_raw_inventory_invalid")
+    raw, cp = {key: observed[key] for key in KEYS}, observed["CarParams"]
+    identity = describe_car_params(cp)
+    if self.identity_provider is not None and identity["state"] == "observed":
+      bound = validate_identity(self.identity_provider(cp))
+      if any(bound[field] != identity[field] for field in identity if field not in {"physical_group_id", "physical_group_basis"}):
+        raise RequestConflict("native_identity_provider_mismatch")
+      identity = bound
+    encoded, values = _encode(raw), _parsed(raw)
+    if encoded != self._state["raw"] or identity != self._state.get("vehicle_identity"):
+      state = deepcopy(self._state)
+      state.update(raw=encoded, revision=state["revision"] + 1, identity_version=1, vehicle_identity=identity)
+      self._save(state)
+    self._current_cp = cp
+    return raw, values
+
+  def snapshot(self):
+    with self._lock:
+      raw, values = self._observe()
+      session = self._session()
+      return {"target_id": self.target_id, "store_id": self._state["store_id"], "session_id": session["session_id"],
+              "generation": session["generation"], "revision": self._state["revision"], "values": values,
+              "raw_bytes": deepcopy(raw), "revision_scope": "local_raw_observation", "native_revision": None,
+              "identity_version": 1, "vehicle_identity": deepcopy(self._state["vehicle_identity"])}
+
+  def request_binding(self):
+    value = self.snapshot()
+    return {"session_id": value["session_id"], "generation": value["generation"], "source_mode": "live", "state": "running",
+            "settings_revision": value["revision"], "settings_raw": value["values"], "observed_mono_ns": self.clock_ns(), "settings_observation_fresh": True,
+            "identity_version": 1, "vehicle_identity": deepcopy(self._state["vehicle_identity"])}
+
+  def _authorize(self, context):
+    self._available()
+    if context["scope"] != "vehicle" or context["target_id"] != self.target_id:
+      raise RequestConflict("native_request_target_or_session_changed")
+    if context.get("operation") == "offroad_restore":
+      state = self.params.get_many_raw(["CarParams", "IsOffroad", "IsOnroad"])
+      if state != {"CarParams": self._current_cp, "IsOffroad": b"1", "IsOnroad": b"0"}:
+        raise RequestDisabled("native_offroad_restore_state_changed")
+    else:
+      session = self._session()
+      if context["session_id"] != session["session_id"] or context["session_generation"] != session["generation"]:
+        raise RequestConflict("native_request_target_or_session_changed")
+    provenance = context.get("provenance", {})
+    if provenance.get("identity_version") != 1 or "vehicle_identity" not in provenance:
+      raise RequestDisabled("native_source_vehicle_identity_missing")
+    try:
+      validate_identity(provenance["vehicle_identity"], require_bound=True)
+      validate_identity(self._state.get("vehicle_identity"), require_bound=True)
+    except ValueError as error:
+      raise RequestDisabled("native_vehicle_identity_unconfirmed") from error
+    if not same_vehicle_identity(provenance["vehicle_identity"], self._state["vehicle_identity"]):
+      raise RequestConflict("native_vehicle_identity_changed")
+    if self.write_guard(deepcopy(context)) is not None:
+      raise RequestDisabled("native_write_guard_not_authorized")
+
+  def prepare_request(self, context):
+    with self._lock:
+      context = _context(context)
+      snapshot = self.snapshot()
+      self._authorize(context)
+      if (snapshot["revision"] != context["settings_revision"] or snapshot["values"][context["item_key"]] != context["current_raw"]
+          or any(snapshot["values"][key] != value for key, value in context["dependencies"].items())):
+        raise RequestConflict("native_observation_changed")
+      self._prepared = {"context": context, "raw": _encode(snapshot["raw_bytes"]), "car_params": self._current_cp}
+
+  def _baseline(self):
+    digest = self._state["baseline_sha256"]
+    path = self.root / "baseline.json"
+    if digest is None:
+      if path.exists():
+        raise ValueError("native_store_orphan_baseline")
+      return None
+    value = _read(path, 64 * 1024)[0]
+    if (_hash(value) != digest or value.get("store_id") != self._state["store_id"] or value.get("target_id") != self.target_id):
+      raise ValueError("native_baseline_changed")
+    _decode(value["raw"])
+    return value
+
+  def _ensure_baseline(self):
+    if self._baseline() is not None:
+      return
+    baseline = {"schema_version": 1, "scope": "native_raw_baseline", "target_id": self.target_id,
+                "store_id": self._state["store_id"], "raw": deepcopy(self._state["raw"]), "observed_mono_ns": self.clock_ns()}
+    try:
+      _atomic(self.root / "baseline.json", baseline)
+      state = deepcopy(self._state)
+      state["baseline_sha256"] = _hash(baseline)
+      self._save(state)
+    except BaseException:
+      self._poisoned = True
+      raise
+
+  def request_receipt(self, request_id):
+    with self._lock:
+      self._available()
+      self._assert_disk()
+      operation = self._state["operations"].get(request_id)
+      return deepcopy(operation["receipt"]) if operation and operation["state"] == "stored" else None
+
+  def _existing(self, group, operation_id, intent):
+    operation = self._state[group].get(operation_id)
+    if operation is None:
+      return None
+    if operation["sha256"] != _hash(intent):
+      raise RequestConflict("native_operation_id_conflict")
+    if operation["state"] == "stored":
+      return deepcopy(operation["receipt"])
+    if operation["state"] == "failed":
+      raise NativeStoreFailed("native_write_failed_known_nochange")
+    if operation["state"] == "conflict":
+      raise RequestConflict("native_compare_and_swap_conflict")
+    raise NativeStoreUncertain("native_intent_without_successful_receipt")
+
+  def _persist_operation(self, group, operation_id, operation):
+    state = deepcopy(self._state)
+    state[group][operation_id] = deepcopy(operation)
+    self._save(state)
+
+  def _finish_native(self, state):
+    try:
+      self._save(state)
+    except Exception as error:
+      # Even a known journal/quota failure is uncertain after native mutation.
+      self._poisoned = True
+      raise NativeStoreUncertain("native_result_receipt_not_durable") from error
+
+  def _finish_operation(self, group, operation_id, operation):
+    state = deepcopy(self._state)
+    state[group][operation_id] = deepcopy(operation)
+    self._finish_native(state)
+
+  def _cas(self, group, operation_id, intent, context, key, new, expected):
+    if len(self._state[group]) >= 128:
+      raise RequestConflict("native_store_operation_budget")
+    operation = {"state": "intent", "intent": intent, "sha256": _hash(intent), "receipt": None, "receipt_sha256": None}
+    if len(_canonical(self._state)) + len(_canonical(operation)) + 8192 > 4 * 1024 * 1024:
+      raise RequestConflict("native_store_receipt_capacity")
+    self._ensure_baseline()
+    self._persist_operation(group, operation_id, operation)
+    try:
+      self._authorize(context)
+    except (RequestConflict, RequestDisabled):
+      operation["state"] = "failed"
+      self._persist_operation(group, operation_id, operation)
+      raise
+    try:
+      result = self.params.compare_and_set_raw(key, new, expected)
+    except Exception as error:
+      operation["state"] = "uncertain"
+      self._finish_operation(group, operation_id, operation)
+      raise NativeStoreUncertain("native_call_outcome_unknown") from error
+    if (type(result) is not dict or set(result) != {"state", "errno", "changed"} or type(result["changed"]) is not bool
+        or type(result["errno"]) is not int or result["state"] not in {"stored", "failed", "conflict", "uncertain"}):
+      result = {"state": "uncertain", "errno": 0, "changed": False}
+    if result["state"] == "stored" and (result["errno"] != 0 or not result["changed"]):
+      result = {**result, "state": "uncertain"}
+    if result["state"] != "stored":
+      outcome = result["state"] if result["state"] in {"failed", "conflict"} and not result["changed"] else "uncertain"
+      operation.update(state=outcome, native_result=result)
+      self._finish_operation(group, operation_id, operation)
+      if outcome == "failed":
+        raise NativeStoreFailed("native_write_failed_known_nochange")
+      if outcome == "conflict":
+        raise RequestConflict("native_compare_and_swap_conflict")
+      raise NativeStoreUncertain("native_write_outcome_uncertain")
+    # Native successful CAS is the storage receipt, not an inferred value equality.
+    before = self._state["revision"]
+    receipt = {"schema_version": 1, "request_id": operation_id, "request_sha256": intent["request_sha256"],
+               "target_id": self.target_id, "store_id": self._state["store_id"], "item_key": key,
+               "previous_raw": intent["previous_raw"], "value": intent["value"], "previous_revision": before, "revision": before + 1,
+               "dependency_digest": intent["dependency_digest"], "stored_mono_ns": self.clock_ns(),
+               "revision_scope": "local_raw_observation", "native_revision": None, "native_result": result,
+               "previous_bytes": intent["previous_bytes"], "new_bytes": intent["new_bytes"], "consumer_application_ack": False}
+    receipt.update(identity_version=1, vehicle_identity=deepcopy(self._state["vehicle_identity"]))
+    state = deepcopy(self._state)
+    state["raw"][key], state["revision"] = intent["new_bytes"], before + 1
+    operation.update(state="stored", receipt=receipt, receipt_sha256=_hash(receipt))
+    state[group][operation_id] = operation
+    self._finish_native(state)
+    return deepcopy(receipt)
+
+  def compare_and_swap(self, *, request_id, request_sha256, item_key, expected_current_raw, expected_settings_revision,
+                       expected_dependencies, dependency_digest, candidate_raw):
+    _identifier(request_id)
+    _sha(request_sha256)
+    _sha(dependency_digest)
+    if item_key not in KEYS or type(expected_dependencies) is not dict or set(expected_dependencies) - KEYS:
+      raise ValueError("native_request_parameter_invalid")
+    _integer(candidate_raw, -1000000, 1000000)
+    if expected_current_raw is not None:
+      _integer(expected_current_raw, -1000000, 1000000)
+    _integer(expected_settings_revision, 1)
+    with self._lock:
+      self._available()
+      self._assert_disk()
+      saved = self._state["operations"].get(request_id)
+      if saved is not None:
+        if saved["intent"]["request_sha256"] != request_sha256:
+          raise RequestConflict("native_operation_id_conflict")
+        return self._existing("operations", request_id, saved["intent"])
+      prepared = self._prepared
+      if prepared is None:
+        raise RequestDisabled("native_trusted_context_not_prepared")
+      context = prepared["context"]
+      expected_context = {"item_key": item_key, "current_raw": expected_current_raw, "candidate_raw": candidate_raw,
+                          "settings_revision": expected_settings_revision, "dependencies": expected_dependencies, "dependency_digest": dependency_digest}
+      if any(context[key] != value for key, value in expected_context.items()):
+        raise RequestConflict("native_prepared_context_mismatch")
+      raw, values = self._observe()
+      if self._state["revision"] != expected_settings_revision or _encode(raw) != prepared["raw"] or self._current_cp != prepared["car_params"]:
+        raise RequestConflict("native_observation_changed")
+      self._authorize(context)
+      encoded_new = base64.b64encode(str(candidate_raw).encode("ascii")).decode("ascii")
+      intent = {"request_sha256": request_sha256, "item_key": item_key, "previous_raw": expected_current_raw, "value": candidate_raw,
+                "previous_bytes": prepared["raw"][item_key], "new_bytes": encoded_new, "dependency_digest": dependency_digest,
+                "guard_context": context, "expected_revision": expected_settings_revision,
+                "identity_version": 1, "vehicle_identity": deepcopy(self._state["vehicle_identity"])}
+      # Every observed allowlisted dependency is included, even if a resolver passed a subset.
+      return self._cas("operations", request_id, intent, context, item_key, str(candidate_raw).encode("ascii"), {**raw, "CarParams": self._current_cp})
+
+  def restore(self, request_id, restore_id, *, offroad=False, boot_id=None):
+    _identifier(request_id)
+    _identifier(restore_id)
+    if type(offroad) is not bool or offroad and (type(boot_id) is not str or not boot_id):
+      raise ValueError("native_restore_mode_invalid")
+    with self._lock:
+      self._available()
+      self._assert_disk()
+      operation = self._state["operations"].get(request_id)
+      if operation is None or operation["state"] != "stored":
+        raise RequestConflict("native_restore_successful_operation_required")
+      original = operation["intent"]
+      intent = {"request_sha256": _hash({"request_id": request_id, "restore_id": restore_id, "operation_sha256": operation["sha256"]}),
+                "item_key": original["item_key"], "previous_raw": original["value"], "value": original["previous_raw"],
+                "previous_bytes": original["new_bytes"], "new_bytes": original["previous_bytes"],
+                "dependency_digest": original["dependency_digest"], "original_request_id": request_id}
+      if offroad:
+        intent.update(execution_mode="offroad_restore", boot_id=boot_id)
+      existing = self._existing("restores", restore_id, intent)
+      if existing is not None:
+        return existing
+      raw, _ = self._observe()
+      key = original["item_key"]
+      if _encode(raw)[key] != original["new_bytes"]:
+        raise RequestConflict("native_restore_current_value_changed")
+      context = deepcopy(original["guard_context"])
+      context.update(operation="offroad_restore" if offroad else "restore", original_request_id=request_id,
+                     restore_id=restore_id, current_raw=int(raw[key]), candidate_raw=original["previous_raw"])
+      if offroad:
+        context["offroad_boot_id"] = boot_id
+      else:
+        session = self._session()
+        context.update(session_id=session["session_id"], session_generation=session["generation"])
+      self._authorize(context)
+      previous = None if original["previous_bytes"] is None else base64.b64decode(original["previous_bytes"], validate=True)
+      expected = {**raw, "CarParams": self._current_cp}
+      if offroad:
+        expected.update(IsOffroad=b"1", IsOnroad=b"0")
+      return self._cas("restores", restore_id, intent, context, key, previous, expected)
+
+  def export_backup(self):
+    with self._lock:
+      self._available()
+      self._assert_disk()
+      baseline = self._baseline()
+      if baseline is None:
+        raise RequestDisabled("native_baseline_not_created")
+      raw = _decode(baseline["raw"])
+      return {"schema_version": 1, "baseline_sha256": self._state["baseline_sha256"], "baseline": deepcopy(baseline),
+              "raw_bytes": raw, "integer_settings": {key: value for key, value in _parsed(raw).items() if value is not None},
+              "absent_keys": sorted(key for key, value in raw.items() if value is None), "legacy_absence_restore_supported": False,
+              "consumer_application_ack": False, "device_qualified": False}
+
+  def close(self):
+    with self._lock:
+      if not self._closed:
+        self._closed = True
+        if self._lease is not None:
+          self._lease.close()
diff --git a/openpilot/selfdrive/carrot/control_advisor/worker.py b/openpilot/selfdrive/carrot/control_advisor/worker.py
--- /dev/null
+++ b/openpilot/selfdrive/carrot/control_advisor/worker.py
@@ -0,0 +1,267 @@
+"""Owned read-only session worker; stdout is bounded JSONL, stdin EOF stops it."""
+
+import argparse
+from contextlib import redirect_stdout
+import json
+import math
+import os
+import queue
+import sys
+import threading
+import time
+
+from .live import LiveEvent, LiveSession, NativeTransport, TERMINAL_STATES
+from .recording import RecordingSession
+from .consumer_collector import ConsumerCollector
+from .worker_runtime import configure_worker_runtime
+
+
+MAX_STATUS_BYTES = 256 * 1024
+
+
+def _recording_identity_provider(*, environment=None, params=None, boot_id=None):
+  """Recorder-thread CP reads only; consumers independently capture their used CP."""
+  from .consumer_observer import _native_runtime, _read_boot_id
+  from .vehicle_identity import describe_car_params, unavailable_identity
+  environment = os.environ if environment is None else environment
+  if params is None:
+    if not _native_runtime():
+      return None
+    try:
+      from openpilot.common.params import Params
+      params = Params()
+    except Exception:
+      return lambda: unavailable_identity("car_params_backend_unavailable")
+  from .runtime_config import NATIVE_DEFAULTS
+  from .vehicle_binding import binding_root, load_bound_identity
+  from pathlib import Path
+  request_root = environment.get("CARROT_CONTROL_ADVISOR_REQUEST_ROOT")
+  if request_root is None and _native_runtime():
+    request_root = NATIVE_DEFAULTS["requests"]
+  root = binding_root(request_root) if isinstance(request_root, str) and Path(request_root).is_absolute() else None
+  boot = _read_boot_id() if boot_id is None else boot_id
+  def identity():
+    try:
+      raw = params.get_many_raw(["CarParams"])["CarParams"]
+      descriptor = describe_car_params(raw)
+      return load_bound_identity(descriptor, root, boot) if root is not None else descriptor
+    except Exception:
+      return unavailable_identity("car_params_provider_unavailable")
+  return identity
+
+
+def _synthetic_tick(index):
+  """Explicit demo input only: 600 logical seconds, accelerated wall clock."""
+  logical = index * 0.05
+  mono_ns = 1_000_000_000 + index * 50_000_000
+  lateral_target = 0.4 * math.sin(logical / 8)
+  longitudinal_target = 0.3 * math.sin(logical / 20)
+  data = (
+    ("carControl", {"enabled": True, "latActive": True, "longActive": True}),
+    ("controlsState", {"activeLaneLine": False, "lateralControlState": {"torqueState": {
+      "desiredLateralAccel": lateral_target, "actualLateralAccel": 0.38 * math.sin((logical - 0.2) / 8),
+      "active": True, "saturated": False}}}),
+    ("longitudinalPlan", {"aTarget": longitudinal_target, "shouldStop": False, "xState": 0}),
+    ("carState", {"canValid": True, "gearShifter": "drive", "aEgo": 0.27 * math.sin((logical - 0.1) / 20),
+      "vEgo": 15.0, "steeringPressed": 120 <= logical < 121,
+      "gasPressed": 220 <= logical < 221, "brakePressed": 400 <= logical < 400.5}),
+  )
+  return [LiveEvent(service, mono_ns, True, values, mono_ns,
+                    max(1, len(json.dumps(values, separators=(",", ":")).encode()))) for service, values in data]
+
+
+def _watch_stdin(stop, commands=None):
+  try:
+    # A buffered reader held by a daemon can fatally lock interpreter shutdown
+    # when a natural session end occurs before the parent closes its pipe.
+    descriptor = sys.stdin.fileno()
+    buffered = b""
+    if os.name == "nt":
+      os.set_blocking(descriptor, False)
+    while not stop.is_set():
+      try:
+        chunk = os.read(descriptor, 4096)
+      except BlockingIOError:
+        stop.wait(.05)
+        continue
+      if not chunk:
+        break
+      buffered += chunk
+      if len(buffered) > 8192:
+        break
+      while b"\n" in buffered:
+        line, buffered = buffered.split(b"\n", 1)
+        if commands is not None:
+          commands.put_nowait(json.loads(line))
+  except (OSError, ValueError, queue.Full):
+    pass
+  stop.set()
+
+
+def _emit(payload):
+  encoded = json.dumps(payload, separators=(",", ":"), allow_nan=False).encode("utf-8")
+  if len(encoded) + 1 > MAX_STATUS_BYTES:
+    payload = {**payload, "diagnostic": None, "history": [], "reason": "status_payload_limit",
+               "diagnostic_invalidated": True,
+               "metadata": {**payload["metadata"], "payload_details_omitted": True}}
+    if payload["state"] not in TERMINAL_STATES:
+      payload["state"] = "degraded"
+    encoded = json.dumps(payload, separators=(",", ":"), allow_nan=False).encode("utf-8")
+  if len(encoded) + 1 > MAX_STATUS_BYTES:
+    raise ValueError("bounded status envelope exceeded")
+  sys.stdout.buffer.write(encoded + b"\n")
+  sys.stdout.buffer.flush()
+
+
+def run(*, mode, session_id, interval_seconds, parent_pid=None):
+  runtime = configure_worker_runtime(mode)
+  session = LiveSession(session_id, source_mode=mode, interval_seconds=interval_seconds)
+  session.worker_runtime = runtime
+  clock_start = time.monotonic_ns()
+  if mode == "synthetic":
+    source_clock = lambda: 1_000_000_000 + min(600_000_000_000, max(0, time.monotonic_ns() - clock_start) * 60)
+    clock_metadata = {"domain": "accelerated_synthetic_monotonic", "scale": 60,
+                      "source_zero_ns": 1_000_000_000, "host_zero_ns": clock_start}
+  else:
+    source_clock = time.monotonic_ns
+    clock_metadata = {"domain": "native_monotonic", "scale": 1}
+  recording = RecordingSession(session_id, source_mode=mode, source_clock_ns=source_clock,
+                               clock_metadata=clock_metadata, analysis_interval_seconds=interval_seconds,
+                               journal_format="segmented" if mode == "live" else "v1",
+                               identity_provider=_recording_identity_provider() if mode == "live" else None).start()
+  consumers = ConsumerCollector(source_mode=mode, clock_ns=source_clock)
+  stop = threading.Event()
+  commands = queue.Queue(maxsize=32)
+  threading.Thread(target=_watch_stdin, args=(stop, commands), daemon=True, name="advisor-parent-pipe").start()
+  transport = None
+  last_emitted = None
+
+  def pump_recording():
+    recording.submit_consumer_observations(consumers.poll())
+    for notice in recording.poll_settings():
+      session.observe_settings(notice)
+    recording.submit_diagnostic(session.preservation_bookmark)
+    snap = session.snapshot()
+    recording.observe_analysis(session._max_seen_ns, snap["parking"], session.nonpark_observed_ns)
+    for _ in range(32):
+      try:
+        command = commands.get_nowait()
+      except queue.Empty:
+        break
+      if type(command) is not dict or command.get("session_id") != session_id:
+        raise ValueError("analysis_command_session_mismatch")
+      if command.get("kind") == "analyze":
+        session.bookmark(partial=True)
+        recording.submit_diagnostic(session.preservation_bookmark)
+        recording.request_analysis(command["request_id"], command.get("goal_id"))
+      elif command.get("kind") == "executor":
+        recording.request_executor(command["executor"])
+      elif command.get("kind") == "successful_apply":
+        recording.successful_apply(command["receipt"], command["trip_binding"])
+      else:
+        raise ValueError("analysis_command_invalid")
+    session.recording_status = recording.snapshot()
+    session.consumer_observations = {**consumers.snapshot(), "persistence": session.recording_status["consumer_history"]}
+
+  def finish_recording():
+    pump_recording()
+    consumers.close()
+    session.recording_status = recording.close()
+    session.consumer_observations = {**consumers.snapshot(), "persistence": session.recording_status["consumer_history"]}
+
+  def emit(*, final=False):
+    nonlocal last_emitted
+    now = time.monotonic()
+    if last_emitted is not None and now - last_emitted < 1.0:
+      if not final:
+        return
+      time.sleep(max(0.0, 1.0 - (now - last_emitted)))
+    _emit({**session.snapshot(), "automatic_analysis": recording.automatic_snapshot(), "analysis_control": recording.analysis_snapshot(),
+           "analysis_binding": recording.analysis_binding(), "analysis_goal": recording.analysis_goal(),
+           "analysis_execution": recording.execution_snapshot()})
+    last_emitted = time.monotonic()
+
+  try:
+    if mode == "live":
+      try:
+        # Third-party native startup diagnostics belong on bounded stderr, not
+        # the status protocol. A source failure never switches to synthetic.
+        with redirect_stdout(sys.stderr):
+          transport = NativeTransport()
+      except Exception:
+        session.state, session.reason = "unavailable", "native_messaging_unavailable"
+        finish_recording()
+        emit(final=True)
+        return 0
+    pump_recording()
+    emit()
+    next_tick = 0
+    while session.state not in TERMINAL_STATES:
+      pump_recording()
+      if stop.is_set():
+        session.finish("parent_pipe_closed")
+        break
+      if parent_pid is not None and os.name != "nt" and os.getppid() != parent_pid:
+        session.finish("parent_process_changed")
+        break
+      if mode == "synthetic":
+        logical_target = min(12_000, (source_clock() - 1_000_000_000) // 50_000_000)
+        events = []
+        for _ in range(64):
+          if next_tick > logical_target:
+            break
+          events.extend(_synthetic_tick(next_tick))
+          next_tick += 1
+        session.ingest_batch(events)
+        if next_tick > 12_000:
+          session.finish("synthetic_logical_600_seconds_complete")
+      else:
+        before = transport.rejected_events
+        events = transport.poll()
+        if transport.rejected_events > before:
+          session.dropped_events += transport.rejected_events - before
+          session.invalidate("native_payload_rejected", overflow=True)
+        session.ingest_batch(events)
+        session.received_events = transport.received_events
+        session.poll_budget_overruns = transport.budget_overruns
+      session.tick()
+      pump_recording()
+      emit()
+      stop.wait(0.01)
+    finish_recording()
+    emit(final=True)
+    return 0
+  except (BrokenPipeError, OSError):
+    return 1
+  except KeyboardInterrupt:
+    session.finish("interrupted")
+    finish_recording()
+    emit(final=True)
+    return 0
+  except Exception:
+    session.state, session.reason = "failed", "worker_processing_failed"
+    finish_recording()
+    try:
+      emit(final=True)
+    except (BrokenPipeError, OSError):
+      pass
+    return 1
+  finally:
+    consumers.close()
+    recording.close()
+    if transport is not None:
+      transport.close()
+
+
+def main():
+  parser = argparse.ArgumentParser(description="Read-only FMS control diagnostic worker")
+  parser.add_argument("--mode", choices=("live", "synthetic"), required=True)
+  parser.add_argument("--session-id", required=True)
+  parser.add_argument("--interval-seconds", type=int, choices=(180, 300), default=300)
+  parser.add_argument("--parent-pid", type=int)
+  args = parser.parse_args()
+  return run(mode=args.mode, session_id=args.session_id, interval_seconds=args.interval_seconds, parent_pid=args.parent_pid)
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
diff --git a/openpilot/selfdrive/carrot/control_advisor/worker_runtime.py b/openpilot/selfdrive/carrot/control_advisor/worker_runtime.py
