+
+  fake_scons = bin_dir / 'scons'
+  fake_scons_code = f"""#!/usr/bin/env python3
+import os, sys
+from pathlib import Path
+
+lock_fd = os.environ.get("SCONS_CACHE_LOCK_FD")
