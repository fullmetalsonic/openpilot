-static bool receive_all(int sock, void *buffer, size_t count) {
-  uint8_t *p = buffer;
-  while (count) {
-    int n = recv(sock, p, count, 0);
-    if (n <= 0) return false;
-    p += n; count -= n;
-  }
-  return true;
-}
-
-static bool send_all(int sock, const void *buffer, size_t count) {
-  const uint8_t *p = buffer;
-  while (count) {
-    int n = send(sock, p, count, 0);
-    if (n <= 0) return false;
-    p += n; count -= n;
-  }
-  return true;
-}
