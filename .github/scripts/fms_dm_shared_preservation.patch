+  "livePose": ("orientationNED", "angularVelocityDevice", "inputsOK", "posenetOK", "sensorsOK", "timestamp"),
+  "liveCalibration": ("calStatus", "rpyCalib", "rpyCalibSpread", "validBlocks"),
+  "liveDelay": ("lateralDelay", "validBlocks", "status"),
+}
