+  for entry in result["files"]:
+    if type(entry) is not dict or not {"path", "sha256", "role"} <= set(entry):
+      raise ValueError("review_binding_invalid")
+    path = str(_relative(entry["path"]))
+    if path.casefold() in names:
+      raise ValueError("review_binding_invalid")
