+@pytest.mark.parametrize('gate', ['braking', 'lead', 'steering', 'restart_timer', 'mode_high', 'detection_off'])
+def test_auxiliary_only_state_cannot_certify_a_forbidden_native_stop(monkeypatch, tmp_path, gate):
