+                         activeCarrot=2, xDistToTurn=0., desiredSpeed=80.)
+  # Keep the actual age/health/positive-speed admission and navigation producer.
+  planner._update_carrot_man.__func__.__globals__['get_carrot_man'] = get_carrot_man
