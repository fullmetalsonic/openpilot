+def decode_hold(message):
+  parser = CANParser("hyundai_canfd_generated", [("ADRV_0x1ea", 0)], 0)
+  parser.update([(1_000_000_000, [message])])
+  values = parser.vl["ADRV_0x1ea"]
+  return values["LEFT_BLINK_HOLD"], values["RIGHT_BLINK_HOLD"]
