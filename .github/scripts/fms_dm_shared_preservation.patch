+                          ({"read_byte_limit": 1}, "read_budget")):
+      with self.subTest(values=values):
+        store = self.instance(**values)
+        with self.assertRaisesRegex(ValueError, error):
+          self.preserve(store, source)
+    store = self.instance()
+    with patch.object(archive.shutil, "disk_usage", return_value=SimpleNamespace(free=1)):
+      with self.assertRaisesRegex(OSError, "free_space_reserve"):
+        self.preserve(store, source)
+
+  def test_restart_inspection_reports_incomplete_and_corrupt_without_overwrite(self):
+    store = self.instance()
+    source = self.source()
+    record = self.preserve(store, source)
+    unfinished = store.archive_root / ("b" * 32)
+    unfinished.mkdir()
+    (unfinished / "rlog.partial").write_bytes(b"incomplete")
+    resumed = self.instance()
+    result = resumed.inspect_existing()
+    self.assertEqual({"complete", "incomplete"}, {row["state"] for row in result})
+    directory = store.archive_root / record["archive_id"]
+    (directory / "rlog.zst").write_bytes(b"corrupt")
+    before = (directory / "archive.json").read_bytes()
+    result = resumed.inspect_existing()
+    self.assertIn("corrupt", {row["state"] for row in result})
+    self.assertEqual(before, (directory / "archive.json").read_bytes())
+
+  def test_discovery_pages_are_bounded_and_never_claim_closure(self):
+    store = self.instance()
+    for index in range(5):
+      self.source(segment=index)
+    observed = []
+    for _ in range(3):
+      batch = store.discover_candidates(max_entries=2, route=ROUTE)
+      self.assertLessEqual(len(batch), 2)
+      self.assertTrue(all(row["closure"] == "unverified" for row in batch))
+      observed.extend(row["segment"] for row in batch)
+    self.assertEqual(set(range(5)), set(observed))
+    self.assertTrue(store.status()["discovery_complete"])
+
+  def test_actual_directory_link_or_junction_is_rejected(self):
+    store = self.instance()
+    source = self.source()
+    outside = self.root / "external-segment"
+    source.parent.rename(outside)
+    linked = self.logs / f"{ROUTE}--0"
+    if os.name == "nt":
+      escaped_link = str(linked).replace("'", "''")
+      escaped_target = str(outside).replace("'", "''")
+      process = subprocess.run(["powershell", "-NoProfile", "-Command",
+                                f"New-Item -ItemType Junction -Path '{escaped_link}' -Target '{escaped_target}' | Out-Null"],
+                               capture_output=True, text=True, timeout=15, creationflags=subprocess.CREATE_NO_WINDOW)
+      self.assertEqual(0, process.returncode, process.stderr)
+    else:
+      linked.symlink_to(outside, target_is_directory=True)
+    with self.assertRaisesRegex(ValueError, "link_not_allowed"):
+      self.preserve(store, linked / "rlog.zst")
+
+
+if __name__ == "__main__":
+  unittest.main()
diff --git a/openpilot/selfdrive/carrot/control_advisor/tests/test_candidate_availability.py b/openpilot/selfdrive/carrot/control_advisor/tests/test_candidate_availability.py
--- /dev/null
+++ b/openpilot/selfdrive/carrot/control_advisor/tests/test_candidate_availability.py
@@ -0,0 +1,57 @@
+"""Partial recorded support excludes only the named calibration, never errors."""
+import copy
+import unittest
+
+from openpilot.selfdrive.carrot.control_advisor import candidates
+from openpilot.selfdrive.carrot.control_advisor.tests.test_candidates import factor_fixture
+
+
+class CandidateAvailabilityTests(unittest.TestCase):
+  key = "LateralTorqueAccelFactor"
+
+  def row(self, evidence, profile):
+    return next(row for row in candidates.evaluate_candidates(evidence, profile)["items"] if row["key"] == self.key)
+
+  def test_explicit_support_gaps_keep_sufficient_independent_samples(self):
+    evidence, profile = factor_fixture()
+    for block in evidence["blocks"]:
+      row = block["samples"][0]
+      row["signals"].pop("lateral_accel_offset")
+      row["unavailable_for"] = {self.key: ["recorded_dependency_unavailable"]}
+    original = copy.deepcopy(evidence)
+    result = self.row(evidence, profile)
+    self.assertEqual(("search_candidate", 3000), (result["status"], result["candidate_raw"]))
+    self.assertEqual(3, result["provenance"]["excluded_rows"])
+    self.assertEqual(7, result["metrics"]["holdout"]["rows"])
+    self.assertEqual(original, evidence)
+
+  def test_missing_unmarked_or_other_parameter_support_still_blocks(self):
+    for marked in (False, True):
+      with self.subTest(marked=marked):
+        evidence, profile = factor_fixture()
+        row = evidence["blocks"][0]["samples"][0]
+        row["signals"].pop("lateral_accel_offset")
+        if marked:
+          row["unavailable_for"] = {"CustomSR": ["recorded_dependency_unavailable"]}
+        self.assertIn("missing_stale_or_mismatched_signal_units", self.row(evidence, profile)["reason_codes"])
+
+  def test_support_exclusions_cannot_replace_required_exposure(self):
+    evidence, profile = factor_fixture()
+    for row in evidence["blocks"][0]["samples"]:
+      row["unavailable_for"] = {self.key: ["factor_mapping_unverified"]}
+    result = self.row(evidence, profile)
+    self.assertIsNone(result["candidate_raw"])
+    self.assertIn("insufficient_independent_split_exposure", result["reason_codes"])
+
+  def test_only_known_support_reasons_and_parameter_keys_are_accepted(self):
+    for unavailable in ({self.key: ["large_error"]}, {"unknown": ["factor_mapping_unverified"]},
+                        {self.key: []}, {self.key: ["factor_mapping_unverified"] * 2}):
+      with self.subTest(unavailable=unavailable):
+        evidence, profile = factor_fixture()
+        evidence["blocks"][0]["samples"][0]["unavailable_for"] = unavailable
+        with self.assertRaisesRegex(ValueError, "invalid_key_availability"):
+          candidates.evaluate_candidates(evidence, profile)
+
+
+if __name__ == "__main__":
+  unittest.main()
diff --git a/openpilot/selfdrive/carrot/control_advisor/tests/test_candidate_goal_targets.py b/openpilot/selfdrive/carrot/control_advisor/tests/test_candidate_goal_targets.py
