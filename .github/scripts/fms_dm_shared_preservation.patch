+  assert trace.read() == set()
+  assert trace.read() == {50}
+
+
+@pytest.mark.parametrize('bulk,peer', [(False, {'carrot_host': 'jetson'}), (True, {}), (True, {'carrot_host': 'mac'})])
+def test_unrelated_transports_do_not_start_helper(monkeypatch, bulk, peer):
