+      while remaining:
+        block = stream.read(min(65536, remaining))
+        if not block:
+          raise ValueError("segment_prefix_truncated")
+        digest.update(block)
+        remaining -= len(block)
+      if digest.hexdigest() != desc["content_sha256"]:
+        raise ValueError("segment_content_hash_mismatch")
