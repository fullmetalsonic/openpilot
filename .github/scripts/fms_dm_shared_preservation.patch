diff --git a/openpilot/selfdrive/carrot/web/tests/control_advisor_calibration.test.mjs b/openpilot/selfdrive/carrot/web/tests/control_advisor_calibration.test.mjs
--- /dev/null
+++ b/openpilot/selfdrive/carrot/web/tests/control_advisor_calibration.test.mjs
@@ -0,0 +1,106 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { buildTrialRequestBody, CALIBRATION_KEYS, createCalibrationReviewModel, createControlAdvisorModel, eventInferenceModel, comparisonAssessment } from "../src/features/control_advisor/model.js";
+
+function fixture() {
+  const columns = ["mono_ns", "target", "actual", "target_mono_ns", "actual_mono_ns", "independent_actual", "independent_mono_ns", "sent_request", "sent_mono_ns", "segment", "sent_raw", "stop_req", "jerk_upper", "jerk_lower"];
+  const series = () => ({ unit: "m/s^2", actual_source: "controller_observation", independent_source: "sensor", sent_source: "sendcan_scc_control",
+    columns, points: [["9007199254740993", .5, .4, "9007199254740993", "9007199254740993", .41, "9007199254740993", .6, "9007199254740993", 0, .6, 0, 2, 2]],
+    raw_count: 2000, selected_count: 1 });
+  const option = { id: "b".repeat(64), purpose: "manual_trial", parameter_key: "LongActuatorDelay", current_raw: 30, candidate_raw: 35, restore_raw: 30 };
+  return { capabilities: { request_registration_enabled: true, pc_simulation_enabled: true }, request_state: { state: "ready" },
+    candidate_report: { state: "ready", integrity_verified: true, artifact_sha256: "a".repeat(64), result_revision: 1,
+      calibration_review: { schema_version: 1, parameter_key: "LongActuatorDelay", purpose: "manual_trial", state: "ready",
+        baseline: { settings_raw: { LongActuatorDelay: 30, LateralTorqueKiV: 0 }, input_sha256: "c".repeat(64), profile_sha256: "d".repeat(64) },
+        series: { lateral: series(), longitudinal: series() }, metrics: {}, exclusions: {}, reasons: [], trial_options: [option] } },
+    current_request_context: { target_id: "pc", session_id: "session", scope: "pc_simulation", artifact_sha256: "a".repeat(64),
+      result_revision: 1, settings_revision: 0, dependency_digest: "e".repeat(64),
+      items: [{ item_key: "LongActuatorDelay", eligible: true, purpose: "manual_trial", expected_current_raw: 30, trial_ids: [option.id] }] } };
+}
+
+test("identified timing evidence exposes bounded experiments without presenting a software optimum", () => {
+  const payload = fixture(), review = payload.candidate_report.calibration_review;
+  review.schema_version = 2;
+  review.diagnostics = { version: 1, method_id: "signal_stage_event_response_v1", causal_effect_proven: false, software_optimum_identified: false,
+    stages: [{ id: "longitudinal_scc_to_acceleration", state: "identified_response", event_count: 8,
+      lag_s: { estimate: .2, lower: .15, upper: .25 }, time_constant_s: { estimate: .4, lower: .3, upper: .5 } }],
+    timing: { LongActuatorDelay: { state: "experiment_required", trial_plan: {
+      max_candidates: 2, direction_effect: "unconfirmed", event_count_per_candidate: 8, max_observation_s: 900 } } } };
+  const model = createCalibrationReviewModel(payload);
+  assert.equal(model.available, true);
+  assert.equal(model.diagnostics.stages[0].lag.upper, .25);
+  assert.deepEqual(model.diagnostics.plan, { events: 8, seconds: 900 });
+  assert.equal(model.trials[0].eligible, true);
+  review.diagnostics.timing.LongActuatorDelay.trial_plan = null;
+  assert.equal(createCalibrationReviewModel(payload).available, false);
+  review.diagnostics.software_optimum_identified = true;
+  assert.equal(createCalibrationReviewModel(payload).available, false);
+});
+
+test("event inference shows independent validation uncertainty and rejects reused holdout", () => {
+  const source = { schema_version: 1, method: "event_bootstrap_v1", causal_improvement_proven: false,
+    configuration: { confidence: .95, bootstrap_repetitions: 256 }, event_counts: { fit: 8, select: 6, holdout: 4 },
+    holdout_evaluations: 1, minimum_effect: .03, selection: { effect: { lower: .04, upper: .08 } },
+    holdout: { effect: { lower: -.01, upper: .09 } } };
+  assert.equal(eventInferenceModel(source).holdout.lower, -.01);
+  assert.equal(eventInferenceModel(source).counts.holdout, 4);
+  assert.equal(eventInferenceModel({ ...source, holdout_evaluations: 2 }), null);
+  assert.equal(eventInferenceModel({ ...source, causal_improvement_proven: true }), null);
+});
+
+test("comparison exposes a finite inconclusive result without enabling application", () => {
+  const value = { schema_version: 1, method: "matched_event_bootstrap_v1", state: "inconclusive", ended: true,
+    causal_improvement_proven: false, events_required: 8, observation_limit_s: 900, policy_sha256: "a".repeat(64),
+    counts: { before_events: 8, after_events: 3, matched_pairs: 3 }, observed_after_s: 900, minimum_effect: .1,
+    effect: null, unit: "s" };
+  assert.equal(comparisonAssessment(value).ended, true);
+  assert.equal(comparisonAssessment(value).state, "inconclusive");
+  assert.equal(comparisonAssessment({ ...value, state: "improved", causal_improvement_proven: true }), null);
+  assert.equal(comparisonAssessment({ ...value, state: "observing" }), null);
+});
+
+test("calibration preserves original int64 timestamps and sends only the opaque trial selector", () => {
+  const payload = fixture(), model = createCalibrationReviewModel(payload);
+  assert.equal(model.available, true);
+  assert.equal(model.series[0].points[0][0], "9007199254740993");
+  assert.equal(model.trials[0].eligible, true);
+  const body = buildTrialRequestBody(payload, "LongActuatorDelay", "b".repeat(64), "request");
+  assert.equal(body.purpose, "manual_trial");
+  assert.equal(body.trial_id, "b".repeat(64));
+  assert.equal(Object.hasOwn(body, "candidate_raw"), false);
+  assert.doesNotThrow(() => JSON.stringify(model));
+});
+
+test("invalid timestamps, unbound trial IDs and nonzero Ki cannot enable a trial", () => {
+  const payload = fixture();
+  assert.throws(() => buildTrialRequestBody(payload, "LongActuatorDelay", "f".repeat(64), "request"));
+  payload.current_request_context.items[0].trial_ids = [];
+  assert.equal(createCalibrationReviewModel(payload).trials[0].eligible, false);
+  const nonzero = fixture(); nonzero.candidate_report.calibration_review.baseline.settings_raw.LateralTorqueKiV = 20;
+  assert.equal(createCalibrationReviewModel(nonzero).trials[0].eligible, false);
+  const corrupted = fixture(); corrupted.candidate_report.calibration_review.series.lateral.points[0][0] = 9007199254740992;
+  assert.equal(createCalibrationReviewModel(corrupted).available, false);
+});
+
+test("the current six-goal catalogue shows exactly the six agreed parameters", () => {
+  const payload = fixture();
+  payload.analysis_goals = { options: [{ id: "custom_sr_v1", label: "CustomSR", description: "CustomSR" }] };
+  payload.parameters = [...CALIBRATION_KEYS, "LateralTorqueKiV", "CruiseMaxVals0"].map((key) => ({ key, axis: key === "LongActuatorDelay" ? "longitudinal" : "lateral" }));
+  assert.deepEqual(new Set(createControlAdvisorModel(payload).parameters.map((item) => item.key)), new Set(CALIBRATION_KEYS));
+  const goals = ["custom_sr_v1", "lateral_torque_kp_v1", "lateral_torque_kf_v1", "steer_actuator_delay_v1", "lat_smooth_sec_v1", "long_actuator_delay_v1"];
+  payload.analysis_goals.options = goals.map((id) => ({ id, version: 1, label: id, description: id }));
+  assert.deepEqual(createControlAdvisorModel(payload).analysisGoals.options.map((item) => item.id), goals);
+});
+
+test("analysis location is independent of recording source mode and old payloads stay on device", () => {
+  const payload = fixture();
+  payload.session = { state: "running", source_mode: "live", session_id: "same-recording" };
+  assert.equal(createControlAdvisorModel(payload).analysisExecutor, "device");
+  payload.analysis_execution = { executor: "remote_pc", revision: "a".repeat(32), pending_job: "b".repeat(64) + "-12345678" };
+  const remote = createControlAdvisorModel(payload);
+  assert.equal(remote.analysisExecutor, "remote_pc");
+  assert.equal(remote.executorAvailable, true);
+  assert.equal(remote.sessionId, "same-recording");
+  assert.equal(remote.sourceMode, "live");
+  assert.equal(remote.remoteJob, payload.analysis_execution.pending_job);
+});
diff --git a/openpilot/selfdrive/carrot/web/tests/control_advisor_client.test.mjs b/openpilot/selfdrive/carrot/web/tests/control_advisor_client.test.mjs
--- /dev/null
+++ b/openpilot/selfdrive/carrot/web/tests/control_advisor_client.test.mjs
@@ -0,0 +1,175 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { advisorErrorMessage, consumeNativeGrant, createAdvisorClient } from "../src/features/control_advisor/index.js";
+import { buildReviewRegistrationBody } from "../src/features/control_advisor/model.js";
+
+test("manual analysis posts the session and idempotency ID, with no timer or range in the browser", async () => {
+  const calls = [];
+  const client = createAdvisorClient({ fetchImpl: async (...args) => { calls.push(args); return { ok: true, json: async () => ({ ok: true }) }; } });
+  const body = { session_id: "trip", request_id: "manual-A" };
+  await client.request("analyze", { body });
+  assert.equal(calls[0][0], "/api/control_advisor/analyze");
+  assert.equal(calls[0][1].method, "POST");
+  assert.deepEqual(JSON.parse(calls[0][1].body), body);
+});
+
+test("review registration preserves strict JSON bytes and history uses authenticated POST without paths or URL credentials", async () => {
+  const calls = [];
+  const client = createAdvisorClient({ fetchImpl: async (...args) => { calls.push(args); return { ok: true, json: async () => ({ ok: true }) }; } });
+  const rawJsonBody = buildReviewRegistrationBody("retry-id", '{"document_state":"final","same":1,"same":2}');
+  const jobId = "a".repeat(32);
+  await client.request("register_codex_review", { jobId, token: "private-key", rawJsonBody });
+  await client.request("query_codex_reviews", { jobId, token: "private-key", body: {} });
+  assert.equal(calls[0][0], `/api/control_advisor/export-jobs/${jobId}/reviews`);
+  assert.equal(calls[0][1].body, rawJsonBody);
+  assert.match(calls[0][1].body, /"same":1,"same":2/);
+  assert.equal(calls[1][0], `/api/control_advisor/export-jobs/${jobId}/reviews/query`);
+  assert.ok(calls.every(([url, options]) => options.method === "POST" && options.headers["X-Control-Advisor-Token"] === "private-key" && !url.includes("private-key")));
+  await assert.rejects(client.request("query_codex_reviews", { jobId: "../outside", body: {} }));
+  await assert.rejects(client.request("query_codex_reviews", { jobId, rawJsonBody }));
+});
+
+test("structured review conflicts have clear safe messages while arbitrary server text stays hidden", async () => {
+  const client = createAdvisorClient({ fetchImpl: async () => ({ ok: false, status: 409, json: async () => ({ error: "review_binding_mismatch" }) }) });
+  await assert.rejects(client.request("query_codex_reviews", { jobId: "a".repeat(32), body: {} }), (error) => /묶음·요약 버전/.test(advisorErrorMessage(error)));
+  assert.doesNotMatch(advisorErrorMessage({ code: "C:/private/key", status: 400 }), /private/);
+});
+
+test("status reads never carry a key or a request body", async () => {
+  const calls = [];
+  const client = createAdvisorClient({ fetchImpl: async (...args) => {
+    calls.push(args);
+    return { ok: true, json: async () => ({ ok: true, session: { state: "idle" } }) };
+  } });
+  await client.request("status", { token: "private-key" });
+  const [url, options] = calls[0];
+  assert.equal(url, "/api/control_advisor/status");
+  assert.equal(options.method, "GET");
+  assert.equal(options.headers, undefined);
+  assert.equal(options.body, undefined);
+  assert.equal(options.cache, "no-store");
+});
+
+test("native QR credentials are removed from the fragment before use and ordinary routes stay untouched", () => {
+  const calls = [];
+  const history = { replaceState: (...args) => calls.push(args) };
+  const grant = consumeNativeGrant({ hash: "#ca_grant=grant-id." + "s".repeat(32), pathname: "/", search: "?page=logs" }, history);
+  assert.deepEqual(grant, { grant_id: "grant-id", secret: "s".repeat(32) });
+  assert.deepEqual(calls, [[null, "", "/?page=logs"]]);
+  assert.equal(consumeNativeGrant({ hash: "#logs" }, history), null);
+  assert.equal(calls.length, 1);
+  assert.equal(consumeNativeGrant({ hash: "#ca_grant=invalid", pathname: "/", search: "" }, history), null);
+  assert.equal(calls.length, 2);
+});
+
+test("native cookie actions need no empty bearer header and never offer a grant issuer", async () => {
+  const calls = [];
+  const client = createAdvisorClient({ fetchImpl: async (...args) => { calls.push(args); return { ok: true, json: async () => ({ ok: true }) }; } });
+  for (const [action, body] of [["redeem_access", { grant_id: "id", secret: "s".repeat(32) }], ["confirm_vehicle", { group_id: null }],
+    ["backup_vehicle", {}], ["restore_vehicle", { request_id: "original", restore_id: "restore", mode: "offroad" }]]) {
+    await client.request(action, { body });
+  }
+  assert.ok(calls.every(([url, options]) => options.credentials === "same-origin" && options.method === "POST"
+    && !Object.hasOwn(options.headers, "X-Control-Advisor-Token") && !url.includes("secret")));
+  assert.deepEqual(calls.map(([url]) => url), ["/api/control_advisor/access/redeem", "/api/control_advisor/vehicle/confirm", "/api/control_advisor/vehicle/backup", "/api/control_advisor/vehicle/restore"]);
+  assert.deepEqual(JSON.parse(calls[3][1].body), { request_id: "original", restore_id: "restore", mode: "offroad" });
+  await assert.rejects(client.request("issue_access", { body: {} }));
+});
+
+test("start and stop bind the selected session action without exposing the key in URLs", async () => {
+  const calls = [];
+  const client = createAdvisorClient({ fetchImpl: async (...args) => {
+    calls.push(args);
+    return { ok: true, json: async () => ({ ok: true }) };
+  } });
+  const body = { mode: "synthetic", interval_seconds: 300, request_id: "request-A" };
+  await client.request("start", { token: "private-key", body });
+  await client.request("stop", { token: "private-key", body: { session_id: "session-A" } });
+  assert.equal(calls[0][0], "/api/control_advisor/start");
+  assert.deepEqual(JSON.parse(calls[0][1].body), body);
+  assert.equal(calls[0][1].headers["X-Control-Advisor-Token"], "private-key");
+  assert.equal(calls[1][0], "/api/control_advisor/stop");
+  assert.deepEqual(JSON.parse(calls[1][1].body), { session_id: "session-A" });
+  assert.ok(calls.every(([url]) => !url.includes("private-key")));
+});
+
+test("a new request cancels the earlier status fetch and cleanup cancels its own request", async () => {
+  const calls = [];
+  const client = createAdvisorClient({ fetchImpl: async (_url, options) => {
+    calls.push(options);
+    return new Promise((_resolve, reject) => options.signal.addEventListener("abort", () => reject(new DOMException("Aborted", "AbortError")), { once: true }));
+  } });
+  const first = client.request();
+  const firstRejected = assert.rejects(first, { name: "AbortError" });
+  const second = client.request();
+  const secondRejected = assert.rejects(second, { name: "AbortError" });
+  assert.equal(calls[0].signal.aborted, true);
+  client.cancel();
+  assert.equal(calls[1].signal.aborted, true);
+  await Promise.all([firstRejected, secondRejected]);
+});
+
+test("timeout aborts a stalled request", async () => {
+  const client = createAdvisorClient({ timeoutMs: 5, fetchImpl: async (_url, options) => new Promise((_resolve, reject) => {
+    options.signal.addEventListener("abort", () => reject(new DOMException("Aborted", "AbortError")), { once: true });
+  }) });
+  await assert.rejects(client.request(), { name: "AbortError" });
+});
+
+test("failed or malformed responses are errors and do not become empty success", async () => {
+  for (const response of [{ ok: false, status: 403 }, { ok: true, json: async () => ({ ok: false }) },
+    { ok: true, json: async () => [] }, { ok: true, json: async () => null }]) {
+    const client = createAdvisorClient({ fetchImpl: async () => response });
+    await assert.rejects(client.request());
+  }
+  assert.match(advisorErrorMessage({ status: 403 }), /세션 키/);
+  assert.match(advisorErrorMessage({ status: 409 }), /세션 상태/);
+  assert.doesNotMatch(advisorErrorMessage(new Error("private-key")), /private-key/);
+});
+
+test("unknown actions never trigger a network request", async () => {
+  let called = false;
+  const client = createAdvisorClient({ fetchImpl: async () => { called = true; } });
+  await assert.rejects(client.request("apply"));
+  assert.equal(called, false);
+});
+
+test("request endpoints keep the bound body separate from the server-owned target and use no token for reads", async () => {
+  const calls = [];
+  const client = createAdvisorClient({ fetchImpl: async (...args) => { calls.push(args); return { ok: true, json: async () => ({ ok: true }) }; } });
+  const body = { request_id: "request-1", item_key: "PathOffset" };
+  await client.request("register_request", { body, token: "test-token" });
+  await client.request("request_status", { requestId: "request-1", token: "test-token" });
+  await client.request("cancel_request", { requestId: "request-1", body: {}, token: "test-token" });
+  assert.equal(calls[0][0], "/api/control_advisor/apply-requests");
+  assert.deepEqual(JSON.parse(calls[0][1].body), body);
+  assert.equal(calls[1][0], "/api/control_advisor/apply-requests/request-1");
+  assert.equal(calls[1][1].method, "GET");
+  assert.equal(calls[1][1].headers, undefined);
+  assert.equal(calls[2][0], "/api/control_advisor/apply-requests/request-1/cancel");
+  assert.deepEqual(JSON.parse(calls[2][1].body), {});
+});
+
+test("request identifiers cannot choose a path and inherited action names are rejected", async () => {
+  let calls = 0;
+  const client = createAdvisorClient({ fetchImpl: async () => { calls++; } });
+  for (const requestId of ["../private", "https://other.invalid", "a/b", ""]) await assert.rejects(client.request("request_status", { requestId }));
+  await assert.rejects(client.request("constructor"));
+  assert.equal(calls, 0);
+});
+
+test("export creation, cancellation and native download grant use fixed authenticated POST paths", async () => {
+  const calls = [];
+  const client = createAdvisorClient({ fetchImpl: async (...args) => { calls.push(args); return { ok: true, json: async () => ({ ok: true }) }; } });
+  const jobId = "a".repeat(32);
+  await client.request("create_export_job", { token: "private-key", body: { request_id: "export-one", summary_id: "summary", summary_revision: 1, include_raw: false } });
+  await client.request("cancel_export_job", { jobId, token: "private-key", body: {} });
+  await client.request("grant_export_download", { jobId, token: "private-key", body: {} });
+  assert.equal(calls[0][0], "/api/control_advisor/export-jobs");
+  assert.equal(calls[1][0], `/api/control_advisor/export-jobs/${jobId}/cancel`);
+  assert.equal(calls[2][0], `/api/control_advisor/export-jobs/${jobId}/download`);
+  assert.ok(calls.every(([url, options]) => !url.includes("private-key") && options.method === "POST" && options.credentials === "same-origin"));
+  await assert.rejects(client.request("grant_export_download", { jobId: "../private" }));
+  assert.equal(calls.length, 3);
+});
diff --git a/openpilot/selfdrive/carrot/web/tests/control_advisor_comparison_intervals.test.mjs b/openpilot/selfdrive/carrot/web/tests/control_advisor_comparison_intervals.test.mjs
--- /dev/null
+++ b/openpilot/selfdrive/carrot/web/tests/control_advisor_comparison_intervals.test.mjs
@@ -0,0 +1,279 @@
+import { describe, it } from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  ENCODING,
+  decodeExclusions,
+  encodeExclusions,
+} from "../src/features/control_advisor/comparison_intervals.js";
+
+describe("control_advisor comparison exclusion intervals codec", () => {
+  it("encodes and decodes empty exclusion lists losslessly across schemas", () => {
+    const encoded = encodeExclusions([]);
+    assert.deepEqual(encoded, { encoding: ENCODING, reasons: [], rows: [] });
+    assert.deepEqual(decodeExclusions([], 1), []);
+    assert.deepEqual(decodeExclusions(encoded, 2), []);
+  });
+
+  it("decodes schema1 legacy payload with deep-copy isolation", () => {
+    const legacy = [
+      { reason: "driver_intervention", start_ns: 1000, end_ns: 2000, sample_count: 5 },
+      { reason: "recovery", start_ns: 2500, end_ns: 3000, sample_count: 2 },
+    ];
+    const decoded = decodeExclusions(legacy, 1);
+    assert.deepEqual(decoded, legacy);
+    assert.notEqual(decoded, legacy);
+    decoded[0].start_ns = 9999;
+    assert.equal(legacy[0].start_ns, 1000);
+  });
+
+  it("preserves exact row order, gaps, overlaps, zero durations, and reasons in schema2", () => {
+    const intervals = [
+      { reason: "settings_hole", start_ns: 1000, end_ns: 2000, sample_count: 10 },
+      { reason: "driver_mask", start_ns: 1500, end_ns: 2500, sample_count: 8 },
+      { reason: "point_event", start_ns: 3000, end_ns: 3000, sample_count: 1 },
+      { reason: "settings_hole", start_ns: 5000, end_ns: 6000, sample_count: 12 },
+      { reason: "driver_mask", start_ns: 7000, end_ns: 7500, sample_count: 3 },
+    ];
+
+    const encoded = encodeExclusions(intervals);
+    assert.equal(encoded.encoding, ENCODING);
+    assert.deepEqual(encoded.reasons, ["settings_hole", "driver_mask", "point_event"]);
+    assert.deepEqual(encoded.rows, [
+      [0, "1000", "2000", 10],
+      [1, "1500", "2500", 8],
+      [2, "3000", "3000", 1],
+      [0, "5000", "6000", 12],
+      [1, "7000", "7500", 3],
+    ]);
+
+    const decoded = decodeExclusions(encoded, 2);
+    assert.deepEqual(decoded, intervals);
+    assert.notEqual(decoded, intervals);
+    decoded.forEach((item, idx) => assert.notEqual(item, intervals[idx]));
+
+    const reencoded = encodeExclusions(decoded);
+    assert.deepEqual(reencoded, encoded);
+  });
+
+  it("handles int64 boundaries and exact BigInt representation", () => {
+    const maxInt64 = 9223372036854775807n;
+    const maxSafeInt = Number.MAX_SAFE_INTEGER;
+    const overSafeInt = BigInt(maxSafeInt) + 1n;
+
+    const mixed = [
+      { reason: "zero_point", start_ns: 0, end_ns: 0, sample_count: 0 },
+      { reason: "safe_max", start_ns: maxSafeInt, end_ns: maxSafeInt, sample_count: 1 },
+      { reason: "unsafe_big", start_ns: overSafeInt, end_ns: maxInt64, sample_count: maxSafeInt },
+    ];
+
+    const encoded = encodeExclusions(mixed);
+    assert.deepEqual(encoded.rows, [
+      [0, "0", "0", 0],
+      [1, String(maxSafeInt), String(maxSafeInt), 1],
+      [2, overSafeInt.toString(10), maxInt64.toString(10), maxSafeInt],
+    ]);
+
+    const decoded = decodeExclusions(encoded, 2);
+    assert.equal(typeof decoded[0].start_ns, "number");
+    assert.equal(decoded[0].start_ns, 0);
+    assert.equal(typeof decoded[1].start_ns, "number");
+    assert.equal(decoded[1].start_ns, maxSafeInt);
+    assert.equal(typeof decoded[2].start_ns, "bigint");
+    assert.equal(decoded[2].start_ns, overSafeInt);
+    assert.equal(typeof decoded[2].end_ns, "bigint");
+    assert.equal(decoded[2].end_ns, maxInt64);
+
+    const reencoded = encodeExclusions(decoded);
+    assert.deepEqual(reencoded, encoded);
+  });
+
+  it("strictly rejects duplicate, unreferenced, or non-first-use dictionary entries", () => {
+    const unreferenced = {
+      encoding: ENCODING,
+      reasons: ["used_reason", "unreferenced_reason"],
+      rows: [[0, "10", "20", 1]],
+    };
+    assert.throws(() => decodeExclusions(unreferenced, 2), /invalid_public_comparison_exclusions/);
+
+    const duplicateReasons = {
+      encoding: ENCODING,
+      reasons: ["reason_a", "reason_a"],
+      rows: [[0, "10", "20", 1]],
+    };
+    assert.throws(() => decodeExclusions(duplicateReasons, 2), /invalid_public_comparison_exclusions/);
+
+    const nonFirstUse = {
+      encoding: ENCODING,
+      reasons: ["reason_zero", "reason_one"],
+      rows: [[1, "10", "20", 1], [0, "30", "40", 1]],
+    };
+    assert.throws(() => decodeExclusions(nonFirstUse, 2), /invalid_public_comparison_exclusions/);
+
+    const badIndex = {
+      encoding: ENCODING,
+      reasons: ["reason_zero"],
+      rows: [[5, "10", "20", 1]],
+    };
+    assert.throws(() => decodeExclusions(badIndex, 2), /invalid_public_comparison_exclusions/);
+  });
+
+  it("strictly fails on malformed structures, types, signs, and bounds", () => {
+    const invalidEncoderCases = [
+      { reason: "ok", start_ns: 0, end_ns: 10, sample_count: 1, extra: 1 },
+      { reason: "ok", start_ns: 0, end_ns: 10 },
+      { reason: "ok", start_ns: true, end_ns: 10, sample_count: 1 },
+      { reason: "ok", start_ns: 0, end_ns: false, sample_count: 1 },
+      { reason: "ok", start_ns: 0, end_ns: 10, sample_count: true },
+      { reason: "ok", start_ns: 1.5, end_ns: 10, sample_count: 1 },
+      { reason: "ok", start_ns: 0, end_ns: 1.5, sample_count: 1 },
+      { reason: "ok", start_ns: 0, end_ns: 10, sample_count: 1.5 },
+      { reason: "ok", start_ns: -1, end_ns: 10, sample_count: 1 },
+      { reason: "ok", start_ns: -1n, end_ns: 10n, sample_count: 1 },
+      { reason: "ok", start_ns: 10, end_ns: 5, sample_count: 1 },
+      { reason: "ok", start_ns: 9223372036854775808n, end_ns: 9223372036854775809n, sample_count: 1 },
+      { reason: "ok", start_ns: Number.MAX_SAFE_INTEGER + 1, end_ns: Number.MAX_SAFE_INTEGER + 2, sample_count: 1 },
+      { reason: "ok", start_ns: 0, end_ns: 10, sample_count: Number.MAX_SAFE_INTEGER + 1 },
+      { reason: "Invalid_Upper", start_ns: 0, end_ns: 10, sample_count: 1 },
+      { reason: "invalid-hyphen", start_ns: 0, end_ns: 10, sample_count: 1 },
+      { reason: "", start_ns: 0, end_ns: 10, sample_count: 1 },
+      { reason: "a".repeat(129), start_ns: 0, end_ns: 10, sample_count: 1 },
+    ];
+
+    for (const bad of invalidEncoderCases) {
+      assert.throws(() => encodeExclusions([bad]), /invalid_public_comparison_exclusions/);
+      assert.throws(() => decodeExclusions([bad], 1), /invalid_public_comparison_exclusions/);
+    }
+
+    const invalidDecoderCases = [
+      { encoding: "reason-indexed-v2", reasons: [], rows: [] },
+      { encoding: ENCODING, reasons: [], rows: [], extra: 1 },
+      { encoding: ENCODING, reasons: ["ok"], rows: [[0, "01", "10", 1]] },
+      { encoding: ENCODING, reasons: ["ok"], rows: [[0, "+1", "10", 1]] },
+      { encoding: ENCODING, reasons: ["ok"], rows: [[0, "-1", "10", 1]] },
+      { encoding: ENCODING, reasons: ["ok"], rows: [[0, "10", "5", 1]] },
+      { encoding: ENCODING, reasons: ["ok"], rows: [[0, "10", "20", -1]] },
+      { encoding: ENCODING, reasons: ["ok"], rows: [[0, "10", "20", 1.5]] },
+      { encoding: ENCODING, reasons: ["ok"], rows: [[0, "10", "20"]] },
+      { encoding: ENCODING, reasons: ["ok"], rows: [[0, "10", "20", 1, 2]] },
+      { encoding: ENCODING, reasons: ["ok"], rows: "not_array" },
+    ];
+
+    for (const bad of invalidDecoderCases) {
+      assert.throws(() => decodeExclusions(bad, 2), /invalid_public_comparison_exclusions/);
+    }
+
+    assert.throws(() => decodeExclusions([], 0), /invalid_public_comparison_exclusions/);
+    assert.throws(() => decodeExclusions([], 3), /invalid_public_comparison_exclusions/);
+    assert.throws(() => decodeExclusions([], 2), /invalid_public_comparison_exclusions/);
+    assert.throws(() => decodeExclusions({ encoding: ENCODING, reasons: [], rows: [] }, 1), /invalid_public_comparison_exclusions/);
+  });
+
+  it("enforces 100,000 bounds check", () => {
+    const sample = { reason: "gap", start_ns: 0, end_ns: 1, sample_count: 1 };
+    const oversized = new Array(100001).fill(sample);
+    assert.throws(() => encodeExclusions(oversized), /invalid_public_comparison_exclusions/);
+    assert.throws(() => decodeExclusions(oversized, 1), /invalid_public_comparison_exclusions/);
+  });
+
+  it("compresses realistic 180s and 300s repeated scan-hole comparisons to fit <= 32 KiB", () => {
+    const overhead = {
+      schema_version: 1,
+      state: "comparison_ready",
+      axis: "longitudinal",
+      scope: "observational_vehicle_acceleration",
+      target_unit: "m/s^2",
+      consumer_application_ack: false,
+      causal_improvement_proven: false,
+      apply_enabled: false,
+      device_qualified: false,
+      reason_codes: [],
+      boundary: {
+        setting_uncertainty_start_ns: 29000000000,
+        setting_uncertainty_end_ns: 31000000000,
+        consumer_observed_ns: 32000000000,
+        after_eligible_from_ns: 35000000000,
+        exact_consumer_apply_time_known: false,
+      },
+      matched: {
+        weighting: "common_stratum_minimum_count",
+        common_bin_count: 1,
+        bins: [{ speed_bin: 0, target_bin: 0, before_count: 100, after_count: 100, weight: 1.0 }],
+        before: { count: 100, bias: 0.0, rmse: 0.1, p95_absolute_error: 0.15 },
+        after: { count: 100, bias: 0.0, rmse: 0.08, p95_absolute_error: 0.12 },
+        before_duration_ns: 10000000000,
+        after_duration_ns: 10000000000,
+        after_minus_before: { bias: 0.0, rmse: -0.02, p95_absolute_error: -0.03 },
+      },
+    };
+
+    const sideSummary = (count, exclusions) => ({
+      window_start_ns: 0,
+      window_end_ns: count * 1e9,
+      raw_metrics: { count: count * 10, bias: 0.0, rmse: 0.2, p95_absolute_error: 0.3 },
+      eligible_metrics: { count: count * 9, bias: 0.0, rmse: 0.1, p95_absolute_error: 0.15 },
+      sample_count: count * 10,
+      eligible_count: count * 9,
+      excluded_count: count,
+      provisional_count: 0,
+      observed_duration_ns: count * 1e9,
+      eligible_duration_ns: count * 9e8,
+      output_limit_observation: {
+        fully_known_count: count * 10,
+        limited_count: 0,
+        output_limited_known_count: 0,
+        saturated_known_count: 0,
+        unknown_count: 0,
+      },
+      scope_limitations: [],
+      exclusion_counts: { comparison_settings_source_uncertain: count },
+      exclusions,
+    });
+
+    const makeScanHoles = (count, baseStamp) => Array.from({ length: count }, (_, sec) => ({
+      reason: "comparison_settings_source_uncertain",
+      start_ns: baseStamp + sec * 1000000000,
+      end_ns: baseStamp + sec * 1000000000 + 100000000,
+      sample_count: 1,
+    }));
+
+    for (const duration of [180, 300]) {
+      const v1Before = makeScanHoles(duration, 1700000000000000);
+      const v1After = makeScanHoles(duration, 1700300000000000);
+      const v1Comparison = {
+        ...overhead,
+        schema_version: 1,
+        before: sideSummary(duration, v1Before),
+        after: sideSummary(duration, v1After),
+      };
+
+      const v1Bytes = new TextEncoder().encode(JSON.stringify(v1Comparison)).length;
+      assert.ok(v1Bytes > 32 * 1024, `v1 size ${v1Bytes} should exceed 32 KiB`);
+      if (duration === 180) {
+        assert.ok(v1Bytes >= 42000, `180s v1 size ${v1Bytes} expected ~42 KiB`);
+      } else {
+        assert.ok(v1Bytes >= 69000, `300s v1 size ${v1Bytes} expected ~69 KiB`);
+      }
+
+      const v2Before = encodeExclusions(v1Before);
+      const v2After = encodeExclusions(v1After);
+      assert.equal(v2Before.rows.length, duration);
+      assert.equal(v2After.rows.length, duration);
+
+      const v2Comparison = {
+        ...overhead,
+        schema_version: 2,
+        before: sideSummary(duration, v2Before),
+        after: sideSummary(duration, v2After),
+      };
+
+      const v2Bytes = new TextEncoder().encode(JSON.stringify(v2Comparison)).length;
+      assert.ok(v2Bytes <= 32 * 1024, `v2 size ${v2Bytes} must fit <= 32 KiB`);
+
+      const decodedBefore = decodeExclusions(v2Before, 2);
+      const decodedAfter = decodeExclusions(v2After, 2);
+      assert.deepEqual(decodedBefore, v1Before);
+      assert.deepEqual(decodedAfter, v1After);
+    }
+  });
+});
