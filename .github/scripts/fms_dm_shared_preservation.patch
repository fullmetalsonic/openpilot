+from copy import deepcopy
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+from openpilot.selfdrive.carrot.control_advisor.apply_requests import RequestConflict
+from openpilot.selfdrive.carrot.control_advisor.request_evidence import _completion_age_basis, _raw
+
+
+class CompletionSealTests(unittest.TestCase):
+  def setUp(self):
+    self.temp = tempfile.TemporaryDirectory()
+    self.addCleanup(self.temp.cleanup)
+    self.job = Path(self.temp.name)
+    self.intent = {"trip_binding": {"vehicle_id": "vehicle", "boot_id": "boot", "route": "route"}, "cut_revision": 2}
+    self.request = {"job_id": "a" * 64, "analysis_intent": self.intent,
+      "identity": {"checkpoint": {"cutoff_mono_ns": 1_000_000_000}, "analysis_intent": deepcopy(self.intent)}}
+    self.result = {"analysis_mode": "whole_trip"}
+    self.current = {"session_id": "session", "analysis_binding": deepcopy(self.intent), "settings_raw": _raw({})}
+    self.seal = {"schema_version": 1, "job_id": "a" * 64, "request_sha256": "b" * 64, "manifest_sha256": "c" * 64,
+      "completed_mono_ns": 700_000_000_000,
+      "context": {"session_id": "session", "analysis_binding": deepcopy(self.intent), "settings_raw": {}, "vehicle_identity": None}}
+
+  def age_basis(self):
+    return _completion_age_basis(self.job, self.request, "b" * 64, self.result, "c" * 64, self.current, "vehicle")
+
+  def write_seal(self, value=None):
+    (self.job / "completion-seal.json").write_text(json.dumps(self.seal if value is None else value))
+
+  def test_slow_completion_uses_result_time_without_changing_source_cutoff(self):
+    self.assertEqual(self.age_basis(), 1_000_000_000)
+    self.write_seal()
+    self.assertEqual(self.age_basis(), 700_000_000_000)
+    self.assertEqual(self.request["identity"]["checkpoint"]["cutoff_mono_ns"], 1_000_000_000)
+    now = 700_000_000_001
+    self.assertGreater(now - self.request["identity"]["checkpoint"]["cutoff_mono_ns"], 600_000_000_000)
+    self.assertLess(now - self.age_basis(), 600_000_000_000)
+
+  def test_hash_time_identity_and_settings_tampering_fail_closed(self):
+    mutations = [lambda s: s.update(job_id="d" * 64), lambda s: s.update(request_sha256="d" * 64),
+      lambda s: s.update(manifest_sha256="d" * 64), lambda s: s.update(completed_mono_ns=0),
+      lambda s: s["context"].update(session_id="other"),
+      lambda s: s["context"]["analysis_binding"].update(cut_revision=3),
+      lambda s: s["context"]["analysis_binding"]["trip_binding"].update(route="other"),
+      lambda s: s["context"]["settings_raw"].update(PathOffset=10),
+      lambda s: s["context"].update(vehicle_identity={"physical_group_id": "other"})]
+    for mutation in mutations:
+      with self.subTest(mutation=mutation):
+        candidate = deepcopy(self.seal)
+        mutation(candidate)
+        self.write_seal(candidate)
+        with self.assertRaises(RequestConflict):
+          self.age_basis()
+
+  def test_new_apply_cut_or_trip_cannot_reuse_previous_seal(self):
+    self.write_seal()
+    self.current["analysis_binding"]["cut_revision"] += 1
+    with self.assertRaises(RequestConflict):
+      self.age_basis()
+
+
+if __name__ == "__main__":
+  unittest.main()
diff --git a/openpilot/selfdrive/carrot/control_advisor/tests/test_consumer_collector.py b/openpilot/selfdrive/carrot/control_advisor/tests/test_consumer_collector.py
--- /dev/null
+++ b/openpilot/selfdrive/carrot/control_advisor/tests/test_consumer_collector.py
@@ -0,0 +1,246 @@
+"""Synthetic real-byte receiver, identity, freshness and replay tests."""
+
+from collections import deque
+from copy import deepcopy
+import json
+import os
+import time
+import unittest
+from unittest import mock
+
+from openpilot.selfdrive.carrot.control_advisor import consumer_observer as producer
+from openpilot.selfdrive.carrot.control_advisor import consumer_collector as receiver
+
+
+BOOT = "00000000-0000-0000-0000-000000000001"
+
+
+class Clock:
+  def __init__(self):
+    self.now = 10_000_000_000
+
+  def __call__(self):
+    return self.now
+
+
+class BytesTransport:
+  credentials_required = False
+
+  def __init__(self, packets=()):
+    self.packets, self.closed = deque(packets), False
+
+  def receive(self, max_bytes):
+    return self.packets.popleft() if self.packets else None
+
+  def close(self):
+    self.closed = True
+
+
+class CollectorTests(unittest.TestCase):
+  @classmethod
+  def setUpClass(cls):
+    clock, captured = Clock(), []
+    class Sink:
+      def send(self, value):
+        captured.append(value)
+      def close(self):
+        pass
+    pump = producer._Pump(sender=Sink(), identity={"boot_id": BOOT, "pid": 123, "process_instance_id": "c" * 32},
+                          hash_provider=lambda cid: {producer.OBSERVER_PATH: "a" * 64, producer.CONSUMER_PATHS[cid]: "b" * 64})
+    sampled = producer._Observer("controls.torque", pump, clock_ns=clock)
+    producer.observe(sampled, lambda: {"fields": {"LateralTorqueFriction": producer.field(0.0, read_value=0.0,
+                     source="stored", read_mono_ns=clock.now)}, "context": {"active": True}})
+    deadline = time.monotonic() + 2
+    while not captured and time.monotonic() < deadline:
+      time.sleep(0.005)
+    pump.close()
+    if not captured:
+      raise AssertionError("real producer did not encode synthetic fixture")
+    cls.base = producer.validate_event(json.loads(captured[0]))
+
+  def setUp(self):
+    self.clock = Clock()
+
+  def event(self, **changes):
+    result = deepcopy(self.base)
+    result.update(changes)
+    return result
+
+  def collector(self, packets=(), **options):
+    transport = BytesTransport(packets)
+    consumer = receiver.ConsumerCollector(source_mode="synthetic", transport=transport, expected_boot_id=BOOT,
+                                          clock_ns=self.clock, poll_budget_ns=100_000_000, **options)
+    self.addCleanup(consumer.close)
+    return consumer, transport
+
+  def encoded(self, **changes):
+    return json.dumps(self.event(**changes), sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+
+  def entry(self, collector):
+    return next(item for item in collector.snapshot()["consumers"] if item["consumer_id"] == "controls.torque")
+
+  def test_real_producer_bytes_become_canonical_events_without_application_ack(self):
+    consumer, _ = self.collector([self.encoded()])
+    events = consumer.poll()
+    self.assertEqual([self.base], events)
+    status = consumer.snapshot()
+    self.assertEqual("observed", status["state"])
+    self.assertEqual(10, len(status["consumers"]))
+    self.assertFalse(status["consumer_application_ack"])
+    self.assertFalse(status["device_qualified"])
+    entry = self.entry(consumer)
+    self.assertTrue(entry["fresh"])
+    self.assertTrue(entry["read_freshness"]["LateralTorqueFriction"])
+    self.assertEqual(0.0, entry["latest_event"]["fields"]["LateralTorqueFriction"]["effective_value"])
+
+  def test_old_constructor_read_does_not_make_current_object_observation_stale(self):
+    event = self.event()
+    event["fields"]["LateralTorqueFriction"].update(state="latched", read_mono_ns=1, source="inherited")
+    consumer, _ = self.collector([json.dumps(event).encode()])
+    consumer.poll()
+    entry = self.entry(consumer)
+    self.assertTrue(entry["fresh"])
+    self.assertFalse(entry["read_freshness"]["LateralTorqueFriction"])
