+      self.assertEqual(6000, sum(len(trace["rows"]) for trace in pack["pid_trace_blocks"]))
+      self.assertLessEqual(len(_encoded(pack)), 4 * 1024 * 1024)
+      report = candidates.evaluate_candidates(pack, profile)
