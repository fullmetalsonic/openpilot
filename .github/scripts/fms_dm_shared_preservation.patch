-      count = bisect.bisect_right(times, t) - bisect.bisect_right(times, t - 1)
-      assert 16 <= count <= 24
-  recovered = [t for t in times if enabled_at + 10 <= t < enabled_at + 60]
-  assert 16 <= len(recovered) / 50 <= 20.1
