+@pytest.mark.parametrize("gate", ["can_invalid", "lat_inactive", "trailer"])
+def test_mq4_invalid_completion_does_not_publish_a_retirement_signal(chain, monkeypatch, gate):
+  rig = BlinkerChain(chain, monkeypatch, "left")
+  rig.repeat(50)
