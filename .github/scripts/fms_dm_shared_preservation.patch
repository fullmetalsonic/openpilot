+          **{key: manifest[key] for key in ("summary_id", "summary_revision", "session_id", "source_kind", "include_private_raw")},
+          "bytes": actual_bytes, "zip_bytes": size, "zip_sha256": zip_digest, "manifest_sha256": hashlib.sha256(raw).hexdigest(),
