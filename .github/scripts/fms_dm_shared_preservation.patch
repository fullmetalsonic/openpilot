+BASELINE_PATH = Path(__file__).with_name('fixtures') / 'fms_signal_radar_3f86e7d3.json'
+BASELINE_SHA = '6e8b138fbd269d5c16075813c0f794047792dec34129f6bfa494660bd05d42d3'
