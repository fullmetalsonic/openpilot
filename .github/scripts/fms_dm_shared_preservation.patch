+def model_input(run, kind):
+  distance = 3. if kind == 'stop' else 320.
+  run.sm['modelV2'].position.x = [distance*i/32 for i in range(33)]
+  run.sm['modelV2'].velocity.x = [.29]+[10. if kind == 'go' else 0.]*32
+
